chapter AFP

(* The Isabelle/ARM manual, a sub-session of "ARM_CortexM7" (../ROOT): it imports the global theory "ARM"
   and runs its live examples against the real commands.

   Generate the PDF with

     isabelle build -d ARM_CortexM7 ARM_Manual

   which writes "manual/output/document.pdf" ("output" is git-ignored). The LaTeX sources are in
   "document/": "root.tex" (the same style as the C11, occam 2, Go and Java manuals, uses the
   lualatex/fontspec setup of Isabelle's own document build) and "root.bib" (copied from the Java
   manual, plus the assembler and ARM manuals). *)
session "ARM_Manual" (AFP) = "ARM_CortexM7" +
  options [timeout = 1200, document = pdf, document_output = "output"]
  theories
    ARM_Manual
  document_files
    "root.tex"
    "root.bib"
