chapter AFP

(* Independent of the parent "../ROOT" ("Isabelle_Lex-Yacc") and of "../C11/ROOT"
   ("C11") for the same reason the latter is: "directories .." reaches
   "LexYacc.thy"/"YaccLib.thy" for "Occam2_Parser.thy"'s own relative import,
   which makes the sessions unable to share one build graph. Build with
   "isabelle build -d occam2 Occam2" - never together with the other two in
   the same invocation, and no "ROOTS" file here for the same reason. *)
session "Occam2" (AFP) = HOL +
  options [timeout = 1200]
  directories
    ".."
  theories [document = false]
    Occam2_Tests
    Occam2_Cmd_Tests
