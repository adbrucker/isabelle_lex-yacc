yacc_rules\<open>
start_rule:
        ENTRY_FILE source_file
                (SOME (Source source_file))
|       ENTRY_EXPR expr opt_semi
                (SOME (Expr expr))
|       ENTRY_TYPE typ opt_semi
                (SOME (Expr typ))
|       ENTRY_ID IDENT opt_semi
                (SOME (Id (mkid st (IDENT, IDENTleft, IDENTright))))
|       ENTRY_STMTS stmts
                (SOME (Stmts stmts))
|       ENTRY_STMTS stmts stmt
                (SOME (Stmts (stmts @ [stmt])))
|       ENTRY_DECLS top_decls
                (SOME (Decls top_decls))
opt_semi:
        
                (())
|       SEMI
                (())
source_file:
        PACKAGE IDENT SEMI top_decls
                (File (mkid st (IDENT, IDENTleft, IDENTright), top_decls, ndi2 st (PACKAGEleft,
                        SEMIright)))
top_decls:
        
                ([])
|       top_decls top_decl SEMI
                (top_decls @ [top_decl])
|       top_decls SEMI
                (top_decls)
top_decl:
        decl
                (decl)
|       import_decl
                (import_decl)
|       func_decl
                (func_decl)
decl:
        const_decl
                (const_decl)
|       var_decl
                (var_decl)
|       type_decl
                (type_decl)
const_decl:
        CONST const_spec
                (DConst ([const_spec], false, ndi2 st (CONSTleft, const_specright)))
|       CONST LPAREN const_specs RPAREN
                (DConst (const_specs, true, ndi2 st (CONSTleft, RPARENright)))
const_specs:
        
                ([])
|       const_spec_list
                (const_spec_list)
|       const_spec_list SEMI
                (const_spec_list)
const_spec_list:
        const_spec
                ([const_spec])
|       const_spec_list SEMI const_spec
                (const_spec_list @ [const_spec])
var_decl:
        VAR var_spec
                (DVar ([var_spec], false, ndi2 st (VARleft, var_specright)))
|       VAR LPAREN var_specs RPAREN
                (DVar (var_specs, true, ndi2 st (VARleft, RPARENright)))
var_specs:
        
                ([])
|       var_spec_list
                (var_spec_list)
|       var_spec_list SEMI
                (var_spec_list)
var_spec_list:
        var_spec
                ([var_spec])
|       var_spec_list SEMI var_spec
                (var_spec_list @ [var_spec])
type_decl:
        TYPE type_spec
                (DType ([type_spec], false, ndi2 st (TYPEleft, type_specright)))
|       TYPE LPAREN type_specs RPAREN
                (DType (type_specs, true, ndi2 st (TYPEleft, RPARENright)))
type_specs:
        
                ([])
|       type_spec_list
                (type_spec_list)
|       type_spec_list SEMI
                (type_spec_list)
type_spec_list:
        type_spec
                ([type_spec])
|       type_spec_list SEMI type_spec
                (type_spec_list @ [type_spec])
import_decl:
        IMPORT import_spec
                (DImport ([import_spec], false, ndi2 st (IMPORTleft, import_specright)))
|       IMPORT LPAREN import_specs RPAREN
                (DImport (import_specs, true, ndi2 st (IMPORTleft, RPARENright)))
import_specs:
        
                ([])
|       import_spec_list
                (import_spec_list)
|       import_spec_list SEMI
                (import_spec_list)
import_spec_list:
        import_spec
                ([import_spec])
|       import_spec_list SEMI import_spec
                (import_spec_list @ [import_spec])
const_spec:
        ident_list
                (ConstSpec (ident_list, NONE, [], ndi2 st (ident_listleft, ident_listright)))
|       ident_list typ
                (ConstSpec (ident_list, SOME typ, [], ndi2 st (ident_listleft, typright)))
|       ident_list ASSIGN expr_list
                (ConstSpec (ident_list, NONE, expr_list, ndi2 st (ident_listleft,
                        expr_listright)))
|       ident_list typ ASSIGN expr_list
                (ConstSpec (ident_list, SOME typ, expr_list, ndi2 st (ident_listleft,
                        expr_listright)))
var_spec:
        ident_list typ
                (VarSpec (ident_list, SOME typ, [], ndi2 st (ident_listleft, typright)))
|       ident_list typ ASSIGN expr_list
                (VarSpec (ident_list, SOME typ, expr_list, ndi2 st (ident_listleft,
                        expr_listright)))
|       ident_list ASSIGN expr_list
                (VarSpec (ident_list, NONE, expr_list, ndi2 st (ident_listleft,
                        expr_listright)))
type_spec:
        IDENT LBRACK expr COMMA tparam_list RBRACK typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright),
                        tparam_of_expr st expr :: tparam_list, false, typ, ndi2 st (IDENTleft,
                        typright)))
|       IDENT LBRACK expr COMMA tparam_list RBRACK ASSIGN typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright),
                        tparam_of_expr st expr :: tparam_list, true, typ, ndi2 st (IDENTleft,
                        typright)))
|       IDENT LBRACK expr COMMA RBRACK typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright), [tparam_of_expr st expr],
                        false, typ, ndi2 st (IDENTleft, typright)))
|       IDENT LBRACK expr COMMA tparam_list COMMA RBRACK typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright),
                        tparam_of_expr st expr :: tparam_list, false, typ, ndi2 st (IDENTleft,
                        typright)))
|       IDENT typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright), [], false, typ,
                        ndi2 st (IDENTleft, typright)))
|       IDENT ASSIGN typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright), [], true, typ,
                        ndi2 st (IDENTleft, typright)))
|       IDENT tparams typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright), tparams, false, typ,
                        ndi2 st (IDENTleft, typright)))
|       IDENT tparams ASSIGN typ
                (TypeSpec (mkid st (IDENT, IDENTleft, IDENTright), tparams, true, typ,
                        ndi2 st (IDENTleft, typright)))
import_spec:
        STRING_LIT
                (ImportSpec (NONE, STRING_LIT, ndi2 st (STRING_LITleft, STRING_LITright)))
|       IDENT STRING_LIT
                (ImportSpec (SOME (mkid st (IDENT, IDENTleft, IDENTright)), STRING_LIT,
                        ndi2 st (IDENTleft, STRING_LITright)))
|       PERIOD STRING_LIT
                (ImportSpec (SOME (mkid st (".", PERIODleft, PERIODright)), STRING_LIT,
                        ndi2 st (PERIODleft, STRING_LITright)))
func_decl:
        FUNC IDENT fsig
                (DFunc (mkid st (IDENT, IDENTleft, IDENTright), [], fsig, NONE,
                        ndi2 st (FUNCleft, fsigright)))
|       FUNC IDENT fsig block
                (DFunc (mkid st (IDENT, IDENTleft, IDENTright), [], fsig, SOME block,
                        ndi2 st (FUNCleft, blockright)))
|       FUNC IDENT tparams fsig
                (DFunc (mkid st (IDENT, IDENTleft, IDENTright), tparams, fsig, NONE,
                        ndi2 st (FUNCleft, fsigright)))
|       FUNC IDENT tparams fsig block
                (DFunc (mkid st (IDENT, IDENTleft, IDENTright), tparams, fsig, SOME block,
                        ndi2 st (FUNCleft, blockright)))
|       FUNC params IDENT fsig
                (DMethod (params, mkid st (IDENT, IDENTleft, IDENTright), [], fsig, NONE,
                        ndi2 st (FUNCleft, fsigright)))
|       FUNC params IDENT fsig block
                (DMethod (params, mkid st (IDENT, IDENTleft, IDENTright), [], fsig, SOME block,
                        ndi2 st (FUNCleft, blockright)))
|       FUNC params IDENT tparams fsig
                (DMethod (params, mkid st (IDENT, IDENTleft, IDENTright), tparams, fsig, NONE,
                        ndi2 st (FUNCleft, fsigright)))
|       FUNC params IDENT tparams fsig block
                (DMethod (params, mkid st (IDENT, IDENTleft, IDENTright), tparams, fsig,
                        SOME block, ndi2 st (FUNCleft, blockright)))
ident_list:
        IDENT
                ([mkid st (IDENT, IDENTleft, IDENTright)])
|       ident_list COMMA IDENT
                (ident_list @ [mkid st (IDENT, IDENTleft, IDENTright)])
tparams:
        LBRACK tparam_list RBRACK
                (tparam_list)
|       LBRACK tparam_list COMMA RBRACK
                (tparam_list)
tparam_list:
        tparam_decl
                ([tparam_decl])
|       tparam_list COMMA tparam_decl
                (tparam_list @ [tparam_decl])
tparam_decl:
        IDENT tconstraint
                (TParam ([mkid st (IDENT, IDENTleft, IDENTright)], tconstraint,
                        ndi2 st (IDENTleft, tconstraintright)))
|       IDENT COMMA ident_list tconstraint
                (TParam (mkid st (IDENT, IDENTleft, IDENTright) :: ident_list, tconstraint,
                        ndi2 st (IDENTleft, tconstraintright)))
tconstraint:
        tterm
                (tterm)
|       tconstraint BAR tterm
                ((case tconstraint of EUnion (ts, _) => EUnion (ts @ [tterm],
                        ndi2 st (tconstraintleft, ttermright)) | t => EUnion ([t, tterm],
                        ndi2 st (tconstraintleft, ttermright))))
tterm:
        typ
                (typ)
|       TILDE typ
                (ETilde (typ, ndi2 st (TILDEleft, typright)))
fsig:
        params %prec TYLOW
                (Sig (params, [], ndi2 st (paramsleft, paramsright)))
|       params params
                (Sig (params1, params2, ndi2 st (params1left, params2right)))
|       params typ_np
                (Sig (params, [Param ([], typ_np, false, ndi2 st (typ_npleft, typ_npright))],
                        ndi2 st (paramsleft, typ_npright)))
params:
        LPAREN RPAREN
                ([])
|       LPAREN pentries RPAREN
                (mk_params st pentries)
|       LPAREN pentries COMMA RPAREN
                (mk_params st pentries)
pentries:
        pentry
                ([pentry])
|       pentries COMMA pentry
                (pentries @ [pentry])
pentry:
        IDENT
                (PName (mkid st (IDENT, IDENTleft, IDENTright), IDENTleft, IDENTright))
|       IDENT typ
                (PNamed (mkid st (IDENT, IDENTleft, IDENTright), typ, false, IDENTleft,
                        typright))
|       IDENT ELLIPSIS typ
                (PNamed (mkid st (IDENT, IDENTleft, IDENTright), typ, true, IDENTleft,
                        typright))
|       IDENT PERIOD IDENT
                (PType (ESelector (EIdent (mkid st (IDENT1, IDENT1left, IDENT1right)),
                        mkid st (IDENT2, IDENT2left, IDENT2right), ndi2 st (IDENT1left,
                        IDENT2right)), IDENT1left, IDENT2right))
|       IDENT PERIOD IDENT LBRACK targs RBRACK
                (PType (EIndex (ESelector (EIdent (mkid st (IDENT1, IDENT1left, IDENT1right)),
                        mkid st (IDENT2, IDENT2left, IDENT2right), ndi2 st (IDENT1left,
                        IDENT2right)), targs, ndi2 st (IDENT1left, RBRACKright)), IDENT1left,
                        RBRACKright))
|       IDENT LBRACK expr RBRACK
                (PType (EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)), [expr],
                        ndi2 st (IDENTleft, RBRACKright)), IDENTleft, RBRACKright))
|       IDENT LBRACK expr COMMA targs RBRACK
                (PType (EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)), expr :: targs,
                        ndi2 st (IDENTleft, RBRACKright)), IDENTleft, RBRACKright))
|       typ_nid
                (PType (typ_nid, typ_nidleft, typ_nidright))
|       ELLIPSIS typ
                (PVariadic (typ, ELLIPSISleft, typright))
typ:
        typ_np
                (typ_np)
|       LPAREN typ RPAREN
                (EParen (typ, ndi2 st (LPARENleft, RPARENright)))
typ_nid:
        typ_x
                (typ_x)
|       LPAREN typ RPAREN
                (EParen (typ, ndi2 st (LPARENleft, RPARENright)))
typ_np:
        tname %prec TYLOW
                (tname)
|       tname LBRACK targs RBRACK
                (EIndex (tname, targs, ndi2 st (tnameleft, RBRACKright)))
|       typ_x
                (typ_x)
typ_nr:
        tname %prec TYLOW
                (tname)
|       tname LBRACK targs RBRACK
                (EIndex (tname, targs, ndi2 st (tnameleft, RBRACKright)))
|       typ_xa
                (typ_xa)
|       LPAREN typ RPAREN
                (EParen (typ, ndi2 st (LPARENleft, RPARENright)))
tname:
        IDENT %prec TYLOW
                (EIdent (mkid st (IDENT, IDENTleft, IDENTright)))
|       IDENT PERIOD IDENT
                (ESelector (EIdent (mkid st (IDENT1, IDENT1left, IDENT1right)), mkid st (IDENT2,
                        IDENT2left, IDENT2right), ndi2 st (IDENT1left, IDENT2right)))
typ_xa:
        STAR typ
                (EStar (typ, ndi2 st (STARleft, typright)))
|       LBRACK RBRACK typ
                (EArrayType (NONE, typ, ndi2 st (LBRACKleft, typright)))
|       LBRACK expr RBRACK typ
                (EArrayType (SOME expr, typ, ndi2 st (LBRACKleft, typright)))
|       LBRACK ELLIPSIS RBRACK typ
                (EEllipsisArray (typ, ndi2 st (LBRACKleft, typright)))
|       MAP LBRACK typ RBRACK typ
                (EMapType (typ1, typ2, ndi2 st (MAPleft, typ2right)))
|       CHAN typ_nr
                (EChanType (Both, typ_nr, ndi2 st (CHANleft, typ_nrright)))
|       CHAN ARROWL typ
                (EChanType (SendOnly, typ, ndi2 st (CHANleft, typright)))
|       FUNC fsig
                (EFuncType (fsig, ndi2 st (FUNCleft, fsigright)))
|       STRUCT LBRACE fields RBRACE
                (EStructType (fields, ndi2 st (STRUCTleft, RBRACEright)))
|       INTERFACE LBRACE ielems RBRACE
                (EInterfaceType (ielems, ndi2 st (INTERFACEleft, RBRACEright)))
typ_x:
        typ_xa
                (typ_xa)
|       ARROWL CHAN typ
                (EChanType (RecvOnly, typ, ndi2 st (ARROWLleft, typright)))
targs:
        typ
                ([typ])
|       targs COMMA typ
                (targs @ [typ])
|       targs COMMA
                (targs)
fields:
        
                ([])
|       field_list
                (field_list)
|       field_list SEMI
                (field_list)
field_list:
        field
                ([field])
|       field_list SEMI field
                (field_list @ [field])
field:
        IDENT typ
                (Field ([mkid st (IDENT, IDENTleft, IDENTright)], typ, NONE, ndi2 st (IDENTleft,
                        typright)))
|       IDENT typ STRING_LIT
                (Field ([mkid st (IDENT, IDENTleft, IDENTright)], typ, SOME STRING_LIT,
                        ndi2 st (IDENTleft, STRING_LITright)))
|       IDENT COMMA ident_list typ
                (Field (mkid st (IDENT, IDENTleft, IDENTright) :: ident_list, typ, NONE,
                        ndi2 st (IDENTleft, typright)))
|       IDENT COMMA ident_list typ STRING_LIT
                (Field (mkid st (IDENT, IDENTleft, IDENTright) :: ident_list, typ,
                        SOME STRING_LIT, ndi2 st (IDENTleft, STRING_LITright)))
|       IDENT
                (Field ([], EIdent (mkid st (IDENT, IDENTleft, IDENTright)), NONE,
                        ndi2 st (IDENTleft, IDENTright)))
|       IDENT STRING_LIT
                (Field ([], EIdent (mkid st (IDENT, IDENTleft, IDENTright)), SOME STRING_LIT,
                        ndi2 st (IDENTleft, STRING_LITright)))
|       IDENT PERIOD IDENT
                (Field ([], ESelector (EIdent (mkid st (IDENT1, IDENT1left, IDENT1right)),
                        mkid st (IDENT2, IDENT2left, IDENT2right), ndi2 st (IDENT1left,
                        IDENT2right)), NONE, ndi2 st (IDENTleft, IDENT2right)))
|       IDENT PERIOD IDENT STRING_LIT
                (Field ([], ESelector (EIdent (mkid st (IDENT1, IDENT1left, IDENT1right)),
                        mkid st (IDENT2, IDENT2left, IDENT2right), ndi2 st (IDENT1left,
                        IDENT2right)), SOME STRING_LIT, ndi2 st (IDENTleft, STRING_LITright)))
|       IDENT PERIOD IDENT LBRACK targs RBRACK
                (Field ([], EIndex (ESelector (EIdent (mkid st (IDENT1, IDENT1left,
                        IDENT1right)), mkid st (IDENT2, IDENT2left, IDENT2right),
                        ndi2 st (IDENT1left, IDENT2right)), targs, ndi2 st (IDENT1left,
                        RBRACKright)), NONE, ndi2 st (IDENTleft, RBRACKright)))
|       IDENT PERIOD IDENT LBRACK targs RBRACK STRING_LIT
                (Field ([], EIndex (ESelector (EIdent (mkid st (IDENT1, IDENT1left,
                        IDENT1right)), mkid st (IDENT2, IDENT2left, IDENT2right),
                        ndi2 st (IDENT1left, IDENT2right)), targs, ndi2 st (IDENT1left,
                        RBRACKright)), SOME STRING_LIT, ndi2 st (IDENTleft, STRING_LITright)))
|       IDENT LBRACK expr RBRACK
                (Field ([], EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)), [expr],
                        ndi2 st (IDENTleft, RBRACKright)), NONE, ndi2 st (IDENTleft,
                        RBRACKright)))
|       IDENT LBRACK expr RBRACK STRING_LIT
                (Field ([], EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)), [expr],
                        ndi2 st (IDENTleft, RBRACKright)), SOME STRING_LIT, ndi2 st (IDENTleft,
                        STRING_LITright)))
|       IDENT LBRACK expr COMMA targs RBRACK
                (Field ([], EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)),
                        expr :: targs, ndi2 st (IDENTleft, RBRACKright)), NONE,
                        ndi2 st (IDENTleft, RBRACKright)))
|       IDENT LBRACK expr COMMA targs RBRACK STRING_LIT
                (Field ([], EIndex (EIdent (mkid st (IDENT, IDENTleft, IDENTright)),
                        expr :: targs, ndi2 st (IDENTleft, RBRACKright)), SOME STRING_LIT,
                        ndi2 st (IDENTleft, STRING_LITright)))
|       STAR tname
                (Field ([], EStar (tname, ndi2 st (STARleft, tnameright)), NONE,
                        ndi2 st (STARleft, tnameright)))
|       STAR tname STRING_LIT
                (Field ([], EStar (tname, ndi2 st (STARleft, tnameright)), SOME STRING_LIT,
                        ndi2 st (STARleft, STRING_LITright)))
|       STAR tname LBRACK targs RBRACK
                (Field ([], EStar (EIndex (tname, targs, ndi2 st (tnameleft, RBRACKright)),
                        ndi2 st (STARleft, RBRACKright)), NONE, ndi2 st (STARleft,
                        RBRACKright)))
|       STAR tname LBRACK targs RBRACK STRING_LIT
                (Field ([], EStar (EIndex (tname, targs, ndi2 st (tnameleft, RBRACKright)),
                        ndi2 st (STARleft, RBRACKright)), SOME STRING_LIT, ndi2 st (STARleft,
                        STRING_LITright)))
ielems:
        
                ([])
|       ielem_list
                (ielem_list)
|       ielem_list SEMI
                (ielem_list)
ielem_list:
        ielem
                ([ielem])
|       ielem_list SEMI ielem
                (ielem_list @ [ielem])
ielem:
        IDENT fsig
                (IMethod (mkid st (IDENT, IDENTleft, IDENTright), fsig, ndi2 st (IDENTleft,
                        fsigright)))
|       tconstraint
                (IType (tconstraint, ndi2 st (tconstraintleft, tconstraintright)))
expr:
        unary_expr
                (unary_expr)
|       expr LOR expr
                (EBinary (LOr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LAND expr
                (EBinary (LAnd, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr EQL expr
                (EBinary (Eq, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr NEQ expr
                (EBinary (Ne, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LSS expr
                (EBinary (Lt, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LEQ expr
                (EBinary (Le, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GTR expr
                (EBinary (Gt, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GEQ expr
                (EBinary (Ge, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PLUS expr
                (EBinary (Add, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr MINUS expr
                (EBinary (Sub, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr BAR expr
                (EBinary (Or, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr CARET expr
                (EBinary (Xor, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr STAR expr
                (EBinary (Mul, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SLASH expr
                (EBinary (Div, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PERCENT expr
                (EBinary (Rem, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHL expr
                (EBinary (Shl, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHR expr
                (EBinary (Shr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr AMP expr
                (EBinary (And, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr ANDNOT expr
                (EBinary (AndNot, expr1, expr2, ndi2 st (expr1left, expr2right)))
unary_expr:
        primary
                (primary)
|       PLUS unary_expr
                (EUnary (UPlus, unary_expr, ndi2 st (PLUSleft, unary_exprright)))
|       MINUS unary_expr
                (EUnary (UMinus, unary_expr, ndi2 st (MINUSleft, unary_exprright)))
|       NOT unary_expr
                (EUnary (Not, unary_expr, ndi2 st (NOTleft, unary_exprright)))
|       CARET unary_expr
                (EUnary (UXor, unary_expr, ndi2 st (CARETleft, unary_exprright)))
|       AMP unary_expr
                (EUnary (UAnd, unary_expr, ndi2 st (AMPleft, unary_exprright)))
|       STAR unary_expr
                (EStar (unary_expr, ndi2 st (STARleft, unary_exprright)))
|       ARROWL unary_expr
                (mk_recv st (unary_expr, ARROWLleft, unary_exprright))
primary:
        operand
                (operand)
|       primary PERIOD IDENT
                (ESelector (primary, mkid st (IDENT, IDENTleft, IDENTright),
                        ndi2 st (primaryleft, IDENTright)))
|       primary PERIOD LPAREN typ RPAREN
                (ETypeAssert (primary, SOME typ, ndi2 st (primaryleft, RPARENright)))
|       primary PERIOD LPAREN TYPE RPAREN
                (ETypeAssert (primary, NONE, ndi2 st (primaryleft, RPARENright)))
|       primary LBRACK expr_list RBRACK
                (EIndex (primary, expr_list, ndi2 st (primaryleft, RBRACKright)))
|       primary LBRACK expr_list COMMA RBRACK
                (EIndex (primary, expr_list, ndi2 st (primaryleft, RBRACKright)))
|       primary LBRACK COLON RBRACK
                (ESlice (primary, NONE, NONE, NONE, ndi2 st (primaryleft, RBRACKright)))
|       primary LBRACK COLON expr RBRACK
                (ESlice (primary, NONE, SOME expr, NONE, ndi2 st (primaryleft, RBRACKright)))
|       primary LBRACK expr COLON RBRACK
                (ESlice (primary, SOME expr, NONE, NONE, ndi2 st (primaryleft, RBRACKright)))
|       primary LBRACK expr COLON expr RBRACK
                (ESlice (primary, SOME expr1, SOME expr2, NONE, ndi2 st (primaryleft,
                        RBRACKright)))
|       primary LBRACK COLON expr COLON expr RBRACK
                (ESlice (primary, NONE, SOME expr1, SOME expr2, ndi2 st (primaryleft,
                        RBRACKright)))
|       primary LBRACK expr COLON expr COLON expr RBRACK
                (ESlice (primary, SOME expr1, SOME expr2, SOME expr3, ndi2 st (primaryleft,
                        RBRACKright)))
|       primary LPAREN RPAREN
                (ECall (primary, [], false, ndi2 st (primaryleft, RPARENright)))
|       primary LPAREN expr_list RPAREN
                (ECall (primary, expr_list, false, ndi2 st (primaryleft, RPARENright)))
|       primary LPAREN expr_list COMMA RPAREN
                (ECall (primary, expr_list, false, ndi2 st (primaryleft, RPARENright)))
|       primary LPAREN expr_list ELLIPSIS RPAREN
                (ECall (primary, expr_list, true, ndi2 st (primaryleft, RPARENright)))
|       primary LPAREN expr_list ELLIPSIS COMMA RPAREN
                (ECall (primary, expr_list, true, ndi2 st (primaryleft, RPARENright)))
|       primary LBRACE elements RBRACE
                (mk_complit st (primary, elements, primaryleft, RBRACEright))
operand:
        INT_LIT
                (EInt (INT_LIT, ndi2 st (INT_LITleft, INT_LITright)))
|       FLOAT_LIT
                (EFloat (FLOAT_LIT, ndi2 st (FLOAT_LITleft, FLOAT_LITright)))
|       IMAG_LIT
                (EImag (IMAG_LIT, ndi2 st (IMAG_LITleft, IMAG_LITright)))
|       RUNE_LIT
                (ERune (RUNE_LIT, ndi2 st (RUNE_LITleft, RUNE_LITright)))
|       STRING_LIT
                (EString (STRING_LIT, ndi2 st (STRING_LITleft, STRING_LITright)))
|       IDENT %prec OPERAND
                (EIdent (mkid st (IDENT, IDENTleft, IDENTright)))
|       LPAREN expr RPAREN
                (EParen (expr, ndi2 st (LPARENleft, RPARENright)))
|       FUNC fsig block
                (EFuncLit (fsig, block, ndi2 st (FUNCleft, blockright)))
|       FUNC fsig %prec TYLOW
                (EFuncType (fsig, ndi2 st (FUNCleft, fsigright)))
|       LBRACK RBRACK typ
                (EArrayType (NONE, typ, ndi2 st (LBRACKleft, typright)))
|       LBRACK expr RBRACK typ
                (EArrayType (SOME expr, typ, ndi2 st (LBRACKleft, typright)))
|       LBRACK ELLIPSIS RBRACK typ
                (EEllipsisArray (typ, ndi2 st (LBRACKleft, typright)))
|       MAP LBRACK typ RBRACK typ
                (EMapType (typ1, typ2, ndi2 st (MAPleft, typ2right)))
|       CHAN typ_nr
                (EChanType (Both, typ_nr, ndi2 st (CHANleft, typ_nrright)))
|       CHAN ARROWL typ
                (EChanType (SendOnly, typ, ndi2 st (CHANleft, typright)))
|       STRUCT LBRACE fields RBRACE
                (EStructType (fields, ndi2 st (STRUCTleft, RBRACEright)))
|       INTERFACE LBRACE ielems RBRACE
                (EInterfaceType (ielems, ndi2 st (INTERFACEleft, RBRACEright)))
expr_list:
        expr
                ([expr])
|       expr_list COMMA expr
                (expr_list @ [expr])
elements:
        
                ([])
|       element_list
                (element_list)
|       element_list COMMA
                (element_list)
element_list:
        element
                ([element])
|       element_list COMMA element
                (element_list @ [element])
element:
        value
                (Element (NONE, value, ndi2 st (valueleft, valueright)))
|       value COLON value
                (Element (SOME value1, value2, ndi2 st (value1left, value2right)))
value:
        expr
                (expr)
|       LBRACE elements RBRACE
                (ECompLit (NONE, elements, ndi2 st (LBRACEleft, RBRACEright)))
block:
        LBRACE stmts RBRACE
                (Block (stmts, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE stmts stmt RBRACE
                (Block (stmts @ [stmt], ndi2 st (LBRACEleft, RBRACEright)))
hblock:
        BLOCKLB stmts RBRACE
                (Block (stmts, ndi2 st (BLOCKLBleft, RBRACEright)))
|       BLOCKLB stmts stmt RBRACE
                (Block (stmts @ [stmt], ndi2 st (BLOCKLBleft, RBRACEright)))
stmts:
        
                ([])
|       stmts stmt SEMI
                (stmts @ [stmt])
|       stmts SEMI
                (stmts)
stmt:
        simple_stmt
                (simple_stmt)
|       IDENT COLON stmt
                (SLabeled (mkid st (IDENT, IDENTleft, IDENTright), stmt, ndi2 st (IDENTleft,
                        stmtright)))
|       IDENT COLON
                (SLabeled (mkid st (IDENT, IDENTleft, IDENTright), SEmpty (ndi2 st (COLONleft,
                        COLONright)), ndi2 st (IDENTleft, COLONright)))
|       GO expr
                (SGo (expr, ndi2 st (GOleft, exprright)))
|       DEFER expr
                (SDefer (expr, ndi2 st (DEFERleft, exprright)))
|       RETURN
                (SReturn ([], ndi2 st (RETURNleft, RETURNright)))
|       RETURN expr_list
                (SReturn (expr_list, ndi2 st (RETURNleft, expr_listright)))
|       BREAK
                (SBreak (NONE, ndi2 st (BREAKleft, BREAKright)))
|       BREAK IDENT
                (SBreak (SOME (mkid st (IDENT, IDENTleft, IDENTright)), ndi2 st (BREAKleft,
                        IDENTright)))
|       CONTINUE
                (SContinue (NONE, ndi2 st (CONTINUEleft, CONTINUEright)))
|       CONTINUE IDENT
                (SContinue (SOME (mkid st (IDENT, IDENTleft, IDENTright)),
                        ndi2 st (CONTINUEleft, IDENTright)))
|       GOTO IDENT
                (SGoto (mkid st (IDENT, IDENTleft, IDENTright), ndi2 st (GOTOleft, IDENTright)))
|       FALLTHROUGH
                (SFallthrough (ndi2 st (FALLTHROUGHleft, FALLTHROUGHright)))
|       block
                (SBlock block)
|       if_stmt
                (if_stmt)
|       switch_stmt
                (switch_stmt)
|       select_stmt
                (select_stmt)
|       for_stmt
                (for_stmt)
|       decl
                (SDecl decl)
simple_stmt:
        expr_list
                (simple_of st (expr_list, expr_listleft, expr_listright))
|       expr ARROWL expr
                (SSend (expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr INC
                (SIncDec (expr, true, ndi2 st (exprleft, INCright)))
|       expr DEC
                (SIncDec (expr, false, ndi2 st (exprleft, DECright)))
|       expr_list ASSIGN expr_list
                (SAssign (expr_list1, NONE, expr_list2, ndi2 st (expr_list1left,
                        expr_list2right)))
|       expr_list OPASSIGN expr_list
                (SAssign (expr_list1, SOME (assign_op OPASSIGN), expr_list2,
                        ndi2 st (expr_list1left, expr_list2right)))
|       expr_list DEFINE expr_list
                (define_of st (expr_list1, expr_list2, expr_list1left, expr_list2right))
if_stmt:
        IF if_header hblock
                (SIf (#1 if_header, #2 if_header, hblock, NONE, ndi2 st (IFleft, hblockright)))
|       IF if_header hblock ELSE if_stmt
                (SIf (#1 if_header, #2 if_header, hblock, SOME if_stmt, ndi2 st (IFleft,
                        if_stmtright)))
|       IF if_header hblock ELSE block
                (SIf (#1 if_header, #2 if_header, hblock, SOME (SBlock block), ndi2 st (IFleft,
                        blockright)))
if_header:
        simple_stmt
                ((NONE, cond_of simple_stmt))
|       simple_stmt SEMI expr
                ((SOME simple_stmt, expr))
|       SEMI expr
                ((NONE, expr))
switch_stmt:
        SWITCH switch_header BLOCKLB case_clauses RBRACE
                (mk_switch st (#1 switch_header, #2 switch_header, case_clauses, SWITCHleft,
                        RBRACEright))
switch_header:
        
                ((NONE, NONE))
|       simple_stmt
                ((NONE, SOME simple_stmt))
|       simple_stmt SEMI
                ((SOME simple_stmt, NONE))
|       simple_stmt SEMI simple_stmt
                ((SOME simple_stmt1, SOME simple_stmt2))
|       SEMI
                ((NONE, NONE))
|       SEMI simple_stmt
                ((NONE, SOME simple_stmt))
case_clauses:
        
                ([])
|       case_clauses case_clause
                (case_clauses @ [case_clause])
case_clause:
        CASE expr_list COLON stmts
                (Case (SOME expr_list, stmts, ndi2 st (CASEleft, COLONright)))
|       CASE expr_list COLON stmts stmt
                (Case (SOME expr_list, stmts @ [stmt], ndi2 st (CASEleft, stmtright)))
|       DEFAULT COLON stmts
                (Case (NONE, stmts, ndi2 st (DEFAULTleft, COLONright)))
|       DEFAULT COLON stmts stmt
                (Case (NONE, stmts @ [stmt], ndi2 st (DEFAULTleft, stmtright)))
select_stmt:
        SELECT LBRACE comm_clauses RBRACE
                (SSelect (comm_clauses, ndi2 st (SELECTleft, RBRACEright)))
comm_clauses:
        
                ([])
|       comm_clauses comm_clause
                (comm_clauses @ [comm_clause])
comm_clause:
        CASE simple_stmt COLON stmts
                (Comm (SOME simple_stmt, stmts, ndi2 st (CASEleft, COLONright)))
|       CASE simple_stmt COLON stmts stmt
                (Comm (SOME simple_stmt, stmts @ [stmt], ndi2 st (CASEleft, stmtright)))
|       DEFAULT COLON stmts
                (Comm (NONE, stmts, ndi2 st (DEFAULTleft, COLONright)))
|       DEFAULT COLON stmts stmt
                (Comm (NONE, stmts @ [stmt], ndi2 st (DEFAULTleft, stmtright)))
for_stmt:
        FOR for_header hblock
                (mk_for st (for_header, hblock, FORleft, hblockright))
for_header:
        
                (FInf)
|       simple_stmt
                (FCond (cond_of simple_stmt))
|       simple_stmt SEMI opt_cond SEMI opt_post
                (FClause (SOME simple_stmt, opt_cond, opt_post))
|       SEMI opt_cond SEMI opt_post
                (FClause (NONE, opt_cond, opt_post))
|       range_clause
                (range_clause)
opt_cond:
        
                (NONE)
|       expr
                (SOME expr)
opt_post:
        
                (NONE)
|       simple_stmt
                (SOME simple_stmt)
range_clause:
        RANGE expr
                (FRange (NONE, NONE, false, expr))
|       expr_list ASSIGN RANGE expr
                ((case range_vars expr_list of (k, v) => FRange (k, v, false, expr)))
|       expr_list DEFINE RANGE expr
                ((case range_vars expr_list of (k, v) => FRange (k, v, true, expr)))
\<close>
ML\<open>
structure Go_Parse = struct

structure P = Go.GoParser
structure T = Go.GoLrVals.Tokens

datatype entry = Entry_File | Entry_Expr | Entry_Type | Entry_Id | Entry_Stmts | Entry_Decls

fun entry_token Entry_File p = T.ENTRY_FILE (p, p)
  | entry_token Entry_Expr p = T.ENTRY_EXPR (p, p)
  | entry_token Entry_Type p = T.ENTRY_TYPE (p, p)
  | entry_token Entry_Id p = T.ENTRY_ID (p, p)
  | entry_token Entry_Stmts p = T.ENTRY_STMTS (p, p)
  | entry_token Entry_Decls p = T.ENTRY_DECLS (p, p)

(* The tokens after which a newline is a ";" (the specification, "Semicolons"). *)
val can_end_kinds =
  ["IDENT", "INT_LIT", "FLOAT_LIT", "IMAG_LIT", "RUNE_LIT", "STRING_LIT", "BREAK", "CONTINUE",
   "FALLTHROUGH", "RETURN", "INC", "DEC", "RPAREN", "RBRACK", "RBRACE"]

(* The tokens that end an operand: a "[" after one of them is an index, after any other token the
   beginning of an array or slice type. *)
val operand_end_kinds =
  ["IDENT", "INT_LIT", "FLOAT_LIT", "IMAG_LIT", "RUNE_LIT", "STRING_LIT", "RPAREN", "RBRACK",
   "RBRACE"]

(* The tokens that can be part of a type literal, between its first token and the "{" of a
   composite literal or a function body. *)
val type_part_kinds = ["IDENT", "PERIOD", "STAR", "ARROWL"]

(* The layout stream between the lexer and the parser does two things.

   (1) It inserts the ";" that Go's lexer inserts at the end of a line (and at the end of the
   input) if the last token of the line can end a statement.

   (2) It tells the two kinds of "{" apart. In "if x == T{} {" the parser cannot know without
   help which brace is a composite literal and which one opens the block. Go's own parser keeps a
   "expression level" for this: in the header of an "if", "for" or "switch" a brace after a bare
   type name is the block (the literal needs parentheses there), a brace after a type literal
   ("[]int{", "map[K]V{", "struct{...}{", "func(...) T {") is not. The stream does the same: it
   keeps a stack of regions - a header ("Hdr"), anything else open ("Open"), the body of a struct
   or interface type ("Tybody") - and a flag that says that a type literal is being read in the
   header; the "{" that closes the header is delivered as BLOCKLB, every other one as LBRACE. *)
datatype region = Hdr | Open | Tybody

fun go_stream entry st raw_lex pos eof_pos =
  let
    val eof_tok = T.EOF (eof_pos, eof_pos)
    fun semi_tok p = T.SEMI (p, p)

    val queue = Unsynchronized.ref [entry_token entry (pos 0)]
    val regions : region list Unsynchronized.ref = Unsynchronized.ref []
    (* 0: no type literal pending, 1: a type literal, 2: a function type or literal *)
    val lit_flag = Unsynchronized.ref 0
    val prev_kind = Unsynchronized.ref ""
    val prev_stop = Unsynchronized.ref 0
    val eof_seen = Unsynchronized.ref false

    fun read_raw () =
      let
        val tok = raw_lex ()
        val lay = Go_Layout.get st
        val _ = Go_Layout.clear_newlines st
        val is_eof = P.sameToken (tok, eof_tok)
      in (tok, if is_eof
          then {nl = #nl lay, start = #stop lay, stop = #stop lay, kind = "EOF"} else lay) end

    fun can_end kind = member (op =) can_end_kinds kind

    fun top () = (case !regions of [] => Open | r :: _ => r)
    fun push r = regions := r :: !regions
    fun pop () = (case !regions of [] => () | _ :: rest => regions := rest)
    (* pops to and including the innermost Open or Tybody, returns which one it was *)
    fun close () =
      (case !regions of
         [] => Open
       | Hdr :: rest => (regions := rest; close ())
       | r :: rest => (regions := rest; r))

    fun relabel cons (lay : Go_State.layout) = cons (pos (#start lay), pos (#stop lay))

    (* classifies the token, updating the regions; returns the token the parser is to see *)
    fun classify (tok0, lay : Go_State.layout) =
      let
        val kind = #kind lay
        val prev = !prev_kind
      in
        (case kind of
           "LBRACE" =>
             let
               val body = if prev = "STRUCT" orelse prev = "INTERFACE" then Tybody else Open
             in
               (case top () of
                  Hdr =>
                    if !lit_flag > 0
                    then (lit_flag := 0; push body; tok0)
                    else (pop (); push Open; relabel T.BLOCKLB lay)
                | _ => (push body; tok0))
             end
         | "RBRACE" =>
             (case close () of
                Tybody => (if top () = Hdr then lit_flag := 1 else (); tok0)
              | _ => tok0)
         | "LPAREN" => (push Open; tok0)
         | "LBRACK" =>
             ((if top () = Hdr andalso not (member (op =) operand_end_kinds prev)
               then lit_flag := Int.max (!lit_flag, 1) else ());
              push Open; tok0)
         | "RPAREN" =>
             (ignore (close ());
              (* a call or conversion ends a type literal, not the parameters of a func type *)
              (if top () = Hdr andalso !lit_flag = 1 then lit_flag := 0 else ());
              tok0)
         | "RBRACK" => (ignore (close ()); tok0)
         | "IF" => (push Hdr; lit_flag := 0; tok0)
         | "FOR" => (push Hdr; lit_flag := 0; tok0)
         | "SWITCH" => (push Hdr; lit_flag := 0; tok0)
         | "MAP" => ((if top () = Hdr then lit_flag := Int.max (!lit_flag, 1) else ()); tok0)
         | "CHAN" => ((if top () = Hdr then lit_flag := Int.max (!lit_flag, 1) else ()); tok0)
         | "FUNC" => ((if top () = Hdr then lit_flag := 2 else ()); tok0)
         | "STRUCT" => ((if top () = Hdr then lit_flag := Int.max (!lit_flag, 1) else ()); tok0)
         | "INTERFACE" => ((if top () = Hdr then lit_flag := Int.max (!lit_flag, 1) else ()); tok0)
         | k =>
             ((if top () = Hdr andalso not (member (op =) type_part_kinds k)
               then lit_flag := 0 else ());
              tok0))
      end

    fun next () =
      (case !queue of
         t :: ts => (queue := ts; t)
       | [] =>
           if !eof_seen then eof_tok
           else
             let val (tok0, lay0) = read_raw ()
             in
               if #kind lay0 = "EOF"
               then
                 (eof_seen := true;
                  if can_end (!prev_kind)
                  then (prev_kind := "SEMI"; semi_tok (pos (!prev_stop)))
                  else eof_tok)
               else
                 let
                   val kind = #kind lay0
                   val need_semi = #nl lay0 >= 1 andalso can_end (!prev_kind)
                   val before = if need_semi then [semi_tok (pos (!prev_stop))] else []
                   val tok = classify (tok0, lay0)
                 in
                   prev_kind := kind;
                   prev_stop := #stop lay0;
                   queue := before @ [tok];
                   next ()
                 end
             end)
  in P.Stream.streamify next end

(* Runs the parser on "source" from the given entry point; "mk_err" makes the parser's error
   callback from the parse's state. Every parse creates its own state. *)
fun parse mk_err entry ctxt source =
  let
    val st = Go_State.init ctxt source
    val err = mk_err st
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then "" else (consumed := true; input_text)
    val raw_lex = Go.GoLex.makeLexer input_string st
    val pos = Lex_yacc_state.get_pos (#base st)
    val eof_pos = pos (String.size input_text)
    val stream = go_stream entry st raw_lex pos eof_pos
    val (result, _) = P.parse (0, stream, err, st)
      handle Fail msg => (err (msg, pos 0, pos 0); raise Fail msg)
    val _ = (case !(#lex_error st) of SOME (msg, p) => err (msg, p, p) | NONE => ())
  in result end

fun parse_loud entry ctxt source =
  parse (fn st => Lex_yacc_state.print_error (#base st)) entry ctxt source

(* The silent variant the "_reject" commands use: a locally declared exception, not the
   library's "print_error" (which reports PIDE error markup before raising, and raises an
   exception Isabelle/ML cannot reliably catch by identity across the SML sandbox boundary). *)
exception Rejected of string
fun quiet_error (s : string, _ : Position.T, _ : Position.T) = raise Rejected s

fun parse_quiet entry ctxt source = parse (K quiet_error) entry ctxt source

end
\<close>

