<LCOMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) false;
            YYBEGIN ANTIQ;
            continue ());
<LCOMMENT>\n
        => (antiq_flush_pending_tag st;
            layout_newline st;
            YYBEGIN INITIAL;
            continue ());

<COMMENT>[^*/@\\\n]+
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>\n
        => (push_raw_fragment st (yypos, yytext);
            layout_newline st;
            continue ());
<COMMENT>"*/"
        => (antiq_flush_pending_tag st;
            YYBEGIN INITIAL;
            continue ());
<COMMENT>"*"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"/"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}{HWS}*["]([^"\\\n]|{ES})*["]
        => (tag_with_body st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}
        => (tag_only st (yypos, yytext);
            continue ());
<COMMENT>"@"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"\\"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) true;
            YYBEGIN ANTIQ;
            continue ());

<ANTIQ>[^\\\n]+                     => (antiq_body_push st yytext; continue ());
<ANTIQ>\n+
        => (antiq_body_push st yytext;
            List.app (fn _ => layout_newline st) (String.explode yytext);
            continue ());
<ANTIQ>"\\"                         => (antiq_body_push st yytext; continue ());
<ANTIQ>{OPENCART}
        => (antiq_depth st := !(antiq_depth st) + 1;
            antiq_body_push st yytext;
            continue ());
<ANTIQ>{CLOSECART}
        => (antiq_depth st := !(antiq_depth st) - 1;
            if !(antiq_depth st) = 0
              then (antiq_body_finish st yypos;
                    (if !(antiq_from_block st) then YYBEGIN COMMENT
                     else YYBEGIN LCOMMENT);
                    continue ())
              else (antiq_body_push st yytext; continue ()));
\<close>
and yacc_user_declarations\<open>
open Go_Ast

fun ndi st p = Go_Comments.mk_nodeInfo st p p
fun ndi2 st (p1, p2) =
  Go_Comments.mk_nodeInfo st p1 (Position.range_position (p1, p2))

(* A name token carries its true source span as its position, so the node's
   own range is exactly the name. *)
fun mkid st (s, l, r) = Ident (s, 0, ndi2 st (l, r))

fun assign_op s = (case s of
    "+" => Add | "-" => Sub | "*" => Mul | "/" => Div | "%" => Rem | "&" => And
  | "|" => Or | "^" => Xor | "<<" => Shl | ">>" => Shr | "&^" => AndNot
  | _ => raise Fail ("unknown assignment operator " ^ s ^ "="))

(* A parameter or result list is first read as a list of entries, each a name,
   a name and a type, or a type: "(a, b int)" and "(int, string)" cannot be told
   apart before the last entry. If one entry has both a name and a type, all of
   them are names or named. *)
datatype pentry =
    PName of Position.T ident * Position.T * Position.T
  | PNamed of Position.T ident * Position.T gExpr * bool * Position.T * Position.T
  | PType of Position.T gExpr * Position.T * Position.T
  | PVariadic of Position.T gExpr * Position.T * Position.T

fun mk_params st (entries : pentry list) : Position.T gParam list =
  let
    val named = List.exists (fn PNamed _ => true | _ => false) entries
    fun group (pending, acc) [] =
          if null pending then rev acc
          else raise Fail "mixed named and unnamed parameters"
      | group (pending, acc) (PName (id, l, _) :: rest) =
          group (pending @ [(id, l)], acc) rest
      | group (pending, acc) (PNamed (id, t, v, l, r) :: rest) =
          let
            val names = map #1 pending @ [id]
            val l0 = (case pending of (_, l1) :: _ => l1 | [] => l)
          in group ([], Param (names, t, v, ndi2 st (l0, r)) :: acc) rest end
      | group _ (_ :: _) = raise Fail "mixed named and unnamed parameters"
  in
    if named then group ([], []) entries
    else
      map (fn PName (id, l, r) => Param ([], EIdent id, false, ndi2 st (l, r))
            | PType (t, l, r) => Param ([], t, false, ndi2 st (l, r))
            | PVariadic (t, l, r) => Param ([], t, true, ndi2 st (l, r))
            | PNamed _ => raise Fail "impossible") entries
  end

(* The types a composite literal can have: "T{...}" is read as a primary
   expression followed by a brace, and the primary must be such a type. *)
fun complit_type e = (case e of
    EIdent _ => true
  | ESelector (EIdent _, _, _) => true
  | EIndex (e1, _, _) => complit_type e1
  | EArrayType _ => true
  | EEllipsisArray _ => true
  | EMapType _ => true
  | EStructType _ => true
  | _ => false)

fun mk_complit st (e, elems, l, r) =
  if complit_type e then ECompLit (SOME e, elems, ndi2 st (l, r))
  else raise Fail "invalid type of a composite literal"

(* "<-chan T" is read as the receive operator applied to "chan T". *)
fun mk_recv st (e, l, r) =
  (case e of
     EChanType (Both, t, _) => EChanType (RecvOnly, t, ndi2 st (l, r))
   | _ => EUnary (URecv, e, ndi2 st (l, r)))

fun cond_of s = (case s of
    SExpr (e, _) => e
  | _ => raise Fail "expected a condition")

fun simple_of st (es, l, r) = (case es of
    [e] => SExpr (e, ndi2 st (l, r))
  | _ => raise Fail "an expression list is not a statement")

fun define_of st (lhs, rhs, l, r) =
  if List.all (fn EIdent _ => true | _ => false) lhs
  then SShortVar (lhs, rhs, ndi2 st (l, r))
  else raise Fail "non-name on the left side of :="

(* "switch x := v.(type)" and "switch v.(type)" are type switches, any other
   header is an expression switch. *)
fun mk_switch st (init, tag, cases, l, r) =
  let val ni = ndi2 st (l, r)
  in
    (case tag of
       NONE => SSwitch (init, NONE, cases, ni)
     | SOME (SExpr (ETypeAssert (x, NONE, _), _)) =>
         STypeSwitch (init, NONE, x, cases, ni)
     | SOME (SShortVar ([EIdent id], [ETypeAssert (x, NONE, _)], _)) =>
         STypeSwitch (init, SOME id, x, cases, ni)
     | SOME (SExpr (e, _)) => SSwitch (init, SOME e, cases, ni)
     | SOME _ => raise Fail "invalid switch header")
  end

(* "type T[P *C | string, V any] ..." is, up to the first comma, also an array type with the
   length "P * C | string"; as in Go's own parser, a comma after the first expression decides for
   the type parameter list, and the expression is split into the name and its constraint. *)
fun tparam_of_expr st (e : Position.T gExpr) : Position.T gTParam =
  let
    val ni = ndi2 st
    fun split e1 = (case e1 of
        EBinary (Mul, EIdent id, c, n) => (id, EStar (c, n))
      | EBinary (Or, l, r, n) =>
          let val (id, c) = split l
          in (id, (case c of
                     EUnion (ts, n1) => EUnion (ts @ [r], n1)
                   | _ => EUnion ([c, r], n))) end
      | EBinary (Mul, l, c, n) =>
          let val (id, c1) = split l in (id, EBinary (Mul, c1, c, n)) end
      | ECall (EIdent id, [c], false, n) => (id, EParen (c, n))
      | _ => raise Fail "invalid type parameter declaration")
    val (id, c) = split e
  in TParam ([id], c, nodeInfo_of_expr e) end

datatype forhead =
    FInf
  | FCond of Position.T gExpr
  | FClause of Position.T gStmt option * Position.T gExpr option * Position.T gStmt option
  | FRange of Position.T gExpr option * Position.T gExpr option * bool * Position.T gExpr

fun range_vars (es : Position.T gExpr list) = (case es of
    [k] => (SOME k, NONE)
  | [k, v] => (SOME k, SOME v)
  | _ => raise Fail "a range clause has at most two iteration variables")

fun mk_for st (h, body, l, r) =
  let val ni = ndi2 st (l, r)
  in
    (case h of
       FInf => SFor (NONE, NONE, NONE, body, ni)
     | FCond c => SFor (NONE, SOME c, NONE, body, ni)
     | FClause (i, c, p) => SFor (i, c, p, body, ni)
     | FRange (k, v, d, e) => SRange (k, v, d, e, body, ni))
  end
\<close>
