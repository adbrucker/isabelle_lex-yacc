chapter AFP

(* Independent of the parent "../Isabelle_Lex-Yacc" session and of the other front-ends
   ("../C11", "../occam2"): the "directories" entry reaches "LexYacc.thy"/"YaccLib.thy" for
   "Scala3_Parser.thy"'s own relative import, which makes the sessions unable to share one
   build graph. Build with "isabelle build -d scala3 Scala3" - never together with the other
   front-ends in the same invocation. *)
session "Scala3" (AFP) = HOL +
  options [timeout = 1200]
  directories
    "../Isabelle_Lex-Yacc"
  theories
    Scala3 (global)
    Scala3_Tests
    Scala3_Cmd_Tests
