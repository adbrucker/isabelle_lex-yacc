and yacc_user_declarations\<open>
open Java_Ast

type pos = Position.T
(* a dotted name: each identifier with the span of its token *)
type qn = (pos ident * pos * pos) list

fun ndi st p = Java_Comments.mk_nodeInfo st p p
fun ndi2 st (p1, p2) =
  Java_Comments.mk_nodeInfo st p1 (Position.range_position (p1, p2))

(* A name token carries its true source span as its position, so the node's own range is exactly
   the name. *)
fun mkid st (s, l, r) = Ident (s, 0, ndi2 st (l, r))

fun qn_one st (s, l, r) : qn = [(mkid st (s, l, r), l, r)]
fun qn_snoc st (q : qn) (s, l, r) : qn = q @ [(mkid st (s, l, r), l, r)]
fun qn_ids (q : qn) = map #1 q
fun qn_left (q : qn) = #2 (hd q)
fun qn_right (q : qn) = #3 (List.last q)

(* a dotted name as an expression: a chain of selections *)
fun expr_of_qn st (q : qn) : pos jExpr =
  (case q of
     [] => raise Fail "empty name"
   | (id, l, _) :: rest =>
       #1 (List.foldl (fn ((id2, _, r2), (e, l0)) => (EField (e, id2, ndi2 st (l0, r2)), l0))
             (EName id, l) rest))

fun split_last (q : qn) = (List.take (q, length q - 1), List.last q)

(* "a.b.m(...)": the receiver "a.b" and the method "m" *)
fun call_of_qn st (q : qn, args, l, r) : pos jExpr =
  let val (recv, (m, _, _)) = split_last q
  in ECall (if null recv then NONE else SOME (expr_of_qn st recv), NONE, m, args, ndi2 st (l, r))
  end

(* --- types ------------------------------------------------------------------------------- *)

fun seg_of (id, _, _) = TSeg (id, NONE)

fun class_of_qn st (q : qn) : pos jType =
  TClass ([], map seg_of q, ndi2 st (qn_left q, qn_right q))

(* "a.b.C<T>": the arguments belong to the last segment *)
fun class_with_args st (q : qn, args : pos jTArgs, r) : pos jType =
  let val (init, (id, _, _)) = split_last q
  in TClass ([], map seg_of init @ [TSeg (id, SOME args)], ndi2 st (qn_left q, r)) end

fun class_extend st (t : pos jType, tail : (pos ident * pos jTArgs option) list, r) : pos jType =
  (case t of
     TClass (al, segs, ni) =>
       TClass (al, segs @ map TSeg tail, ndi2 st (pos_of_NodeInfo ni, r))
   | _ => raise Fail "class type expected")

(* a type annotation in front of a type is kept with its first segment *)
fun annotate_type (al : pos jAnnot list) (t : pos jType) : pos jType =
  if null al then t
  else (case t of
          TPrim (al0, s, ni) => TPrim (al @ al0, s, ni)
        | TClass (al0, segs, ni) => TClass (al @ al0, segs, ni)
        | TArray (e, ds, ni) => TArray (annotate_type al e, ds, ni)
        | TVar _ => t)

fun array_of st (t : pos jType, ds : pos jDim list, l, r) : pos jType =
  TArray (t, ds, ndi2 st (l, r))

(* --- modifiers, names -------------------------------------------------------------------- *)

fun kw st (s, l, r) = MKw (s, ndi2 st (l, r))

fun annots_only (ms : pos jModifier list) : pos jAnnot list =
  map (fn MAnnot a => a | MKw _ => raise Fail "only annotations may precede a package or module")
    ms

(* --- expressions ------------------------------------------------------------------------- *)

fun lit st (l, (p1, p2)) = ELit (l, ndi2 st (p1, p2))

fun binop st (b, e1, e2, p1, p2) = EBinary (b, e1, e2, ndi2 st (p1, p2))

fun assign_binop s = (case s of
    "+" => Add | "-" => Sub | "*" => Mul | "/" => Div | "%" => Rem | "&" => BAnd | "|" => BOr
  | "^" => BXor | "<<" => Shl | ">>" => Shr | ">>>" => UShr
  | _ => raise Fail ("unknown assignment operator " ^ s ^ "="))

(* the left side of an assignment, "x++" and "x--" must name a variable *)
fun is_variable e = (case e of
    EName _ => true | EField _ => true | EIndex _ => true | EParen (e1, _) => is_variable e1
  | _ => false)

fun mk_assign st (lhs, opr, rhs, p1, p2) =
  if is_variable lhs then EAssign (lhs, opr, rhs, ndi2 st (p1, p2))
  else raise Fail "invalid left-hand side of an assignment"

fun mk_postfix st (u, e, p1, p2) =
  if is_variable e then EUnary (u, e, ndi2 st (p1, p2))
  else raise Fail "invalid operand of ++ or --"

(* a method reference or a class literal on a name: "a.b" is a type or an expression *)
fun mr_of_qn st (q : qn) : pos jMRTarget = MRExpr (expr_of_qn st q)

(* --- switch ------------------------------------------------------------------------------ *)

datatype switem = SwLab of pos jLabel | SwStm of pos jStmt

(* the flat list of labels and statements of an old-style switch block, grouped: each group is
   one or more labels followed by the statements up to the next label *)
fun regroup st (items : switem list) : pos jSwitchCase list =
  let
    fun grp (labels, stmts) = SwGroup (rev labels, rev stmts, ndi st (Position.none))
    fun go (cur_labels, cur_stmts) acc [] =
          rev (if null cur_labels then acc else grp (cur_labels, cur_stmts) :: acc)
      | go (ls, ss) acc (SwLab l :: rest) =
          if null ss then go (l :: ls, ss) acc rest
          else go ([l], []) (grp (ls, ss) :: acc) rest
      | go (ls, ss) acc (SwStm s :: rest) = go (ls, s :: ss) acc rest
  in go ([], []) [] items end

fun label_pos (l : pos jLabel) = (case l of LCase (_, _, ni) => ni | LDefault ni => ni)

(* --- compilation units ------------------------------------------------------------------- *)

datatype titem =
    TIPackage of pos jAnnot list * pos ident list * pos nodeInfo
  | TIImport of pos jImport
  | TIDecl of pos jDecl
  | TIModule of pos jAnnot list * bool * pos ident list * pos jModDir list * pos nodeInfo

fun mk_unit st (items : titem list, l, r) : pos jUnit =
  let
    val (pkgs, rest1) = List.partition (fn TIPackage _ => true | _ => false) items
    val pkg = (case pkgs of
                 [] => NONE
               | [TIPackage (al, name, _)] => SOME (al, name)
               | _ => raise Fail "more than one package declaration")
    val _ = (case items of
               TIPackage _ :: _ => ()
             | _ => if null pkgs then () else raise Fail "the package declaration must come first")
    val imports = List.mapPartial (fn TIImport i => SOME i | _ => NONE) rest1
    val decls = List.mapPartial (fn TIDecl d => SOME d | _ => NONE) rest1
    val modules = List.mapPartial (fn TIModule m => SOME m | _ => NONE) rest1
    (* the imports precede the declarations *)
    val _ =
      let
        fun order seen_decl [] = ()
          | order seen_decl (TIPackage _ :: rest) = order seen_decl rest
          | order seen_decl (TIImport _ :: rest) =
              if seen_decl then raise Fail "an import declaration after a declaration"
              else order seen_decl rest
          | order _ (_ :: rest) = order true rest
      in order false items end
    val body = (case modules of
                  [] => Types decls
                | [(al, is_open, name, dirs, ni)] =>
                    if null decls andalso null pkgs then Module (al, is_open, name, dirs, ni)
                    else raise Fail "a module declaration must be the only declaration"
                | _ => raise Fail "more than one module declaration")
  in Unit (pkg, imports, body, ndi2 st (l, r)) end
\<close>
