<INITIAL>{D}{DU}*({FSUF})
        => (stok_val st "FLOAT_LIT" Markup.numeral
            (yypos, yytext, Tokens.FLOAT_LIT, yytext));
<INITIAL>{HEXFLOAT}
        => (stok_val st "FLOAT_LIT" Markup.numeral
            (yypos, yytext, Tokens.FLOAT_LIT, yytext));

<INITIAL>"'"{CHARBODY}"'"
        => (stok_val st "CHAR_LIT" Markup.string
            (yypos, yytext, Tokens.CHAR_LIT, yytext));
<INITIAL>["]([^"\\\n]|"\\"[^\n])*["]
        => (stok_val st "STRING_LIT" Markup.string
            (yypos, yytext, Tokens.STRING_LIT, yytext));
<INITIAL>\"\"\"{HWS}*\r?\n({TBC})*\"\"\"
        => (stok_val st "TEXT_BLOCK" Markup.string
            (yypos, yytext, Tokens.TEXT_BLOCK, yytext));
<INITIAL>.
        => (stok_val st "ILLEGAL" (Markup.bad ())
            (yypos, yytext, Tokens.ILLEGAL, yytext));

<LCOMMENT>[^@\\\n]+
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>"@"{ATAG}{HWS}*["]([^"\\\n]|{ES})*["]
        => (tag_with_body st (yypos, yytext);
            continue ());
<LCOMMENT>"@"{ATAG}
        => (tag_only st (yypos, yytext);
            continue ());
<LCOMMENT>"@"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>"\\"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) false;
            YYBEGIN ANTIQ;
            continue ());
<LCOMMENT>\n
        => (antiq_flush_pending_tag st;
            layout_newline st;
            YYBEGIN INITIAL;
            continue ());

<COMMENT>[^*/@\\\n]+
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>\n
        => (push_raw_fragment st (yypos, yytext);
            layout_newline st;
            continue ());
<COMMENT>"*/"
        => (antiq_flush_pending_tag st;
            YYBEGIN INITIAL;
            continue ());
<COMMENT>"*"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"/"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}{HWS}*["]([^"\\\n]|{ES})*["]
        => (tag_with_body st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}
        => (tag_only st (yypos, yytext);
            continue ());
<COMMENT>"@"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"\\"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) true;
            YYBEGIN ANTIQ;
            continue ());

<ANTIQ>[^\\\n]+                     => (antiq_body_push st yytext; continue ());
<ANTIQ>\n+
        => (antiq_body_push st yytext;
            List.app (fn _ => layout_newline st) (String.explode yytext);
            continue ());
<ANTIQ>"\\"                         => (antiq_body_push st yytext; continue ());
<ANTIQ>{OPENCART}
        => (antiq_depth st := !(antiq_depth st) + 1;
            antiq_body_push st yytext;
            continue ());
<ANTIQ>{CLOSECART}
        => (antiq_depth st := !(antiq_depth st) - 1;
            if !(antiq_depth st) = 0
              then (antiq_body_finish st yypos;
                    (if !(antiq_from_block st) then YYBEGIN COMMENT
                     else YYBEGIN LCOMMENT);
                    continue ())
              else (antiq_body_push st yytext; continue ()));
