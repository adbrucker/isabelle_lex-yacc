      |        array_type of Position.T jType
      |        dims of Position.T jDim list
      |        dims_opt of Position.T jDim list
      |        dim of Position.T jDim
      |        targs of Position.T jTArgs
      |        targ_list of Position.T jTArg list
      |        targ of Position.T jTArg
      |        wildcard of Position.T jTArg
      |        params of Position.T jParam list
      |        param_list of Position.T jParam list
      |        param of Position.T jParam
      |        var_id of Position.T ident
      |        block of Position.T jBlock
      |        block_stmts of Position.T jStmt list
      |        block_stmt of Position.T jStmt
      |        local_var_decl of Position.T jLocalVar
      |        var_declarators of Position.T jVarDecl list
      |        var_declarator of Position.T jVarDecl
      |        var_init of Position.T jExpr
      |        var_inits of Position.T jExpr list
      |        array_init of Position.T jExpr
      |        stmt of Position.T jStmt
      |        stmt_expr of Position.T jExpr
      |        stmt_expr_list of Position.T jExpr list
      |        expr_opt of Position.T jExpr option
      |        for_init of Position.T jForInit
      |        for_init_opt of Position.T jForInit option
      |        for_update_opt of Position.T jExpr list
      |        catches of Position.T jCatch list
      |        catch_clause of Position.T jCatch
      |        catch_types of Position.T jType list
      |        catch_mods of Position.T jModifier list
      |        finally of Position.T jBlock
      |        resources of (Position.T jResource list * bool)
      |        resource_list of Position.T jResource list
      |        resource of Position.T jResource
      |        switch_block of Position.T jSwitchCase list
      |        sw_rules of Position.T jSwitchCase list
      |        sw_rule of Position.T jSwitchCase
      |        rule_body of Position.T jRuleBody
      |        sw_flat of switem list
      |        switch_label of Position.T jLabel
      |        case_items of Position.T jCaseItem list
      |        case_item of Position.T jCaseItem
      |        guard_opt of Position.T jExpr option
      |        pattern of Position.T jPattern
      |        pattern_list of Position.T jPattern list
      |        comp_pattern of Position.T jPattern
      |        expr of Position.T jExpr
      |        assign_expr of Position.T jExpr
      |        assignment of Position.T jExpr
      |        assign_op of binop option
      |        cond_expr of Position.T jExpr
      |        binary of Position.T jExpr
      |        unary of Position.T jExpr
      |        unary_npm of Position.T jExpr
      |        postfix of Position.T jExpr
      |        pre_inc of Position.T jExpr
      |        pre_dec of Position.T jExpr
      |        post_inc of Position.T jExpr
      |        post_dec of Position.T jExpr
      |        primary of Position.T jExpr
      |        primary_nna of Position.T jExpr
      |        literal of Position.T jExpr
      |        cast of Position.T jExpr
      |        lambda of Position.T jExpr
      |        lambda_body of Position.T jLBody
      |        lparam_list of Position.T jLParam list
      |        lparam of Position.T jLParam
      |        method_invocation of Position.T jExpr
      |        field_access of Position.T jExpr
      |        array_access of Position.T jExpr
      |        class_creation of Position.T jExpr
      |        array_creation of Position.T jExpr
      |        array_creation_init of Position.T jExpr
      |        dim_exprs of Position.T jExpr list
      |        method_ref of Position.T jExpr
      |        mr_name of Position.T jTArgs option * Position.T ident
      |        class_lit of Position.T jExpr
      |        args of Position.T jExpr list
      |        arg_list of Position.T jExpr list
      |        switch_expr of Position.T jExpr
\<close>
yacc_rules\<open>
start_rule:
        ENTRY_UNIT top_items
                (SOME (Source (mk_unit st (top_items, ENTRY_UNITleft, top_itemsright))))
|       ENTRY_EXPR expr
                (SOME (Expr expr))
|       ENTRY_TYPE typ
                (SOME (Type typ))
|       ENTRY_ID IDENT
                (SOME (Id (mkid st (IDENT, IDENTleft, IDENTright))))
|       ENTRY_STMTS block_stmts
                (SOME (Stmts block_stmts))
|       ENTRY_DECLS members
                (SOME (Decls members))

(* ---------------------------------------------------------------------------------------- *)
(* compilation units                                                                          *)

top_items:
        
                ([])
|       top_items top_item
                (top_items @ [top_item])
top_item:
        package_decl
                (package_decl)
|       import_decl
                (TIImport import_decl)
|       membr
                (TIDecl membr)
|       module_decl
                (module_decl)
package_decl:
        modifiers PACKAGE qname SEMI
                (TIPackage (annots_only modifiers, qn_ids qname, ndi2 st (modifiersleft,
                  SEMIright)))
import_decl:
        IMPORT qname SEMI
                (Import (ImSingle, qn_ids qname, ndi2 st (IMPORTleft, SEMIright)))
|       IMPORT qname PERIOD STAR SEMI
                (Import (ImDemand, qn_ids qname, ndi2 st (IMPORTleft, SEMIright)))
|       IMPORT STATIC qname SEMI
                (Import (ImStaticSingle, qn_ids qname, ndi2 st (IMPORTleft, SEMIright)))
|       IMPORT STATIC qname PERIOD STAR SEMI
                (Import (ImStaticDemand, qn_ids qname, ndi2 st (IMPORTleft, SEMIright)))
|       IMPORT MODULE qname SEMI
                (Import (ImModule, qn_ids qname, ndi2 st (IMPORTleft, SEMIright)))
module_decl:
        modifiers MODULE qname LBRACE module_dirs RBRACE
                (TIModule (annots_only modifiers, false, qn_ids qname, module_dirs,
                           ndi2 st (modifiersleft, RBRACEright)))
|       modifiers OPEN MODULE qname LBRACE module_dirs RBRACE
                (TIModule (annots_only modifiers, true, qn_ids qname, module_dirs,
                           ndi2 st (modifiersleft, RBRACEright)))
module_dirs:
        
                ([])
|       module_dirs module_dir
                (module_dirs @ [module_dir])
module_dir:
        REQUIRES req_mods qname SEMI
                (Requires (req_mods, qn_ids qname, ndi2 st (REQUIRESleft, SEMIright)))
|       EXPORTS qname SEMI
                (Exports (qn_ids qname, [], ndi2 st (EXPORTSleft, SEMIright)))
|       EXPORTS qname TO qname_list SEMI
                (Exports (qn_ids qname, qname_list, ndi2 st (EXPORTSleft, SEMIright)))
|       OPENS qname SEMI
                (Opens (qn_ids qname, [], ndi2 st (OPENSleft, SEMIright)))
|       OPENS qname TO qname_list SEMI
                (Opens (qn_ids qname, qname_list, ndi2 st (OPENSleft, SEMIright)))
|       USES qname SEMI
                (Uses (qn_ids qname, ndi2 st (USESleft, SEMIright)))
|       PROVIDES qname WITH qname_list SEMI
                (Provides (qn_ids qname, qname_list, ndi2 st (PROVIDESleft, SEMIright)))
req_mods:
        
                ([])
|       req_mods TRANSITIVE
                (req_mods @ ["transitive"])
|       req_mods STATIC
                (req_mods @ ["static"])
qname_list:
        qname
                ([qn_ids qname])
|       qname_list COMMA qname
                (qname_list @ [qn_ids qname])
qname:
        IDENT
                (qn_one st (IDENT, IDENTleft, IDENTright))
|       qname PERIOD IDENT
                (qn_snoc st qname (IDENT, IDENTleft, IDENTright))

(* ---------------------------------------------------------------------------------------- *)
(* modifiers and annotations                                                                  *)

modifiers:
        
                ([])
|       modifiers modifier
                (modifiers @ [modifier])
modifier:
        annotation
                (MAnnot annotation)
|       PUBLIC
                (kw st ("public", PUBLICleft, PUBLICright))
|       PROTECTED
                (kw st ("protected", PROTECTEDleft, PROTECTEDright))
|       PRIVATE
                (kw st ("private", PRIVATEleft, PRIVATEright))
|       ABSTRACT
                (kw st ("abstract", ABSTRACTleft, ABSTRACTright))
|       STATIC
                (kw st ("static", STATICleft, STATICright))
|       FINAL
                (kw st ("final", FINALleft, FINALright))
|       STRICTFP
                (kw st ("strictfp", STRICTFPleft, STRICTFPright))
|       NATIVE
                (kw st ("native", NATIVEleft, NATIVEright))
|       SYNCHRONIZED
                (kw st ("synchronized", SYNCHRONIZEDleft, SYNCHRONIZEDright))
|       TRANSIENT
                (kw st ("transient", TRANSIENTleft, TRANSIENTright))
|       VOLATILE
                (kw st ("volatile", VOLATILEleft, VOLATILEright))
|       DEFAULT
                (kw st ("default", DEFAULTleft, DEFAULTright))
|       SEALED
                (kw st ("sealed", SEALEDleft, SEALEDright))
|       NONSEALED
                (kw st ("non-sealed", NONSEALEDleft, NONSEALEDright))
local_mods1:
        local_mod
                ([local_mod])
|       local_mods1 local_mod
                (local_mods1 @ [local_mod])
local_mod:
        annotation
                (MAnnot annotation)
|       FINAL
                (kw st ("final", FINALleft, FINALright))
|       ABSTRACT
                (kw st ("abstract", ABSTRACTleft, ABSTRACTright))
|       STRICTFP
                (kw st ("strictfp", STRICTFPleft, STRICTFPright))
|       STATIC
                (kw st ("static", STATICleft, STATICright))
annots1:
        annotation
                ([annotation])
|       annots1 annotation
                (annots1 @ [annotation])
annotation:
        AT qname
                (Annot (qn_ids qname, NoArgs, ndi2 st (ATleft, qnameright)))
|       AT qname LPAREN RPAREN
                (Annot (qn_ids qname, Pairs [], ndi2 st (ATleft, RPARENright)))
|       AT qname LPAREN elem_value RPAREN
                (Annot (qn_ids qname, Single elem_value, ndi2 st (ATleft, RPARENright)))
|       AT qname LPAREN pair_list RPAREN
                (Annot (qn_ids qname, Pairs pair_list, ndi2 st (ATleft, RPARENright)))
pair_list:
        pair
                ([pair])
|       pair_list COMMA pair
                (pair_list @ [pair])
pair:
        IDENT ASSIGN elem_value
                ((mkid st (IDENT, IDENTleft, IDENTright), elem_value))
elem_value:
        cond_expr
                (EVExpr cond_expr)
|       annotation
                (EVAnnot annotation)
|       LBRACE RBRACE
                (EVArray ([], false, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE elem_values RBRACE
                (EVArray (elem_values, false, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE elem_values COMMA RBRACE
                (EVArray (elem_values, true, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE COMMA RBRACE
                (EVArray ([], true, ndi2 st (LBRACEleft, RBRACEright)))
elem_values:
        elem_value
                ([elem_value])
|       elem_values COMMA elem_value
                (elem_values @ [elem_value])

(* ---------------------------------------------------------------------------------------- *)
(* declarations                                                                               *)

members:
        
                ([])
|       members membr
                (members @ [membr])
membr:
        modifiers membr_core
                (membr_core (modifiers, ndi2 st (modifiersleft, membr_coreright)))
class_body:
        LBRACE members RBRACE
                (members)
membr_core:
        type_decl_core
                (type_decl_core)
|       typ var_declarators SEMI
                (fn (mods, ni) => DField (mods, typ, var_declarators, ni))
|       typ IDENT LPAREN params RPAREN dims_opt throws_opt method_tail
                (fn (mods, ni) =>
                   DMethod (mods, [], typ, mkid st (IDENT, IDENTleft, IDENTright), params,
                            dims_opt, throws_opt, #1 method_tail, #2 method_tail, ni))
|       VOID IDENT LPAREN params RPAREN dims_opt throws_opt method_tail
                (fn (mods, ni) =>
                   DMethod (mods, [], TPrim ([], "void", ndi2 st (VOIDleft, VOIDright)),
                            mkid st (IDENT, IDENTleft, IDENTright), params, dims_opt,
                            throws_opt, #1 method_tail, #2 method_tail, ni))
|       tparams typ IDENT LPAREN params RPAREN dims_opt throws_opt method_tail
                (fn (mods, ni) =>
                   DMethod (mods, tparams, typ, mkid st (IDENT, IDENTleft, IDENTright), params,
                            dims_opt, throws_opt, #1 method_tail, #2 method_tail, ni))
|       tparams VOID IDENT LPAREN params RPAREN dims_opt throws_opt method_tail
                (fn (mods, ni) =>
                   DMethod (mods, tparams, TPrim ([], "void", ndi2 st (VOIDleft, VOIDright)),
                            mkid st (IDENT, IDENTleft, IDENTright), params, dims_opt,
                            throws_opt, #1 method_tail, #2 method_tail, ni))
|       IDENT LPAREN params RPAREN throws_opt block
                (fn (mods, ni) =>
                   DCtor (mods, [], mkid st (IDENT, IDENTleft, IDENTright), params, throws_opt,
                          block, ni))
|       tparams IDENT LPAREN params RPAREN throws_opt block
                (fn (mods, ni) =>
                   DCtor (mods, tparams, mkid st (IDENT, IDENTleft, IDENTright), params,
                          throws_opt, block, ni))
|       IDENT block
                (fn (mods, ni) => DCompact (mods, mkid st (IDENT, IDENTleft, IDENTright), block,
                  ni))
|       block
                (fn (mods, ni) =>
                   (case mods of
                      [] => DInit (false, block, ni)
                    | [MKw ("static", _)] => DInit (true, block, ni)
                    | _ => raise Fail "invalid modifiers of an initializer"))
|       SEMI
                (fn (mods, ni) =>
                   if null mods then DEmpty ni else raise Fail "modifiers before ';'")
method_tail:
        block
                ((SOME block, NONE))
|       SEMI
                ((NONE, NONE))
|       DEFAULT elem_value SEMI
                ((NONE, SOME elem_value))
type_decl_core:
        CLASS IDENT tparams_opt extends_opt implements_opt permits_opt class_body
                (fn (mods, ni) =>
                   DClass (mods, mkid st (IDENT, IDENTleft, IDENTright), tparams_opt, extends_opt,
                           implements_opt, permits_opt, class_body, ni))
|       INTERFACE IDENT tparams_opt iextends_opt permits_opt class_body
                (fn (mods, ni) =>
                   DInterface (mods, mkid st (IDENT, IDENTleft, IDENTright), tparams_opt,
                               iextends_opt, permits_opt, class_body, ni))
|       ENUM IDENT implements_opt enum_body
                (fn (mods, ni) =>
                   (case enum_body of
                      (consts, flags, body) =>
                        DEnum (mods, mkid st (IDENT, IDENTleft, IDENTright), implements_opt,
                               consts, flags, body, ni)))
|       RECORD IDENT tparams_opt LPAREN params RPAREN implements_opt class_body
                (fn (mods, ni) =>
                   DRecord (mods, mkid st (IDENT, IDENTleft, IDENTright), tparams_opt, params,
                            implements_opt, class_body, ni))
|       AT INTERFACE IDENT class_body
                (fn (mods, ni) =>
                   DAnnotType (mods, mkid st (IDENT, IDENTleft, IDENTright), class_body, ni))
extends_opt:
        
                (NONE)
|       EXTENDS ann_class_type
                (SOME ann_class_type)
implements_opt:
        
                ([])
|       IMPLEMENTS type_list
                (type_list)
permits_opt:
        
                ([])
|       PERMITS type_list
                (type_list)
iextends_opt:
        
                ([])
|       EXTENDS type_list
                (type_list)
throws_opt:
        
                ([])
|       THROWS type_list
                (type_list)
type_list:
        ann_class_type
                ([ann_class_type])
|       type_list COMMA ann_class_type
                (type_list @ [ann_class_type])
ann_class_type:
        class_type
                (class_type)
|       annots1 class_type
                (annotate_type annots1 class_type)
enum_body:
        LBRACE RBRACE
                (([], (false, false), []))
|       LBRACE SEMI members RBRACE
                (([], (false, true), members))
|       LBRACE enum_consts RBRACE
                ((enum_consts, (false, false), []))
|       LBRACE enum_consts COMMA RBRACE
                ((enum_consts, (true, false), []))
|       LBRACE enum_consts SEMI members RBRACE
                ((enum_consts, (false, true), members))
|       LBRACE enum_consts COMMA SEMI members RBRACE
                ((enum_consts, (true, true), members))
enum_consts:
        enum_const
                ([enum_const])
|       enum_consts COMMA enum_const
                (enum_consts @ [enum_const])
enum_const:
        IDENT enum_args_opt enum_body_opt
                (EnumConst ([], mkid st (IDENT, IDENTleft, IDENTright), enum_args_opt,
                            enum_body_opt, ndi2 st (IDENTleft, enum_body_optright)))
|       annots1 IDENT enum_args_opt enum_body_opt
                (EnumConst (annots1, mkid st (IDENT, IDENTleft, IDENTright), enum_args_opt,
                            enum_body_opt, ndi2 st (annots1left, enum_body_optright)))
enum_args_opt:
        
                (NONE)
|       LPAREN args RPAREN
                (SOME args)
enum_body_opt:
        
                (NONE)
|       class_body
                (SOME class_body)

(* ---------------------------------------------------------------------------------------- *)
(* type parameters                                                                            *)

tparams:
        TLT tparam_list TGT
                (tparam_list)
tparams_opt:
        
                ([])
|       tparams
                (tparams)
tparam_list:
        tparam
                ([tparam])
|       tparam_list COMMA tparam
                (tparam_list @ [tparam])
tparam:
        IDENT
                (TParam ([], mkid st (IDENT, IDENTleft, IDENTright), [],
                         ndi2 st (IDENTleft, IDENTright)))
|       annots1 IDENT
                (TParam (annots1, mkid st (IDENT, IDENTleft, IDENTright), [],
                         ndi2 st (annots1left, IDENTright)))
|       IDENT EXTENDS bound_list
                (TParam ([], mkid st (IDENT, IDENTleft, IDENTright), bound_list,
                         ndi2 st (IDENTleft, bound_listright)))
|       annots1 IDENT EXTENDS bound_list
                (TParam (annots1, mkid st (IDENT, IDENTleft, IDENTright), bound_list,
                         ndi2 st (annots1left, bound_listright)))
bound_list:
        ann_class_type
                ([ann_class_type])
|       bound_list AMP ann_class_type
                (bound_list @ [ann_class_type])

(* ---------------------------------------------------------------------------------------- *)
(* types                                                                                      *)

typ:
        prim_type
                (prim_type)
|       ref_type
                (ref_type)
|       VAR
                (TVar (ndi2 st (VARleft, VARright)))
prim_type:
        BOOLEAN
                (TPrim ([], "boolean", ndi2 st (BOOLEANleft, BOOLEANright)))
|       BYTE
                (TPrim ([], "byte", ndi2 st (BYTEleft, BYTEright)))
|       SHORT
                (TPrim ([], "short", ndi2 st (SHORTleft, SHORTright)))
|       INT
                (TPrim ([], "int", ndi2 st (INTleft, INTright)))
|       LONG
                (TPrim ([], "long", ndi2 st (LONGleft, LONGright)))
|       CHAR
                (TPrim ([], "char", ndi2 st (CHARleft, CHARright)))
|       FLOAT
                (TPrim ([], "float", ndi2 st (FLOATleft, FLOATright)))
|       DOUBLE
                (TPrim ([], "double", ndi2 st (DOUBLEleft, DOUBLEright)))
ref_type:
        class_type
                (class_type)
|       array_type
                (array_type)
class_type:
        qname
                (class_of_qn st qname)
|       gen_class_type
                (gen_class_type)
gen_class_type:
        qname targs
                (class_with_args st (qname, targs, targsright))
|       qname targs ctail
                (class_extend st (class_with_args st (qname, targs, targsright), ctail, ctailright))
ctail:
        ctail_seg
                ([ctail_seg])
|       ctail ctail_seg
                (ctail @ [ctail_seg])
ctail_seg:
        PERIOD IDENT
                ((mkid st (IDENT, IDENTleft, IDENTright), NONE))
|       PERIOD IDENT targs
                ((mkid st (IDENT, IDENTleft, IDENTright), SOME targs))
array_type:
        prim_type dims
                (array_of st (prim_type, dims, prim_typeleft, dimsright))
|       class_type dims
                (array_of st (class_type, dims, class_typeleft, dimsright))
dims:
        dim
                ([dim])
|       dims dim
                (dims @ [dim])
dims_opt:
        
                ([])
|       dims
                (dims)
dim:
        EMPTYBRK
                (Dim ([], ndi2 st (EMPTYBRKleft, EMPTYBRKright)))
|       annots1 EMPTYBRK
                (Dim (annots1, ndi2 st (annots1left, EMPTYBRKright)))
targs:
        TLT TGT
                (TArgs ([], ndi2 st (TLTleft, TGTright)))
|       TLT targ_list TGT
                (TArgs (targ_list, ndi2 st (TLTleft, TGTright)))
targ_list:
        targ
                ([targ])
|       targ_list COMMA targ
                (targ_list @ [targ])
targ:
        ref_type
                (TAType ref_type)
|       annots1 ref_type
                (TAType (annotate_type annots1 ref_type))
|       wildcard
                (wildcard)
wildcard:
        QUESTION
                (TAWild ([], NONE, ndi2 st (QUESTIONleft, QUESTIONright)))
|       QUESTION EXTENDS ann_ref_type
                (TAWild ([], SOME (true, ann_ref_type), ndi2 st (QUESTIONleft, ann_ref_typeright)))
|       QUESTION SUPER ann_ref_type
                (TAWild ([], SOME (false, ann_ref_type),
                          ndi2 st (QUESTIONleft, ann_ref_typeright)))
|       annots1 QUESTION
                (TAWild (annots1, NONE, ndi2 st (annots1left, QUESTIONright)))
|       annots1 QUESTION EXTENDS ann_ref_type
                (TAWild (annots1, SOME (true, ann_ref_type),
                         ndi2 st (annots1left, ann_ref_typeright)))
|       annots1 QUESTION SUPER ann_ref_type
                (TAWild (annots1, SOME (false, ann_ref_type),
                         ndi2 st (annots1left, ann_ref_typeright)))
ann_ref_type:
        ref_type
                (ref_type)
|       annots1 ref_type
                (annotate_type annots1 ref_type)
cast_type_list:
        ann_ref_type
                ([ann_ref_type])
|       cast_type_list AMP ann_ref_type
                (cast_type_list @ [ann_ref_type])

(* ---------------------------------------------------------------------------------------- *)
(* parameters and variables                                                                   *)

params:
        
                ([])
|       param_list
                (param_list)
param_list:
        param
                ([param])
|       param_list COMMA param
                (param_list @ [param])
param:
        typ var_id dims_opt
                (Param ([], typ, false, var_id, dims_opt, ndi2 st (typleft, dims_optright)))
|       local_mods1 typ var_id dims_opt
                (Param (local_mods1, typ, false, var_id, dims_opt,
                        ndi2 st (local_mods1left, dims_optright)))
|       typ ELLIPSIS var_id
                (Param ([], typ, true, var_id, [], ndi2 st (typleft, var_idright)))
|       local_mods1 typ ELLIPSIS var_id
                (Param (local_mods1, typ, true, var_id, [],
                        ndi2 st (local_mods1left, var_idright)))
|       typ THIS
                (Param ([], typ, false, mkid st ("this", THISleft, THISright), [],
                        ndi2 st (typleft, THISright)))
|       typ IDENT PERIOD THIS
                (Param ([], typ, false, mkid st (IDENT ^ ".this", IDENTleft, THISright), [],
                        ndi2 st (typleft, THISright)))
var_id:
        IDENT
                (mkid st (IDENT, IDENTleft, IDENTright))
|       UNDERSCORE
                (mkid st ("_", UNDERSCOREleft, UNDERSCOREright))
var_declarators:
        var_declarator
                ([var_declarator])
|       var_declarators COMMA var_declarator
                (var_declarators @ [var_declarator])
var_declarator:
        var_id dims_opt
                (VarDecl (var_id, dims_opt, NONE, ndi2 st (var_idleft, dims_optright)))
|       var_id dims_opt ASSIGN var_init
                (VarDecl (var_id, dims_opt, SOME var_init, ndi2 st (var_idleft, var_initright)))
var_init:
        expr
                (expr)
|       array_init
                (array_init)
array_init:
        LBRACE RBRACE
                (EArrayInit ([], false, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE var_inits RBRACE
                (EArrayInit (var_inits, false, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE var_inits COMMA RBRACE
                (EArrayInit (var_inits, true, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE COMMA RBRACE
                (EArrayInit ([], true, ndi2 st (LBRACEleft, RBRACEright)))
var_inits:
        var_init
                ([var_init])
|       var_inits COMMA var_init
                (var_inits @ [var_init])

(* ---------------------------------------------------------------------------------------- *)
(* statements                                                                                 *)

block:
        LBRACE block_stmts RBRACE
                (Block (block_stmts, ndi2 st (LBRACEleft, RBRACEright)))
block_stmts:
        
                ([])
|       block_stmts block_stmt
                (block_stmts @ [block_stmt])
block_stmt:
        local_var_decl SEMI
                (SLocal local_var_decl)
|       type_decl_core
                (SClassDecl (type_decl_core ([], ndi2 st (type_decl_coreleft,
                  type_decl_coreright))))
|       local_mods1 type_decl_core
                (SClassDecl (type_decl_core (local_mods1,
                                             ndi2 st (local_mods1left, type_decl_coreright))))
|       stmt
                (stmt)
local_var_decl:
        typ var_declarators
                (LocalVar ([], typ, var_declarators, ndi2 st (typleft, var_declaratorsright)))
|       local_mods1 typ var_declarators
                (LocalVar (local_mods1, typ, var_declarators,
                           ndi2 st (local_mods1left, var_declaratorsright)))
stmt:
        block
                (SBlock block)
|       SEMI
                (SEmpty (ndi2 st (SEMIleft, SEMIright)))
|       IDENT COLON stmt
                (SLabeled (mkid st (IDENT, IDENTleft, IDENTright), stmt,
                           ndi2 st (IDENTleft, stmtright)))
|       stmt_expr SEMI
                (SExpr (stmt_expr, ndi2 st (stmt_exprleft, SEMIright)))
|       IF LPAREN expr RPAREN stmt %prec LOWER_THAN_ELSE
                (SIf (expr, stmt, NONE, ndi2 st (IFleft, stmtright)))
|       IF LPAREN expr RPAREN stmt ELSE stmt
                (SIf (expr, stmt1, SOME stmt2, ndi2 st (IFleft, stmt2right)))
|       ASSERT expr SEMI
                (SAssert (expr, NONE, ndi2 st (ASSERTleft, SEMIright)))
|       ASSERT expr COLON expr SEMI
                (SAssert (expr1, SOME expr2, ndi2 st (ASSERTleft, SEMIright)))
|       SWITCH LPAREN expr RPAREN switch_block
                (SSwitch (expr, switch_block, ndi2 st (SWITCHleft, switch_blockright)))
|       WHILE LPAREN expr RPAREN stmt
                (SWhile (expr, stmt, ndi2 st (WHILEleft, stmtright)))
|       DO stmt WHILE LPAREN expr RPAREN SEMI
                (SDo (stmt, expr, ndi2 st (DOleft, SEMIright)))
|       FOR LPAREN for_init_opt SEMI expr_opt SEMI for_update_opt RPAREN stmt
                (SFor (for_init_opt, expr_opt, for_update_opt, stmt, ndi2 st (FORleft, stmtright)))
|       FOR LPAREN typ var_id COLON expr RPAREN stmt
                (SForEach ([], typ, var_id, expr, stmt, ndi2 st (FORleft, stmtright)))
|       FOR LPAREN local_mods1 typ var_id COLON expr RPAREN stmt
                (SForEach (local_mods1, typ, var_id, expr, stmt, ndi2 st (FORleft, stmtright)))
|       BREAK SEMI
                (SBreak (NONE, ndi2 st (BREAKleft, SEMIright)))
|       BREAK IDENT SEMI
                (SBreak (SOME (mkid st (IDENT, IDENTleft, IDENTright)),
                         ndi2 st (BREAKleft, SEMIright)))
|       CONTINUE SEMI
                (SContinue (NONE, ndi2 st (CONTINUEleft, SEMIright)))
|       CONTINUE IDENT SEMI
                (SContinue (SOME (mkid st (IDENT, IDENTleft, IDENTright)),
                            ndi2 st (CONTINUEleft, SEMIright)))
|       RETURN SEMI
                (SReturn (NONE, ndi2 st (RETURNleft, SEMIright)))
|       RETURN expr SEMI
                (SReturn (SOME expr, ndi2 st (RETURNleft, SEMIright)))
|       THROW expr SEMI
                (SThrow (expr, ndi2 st (THROWleft, SEMIright)))
|       YIELD expr SEMI
                (SYield (expr, ndi2 st (YIELDleft, SEMIright)))
|       SYNCHRONIZED LPAREN expr RPAREN block
                (SSync (expr, block, ndi2 st (SYNCHRONIZEDleft, blockright)))
|       TRY block catches
                (STry ([], false, block, catches, NONE, ndi2 st (TRYleft, catchesright)))
|       TRY block catches finally
                (STry ([], false, block, catches, SOME finally, ndi2 st (TRYleft, finallyright)))
|       TRY block finally
                (STry ([], false, block, [], SOME finally, ndi2 st (TRYleft, finallyright)))
|       TRY LPAREN resources RPAREN block
                (STry (#1 resources, #2 resources, block, [], NONE, ndi2 st (TRYleft, blockright)))
|       TRY LPAREN resources RPAREN block catches
                (STry (#1 resources, #2 resources, block, catches, NONE, ndi2 st (TRYleft,
                  catchesright)))
|       TRY LPAREN resources RPAREN block finally
                (STry (#1 resources, #2 resources, block, [], SOME finally, ndi2 st (TRYleft,
                  finallyright)))
|       TRY LPAREN resources RPAREN block catches finally
                (STry (#1 resources, #2 resources, block, catches, SOME finally, ndi2 st (TRYleft,
                  finallyright)))
|       THIS LPAREN args RPAREN SEMI
                (SCtorCall (NONE, NONE, false, args, ndi2 st (THISleft, SEMIright)))
|       SUPER LPAREN args RPAREN SEMI
                (SCtorCall (NONE, NONE, true, args, ndi2 st (SUPERleft, SEMIright)))
|       targs THIS LPAREN args RPAREN SEMI
                (SCtorCall (NONE, SOME targs, false, args, ndi2 st (targsleft, SEMIright)))
|       targs SUPER LPAREN args RPAREN SEMI
                (SCtorCall (NONE, SOME targs, true, args, ndi2 st (targsleft, SEMIright)))
|       qname PERIOD SUPER LPAREN args RPAREN SEMI
                (SCtorCall (SOME (expr_of_qn st qname), NONE, true, args,
                            ndi2 st (qnameleft, SEMIright)))
|       qname PERIOD targs SUPER LPAREN args RPAREN SEMI
                (SCtorCall (SOME (expr_of_qn st qname), SOME targs, true, args,
                            ndi2 st (qnameleft, SEMIright)))
|       primary PERIOD SUPER LPAREN args RPAREN SEMI
                (SCtorCall (SOME primary, NONE, true, args, ndi2 st (primaryleft, SEMIright)))
|       primary PERIOD targs SUPER LPAREN args RPAREN SEMI
                (SCtorCall (SOME primary, SOME targs, true, args, ndi2 st (primaryleft, SEMIright)))
stmt_expr:
        assignment
                (assignment)
|       pre_inc
                (pre_inc)
|       pre_dec
                (pre_dec)
|       post_inc
                (post_inc)
|       post_dec
                (post_dec)
|       method_invocation
                (method_invocation)
|       class_creation
                (class_creation)
stmt_expr_list:
        stmt_expr
                ([stmt_expr])
|       stmt_expr_list COMMA stmt_expr
                (stmt_expr_list @ [stmt_expr])
expr_opt:
        
                (NONE)
|       expr
                (SOME expr)
for_init:
        local_var_decl
                (FIVars local_var_decl)
|       stmt_expr_list
                (FIExprs stmt_expr_list)
for_init_opt:
        
                (NONE)
|       for_init
                (SOME for_init)
for_update_opt:
        
                ([])
|       stmt_expr_list
                (stmt_expr_list)
catches:
        catch_clause
                ([catch_clause])
|       catches catch_clause
                (catches @ [catch_clause])
catch_clause:
        CATCH LPAREN catch_mods catch_types var_id RPAREN block
                (Catch (catch_mods, catch_types, var_id, block, ndi2 st (CATCHleft, blockright)))
catch_mods:
        
                ([])
|       local_mods1
                (local_mods1)
catch_types:
        typ
                ([typ])
|       catch_types BAR typ
                (catch_types @ [typ])
finally:
        FINALLY block
                (block)
resources:
        resource_list
                ((resource_list, false))
|       resource_list SEMI
                ((resource_list, true))
resource_list:
        resource
                ([resource])
|       resource_list SEMI resource
                (resource_list @ [resource])
resource:
        typ var_id ASSIGN expr
                (RDecl (LocalVar ([], typ, [VarDecl (var_id, [], SOME expr,
                                                     ndi2 st (var_idleft, exprright))],
                                  ndi2 st (typleft, exprright))))
|       local_mods1 typ var_id ASSIGN expr
                (RDecl (LocalVar (local_mods1, typ, [VarDecl (var_id, [], SOME expr,
                                                              ndi2 st (var_idleft, exprright))],
                                  ndi2 st (local_mods1left, exprright))))
|       postfix
                (RExpr postfix)

(* ---------------------------------------------------------------------------------------- *)
(* switch                                                                                     *)

switch_block:
        LBRACE RBRACE
                ([])
|       LBRACE sw_rules RBRACE
                (sw_rules)
|       LBRACE sw_flat RBRACE
                (regroup st sw_flat)
sw_rules:
        sw_rule
                ([sw_rule])
|       sw_rules sw_rule
                (sw_rules @ [sw_rule])
sw_rule:
        switch_label ARROW rule_body
                (SwRule (switch_label, rule_body, ndi2 st (switch_labelleft, rule_bodyright)))
rule_body:
        expr SEMI
                (RBExpr expr)
|       block
                (RBBlock block)
|       THROW expr SEMI
                (RBThrow (SThrow (expr, ndi2 st (THROWleft, SEMIright))))
sw_flat:
        switch_label COLON
                ([SwLab switch_label])
|       sw_flat switch_label COLON
                (sw_flat @ [SwLab switch_label])
|       sw_flat block_stmt
                (sw_flat @ [SwStm block_stmt])
switch_label:
        CASE case_items guard_opt
                (LCase (case_items, guard_opt, ndi2 st (CASEleft, guard_optright)))
|       DEFAULT
                (LDefault (ndi2 st (DEFAULTleft, DEFAULTright)))
case_items:
        case_item
                ([case_item])
|       case_items COMMA case_item
                (case_items @ [case_item])
case_item:
        cond_expr
                (CIExpr cond_expr)
|       pattern
                (CIPattern pattern)
|       DEFAULT
                (CIDefault)
guard_opt:
        
                (NONE)
|       WHEN expr
                (SOME expr)
pattern:
        typ var_id
                (PType ([], typ, SOME var_id, ndi2 st (typleft, var_idright)))
|       local_mods1 typ var_id
                (PType (local_mods1, typ, SOME var_id, ndi2 st (local_mods1left, var_idright)))
|       ref_type RECLP RPAREN
                (PRecord (ref_type, [], ndi2 st (ref_typeleft, RPARENright)))
|       ref_type RECLP pattern_list RPAREN
                (PRecord (ref_type, pattern_list, ndi2 st (ref_typeleft, RPARENright)))
pattern_list:
        comp_pattern
                ([comp_pattern])
|       pattern_list COMMA comp_pattern
                (pattern_list @ [comp_pattern])
comp_pattern:
        pattern
                (pattern)
|       UNDERSCORE
                (PAny (ndi2 st (UNDERSCOREleft, UNDERSCOREright)))

(* ---------------------------------------------------------------------------------------- *)
(* expressions                                                                                *)

expr:
        lambda
                (lambda)
|       assign_expr
                (assign_expr)
assign_expr:
        cond_expr
                (cond_expr)
|       assignment
                (assignment)
assignment:
        postfix assign_op expr
                (mk_assign st (postfix, assign_op, expr, postfixleft, exprright))
assign_op:
        ASSIGN
                (NONE)
|       OPASSIGN
                (SOME (assign_binop OPASSIGN))
cond_expr:
        binary %prec ARROW
                (binary)
|       binary QUESTION expr COLON cond_expr
                (ECond (binary, expr, cond_expr, ndi2 st (binaryleft, cond_exprright)))
|       binary QUESTION expr COLON lambda
                (ECond (binary, expr, lambda, ndi2 st (binaryleft, lambdaright)))
binary:
        unary
                (unary)
|       binary OROR binary
                (binop st (LOr, binary1, binary2, binary1left, binary2right))
|       binary ANDAND binary
                (binop st (LAnd, binary1, binary2, binary1left, binary2right))
|       binary BAR binary
                (binop st (BOr, binary1, binary2, binary1left, binary2right))
|       binary CARET binary
                (binop st (BXor, binary1, binary2, binary1left, binary2right))
|       binary AMP binary
                (binop st (BAnd, binary1, binary2, binary1left, binary2right))
|       binary EQEQ binary
                (binop st (Eq, binary1, binary2, binary1left, binary2right))
|       binary NE binary
                (binop st (Ne, binary1, binary2, binary1left, binary2right))
|       binary LT binary
                (binop st (Lt, binary1, binary2, binary1left, binary2right))
|       binary GT binary
                (binop st (Gt, binary1, binary2, binary1left, binary2right))
|       binary LE binary
                (binop st (Le, binary1, binary2, binary1left, binary2right))
|       binary GE binary
                (binop st (Ge, binary1, binary2, binary1left, binary2right))
|       binary SHL binary
                (binop st (Shl, binary1, binary2, binary1left, binary2right))
|       binary SHR binary
                (binop st (Shr, binary1, binary2, binary1left, binary2right))
|       binary USHR binary
                (binop st (UShr, binary1, binary2, binary1left, binary2right))
|       binary PLUS binary
                (binop st (Add, binary1, binary2, binary1left, binary2right))
|       binary MINUS binary
                (binop st (Sub, binary1, binary2, binary1left, binary2right))
|       binary STAR binary
                (binop st (Mul, binary1, binary2, binary1left, binary2right))
|       binary SLASH binary
                (binop st (Div, binary1, binary2, binary1left, binary2right))
|       binary PERCENT binary
                (binop st (Rem, binary1, binary2, binary1left, binary2right))
|       binary INSTANCEOF ref_type
                (EInstanceof (binary, PType ([], ref_type, NONE, ndi2 st (ref_typeleft,
                                                                          ref_typeright)),
                              ndi2 st (binaryleft, ref_typeright)))
|       binary INSTANCEOF pattern
                (EInstanceof (binary, pattern, ndi2 st (binaryleft, patternright)))
unary:
        pre_inc
                (pre_inc)
|       pre_dec
                (pre_dec)
|       PLUS unary
                (EUnary (UPlus, unary, ndi2 st (PLUSleft, unaryright)))
|       MINUS unary
                (EUnary (UMinus, unary, ndi2 st (MINUSleft, unaryright)))
|       unary_npm
                (unary_npm)
pre_inc:
        INC unary
                (EUnary (PreInc, unary, ndi2 st (INCleft, unaryright)))
pre_dec:
        DEC unary
                (EUnary (PreDec, unary, ndi2 st (DECleft, unaryright)))
unary_npm:
        postfix
                (postfix)
|       TILDE unary
                (EUnary (UCompl, unary, ndi2 st (TILDEleft, unaryright)))
|       NOT unary
                (EUnary (UNot, unary, ndi2 st (NOTleft, unaryright)))
|       cast
                (cast)
|       switch_expr
                (switch_expr)
postfix:
        primary
                (primary)
|       qname
                (expr_of_qn st qname)
|       post_inc
                (post_inc)
|       post_dec
                (post_dec)
post_inc:
        postfix INC
                (mk_postfix st (PostInc, postfix, postfixleft, INCright))
post_dec:
        postfix DEC
                (mk_postfix st (PostDec, postfix, postfixleft, DECright))
cast:
        CASTLP prim_type RPAREN unary
                (ECast ([prim_type], unary, ndi2 st (CASTLPleft, unaryright)))
|       CASTLP cast_type_list RPAREN unary_npm
                (ECast (cast_type_list, unary_npm, ndi2 st (CASTLPleft, unary_npmright)))
|       CASTLP cast_type_list RPAREN lambda
                (ECast (cast_type_list, lambda, ndi2 st (CASTLPleft, lambdaright)))
primary:
        primary_nna
                (primary_nna)
|       array_creation
                (array_creation)
primary_nna:
        literal
                (literal)
|       THIS
                (EThis (ndi2 st (THISleft, THISright)))
|       qname PERIOD THIS
                (EQualThis (expr_of_qn st qname, ndi2 st (qnameleft, THISright)))
|       LPAREN expr RPAREN
                (EParen (expr, ndi2 st (LPARENleft, RPARENright)))
|       class_creation
                (class_creation)
|       field_access
                (field_access)
|       array_access
                (array_access)
|       method_invocation
                (method_invocation)
|       method_ref
                (method_ref)
|       class_lit
                (class_lit)
literal:
        INT_LIT
                (lit st (LInt INT_LIT, (INT_LITleft, INT_LITright)))
|       FLOAT_LIT
                (lit st (LFloat FLOAT_LIT, (FLOAT_LITleft, FLOAT_LITright)))
|       CHAR_LIT
                (lit st (LChar CHAR_LIT, (CHAR_LITleft, CHAR_LITright)))
|       STRING_LIT
                (lit st (LString STRING_LIT, (STRING_LITleft, STRING_LITright)))
|       TEXT_BLOCK
                (lit st (LTextBlock TEXT_BLOCK, (TEXT_BLOCKleft, TEXT_BLOCKright)))
|       TRUE
                (lit st (LBool true, (TRUEleft, TRUEright)))
|       FALSE
                (lit st (LBool false, (FALSEleft, FALSEright)))
|       NULL
                (lit st (LNull, (NULLleft, NULLright)))
field_access:
        primary PERIOD IDENT
                (EField (primary, mkid st (IDENT, IDENTleft, IDENTright),
                         ndi2 st (primaryleft, IDENTright)))
|       SUPER PERIOD IDENT
                (EField (ESuper (ndi2 st (SUPERleft, SUPERright)),
                         mkid st (IDENT, IDENTleft, IDENTright),
                         ndi2 st (SUPERleft, IDENTright)))
|       qname PERIOD SUPER PERIOD IDENT
                (EField (EQualSuper (expr_of_qn st qname, ndi2 st (qnameleft, SUPERright)),
                         mkid st (IDENT, IDENTleft, IDENTright),
                         ndi2 st (qnameleft, IDENTright)))
array_access:
        qname LBRACK expr RBRACK
                (EIndex (expr_of_qn st qname, expr, ndi2 st (qnameleft, RBRACKright)))
|       primary_nna LBRACK expr RBRACK
                (EIndex (primary_nna, expr, ndi2 st (primary_nnaleft, RBRACKright)))
|       array_creation_init LBRACK expr RBRACK
                (EIndex (array_creation_init, expr, ndi2 st (array_creation_initleft, RBRACKright)))
method_invocation:
        qname LPAREN args RPAREN
                (call_of_qn st (qname, args, qnameleft, RPARENright))
|       qname PERIOD targs IDENT LPAREN args RPAREN
                (ECall (SOME (expr_of_qn st qname), SOME targs,
                        mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (qnameleft, RPARENright)))
|       primary PERIOD IDENT LPAREN args RPAREN
                (ECall (SOME primary, NONE, mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (primaryleft, RPARENright)))
|       primary PERIOD targs IDENT LPAREN args RPAREN
                (ECall (SOME primary, SOME targs, mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (primaryleft, RPARENright)))
|       SUPER PERIOD IDENT LPAREN args RPAREN
                (ECall (SOME (ESuper (ndi2 st (SUPERleft, SUPERright))), NONE,
                        mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (SUPERleft, RPARENright)))
|       SUPER PERIOD targs IDENT LPAREN args RPAREN
                (ECall (SOME (ESuper (ndi2 st (SUPERleft, SUPERright))), SOME targs,
                        mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (SUPERleft, RPARENright)))
|       qname PERIOD SUPER PERIOD IDENT LPAREN args RPAREN
                (ECall (SOME (EQualSuper (expr_of_qn st qname, ndi2 st (qnameleft, SUPERright))),
                        NONE, mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (qnameleft, RPARENright)))
|       qname PERIOD SUPER PERIOD targs IDENT LPAREN args RPAREN
                (ECall (SOME (EQualSuper (expr_of_qn st qname, ndi2 st (qnameleft, SUPERright))),
                        SOME targs, mkid st (IDENT, IDENTleft, IDENTright), args,
                        ndi2 st (qnameleft, RPARENright)))
args:
        
                ([])
|       arg_list
                (arg_list)
arg_list:
        expr
                ([expr])
|       arg_list COMMA expr
                (arg_list @ [expr])
class_creation:
        NEW class_type LPAREN args RPAREN
                (ENew (NONE, class_type, args, NONE, ndi2 st (NEWleft, RPARENright)))
|       NEW class_type LPAREN args RPAREN class_body
                (ENew (NONE, class_type, args, SOME class_body, ndi2 st (NEWleft, class_bodyright)))
|       primary PERIOD NEW class_type LPAREN args RPAREN
                (ENew (SOME primary, class_type, args, NONE, ndi2 st (primaryleft, RPARENright)))
|       primary PERIOD NEW class_type LPAREN args RPAREN class_body
                (ENew (SOME primary, class_type, args, SOME class_body,
                       ndi2 st (primaryleft, class_bodyright)))
|       qname PERIOD NEW class_type LPAREN args RPAREN
                (ENew (SOME (expr_of_qn st qname), class_type, args, NONE,
                       ndi2 st (qnameleft, RPARENright)))
|       qname PERIOD NEW class_type LPAREN args RPAREN class_body
                (ENew (SOME (expr_of_qn st qname), class_type, args, SOME class_body,
                       ndi2 st (qnameleft, class_bodyright)))
array_creation:
        array_creation_init
                (array_creation_init)
|       NEW prim_type dim_exprs
                (ENewArray (prim_type, dim_exprs, [], NONE, ndi2 st (NEWleft, dim_exprsright)))
|       NEW prim_type dim_exprs dims
                (ENewArray (prim_type, dim_exprs, dims, NONE, ndi2 st (NEWleft, dimsright)))
|       NEW class_type dim_exprs
                (ENewArray (class_type, dim_exprs, [], NONE, ndi2 st (NEWleft, dim_exprsright)))
|       NEW class_type dim_exprs dims
                (ENewArray (class_type, dim_exprs, dims, NONE, ndi2 st (NEWleft, dimsright)))
array_creation_init:
        NEW prim_type dims array_init
                (ENewArray (prim_type, [], dims, SOME array_init, ndi2 st (NEWleft,
                  array_initright)))
|       NEW class_type dims array_init
                (ENewArray (class_type, [], dims, SOME array_init,
                            ndi2 st (NEWleft, array_initright)))
dim_exprs:
        LBRACK expr RBRACK
                ([expr])
|       dim_exprs LBRACK expr RBRACK
                (dim_exprs @ [expr])
method_ref:
        qname COLCOL mr_name
                (EMethodRef (mr_of_qn st qname, #1 mr_name, #2 mr_name,
                             ndi2 st (qnameleft, mr_nameright)))
|       primary COLCOL mr_name
                (EMethodRef (MRExpr primary, #1 mr_name, #2 mr_name,
                             ndi2 st (primaryleft, mr_nameright)))
|       gen_class_type COLCOL mr_name
                (EMethodRef (MRType gen_class_type, #1 mr_name, #2 mr_name,
                             ndi2 st (gen_class_typeleft, mr_nameright)))
|       array_type COLCOL mr_name
                (EMethodRef (MRType array_type, #1 mr_name, #2 mr_name,
                             ndi2 st (array_typeleft, mr_nameright)))
|       SUPER COLCOL mr_name
                (EMethodRef (MRExpr (ESuper (ndi2 st (SUPERleft, SUPERright))), #1 mr_name,
                             #2 mr_name, ndi2 st (SUPERleft, mr_nameright)))
|       qname PERIOD SUPER COLCOL mr_name
                (EMethodRef (MRExpr (EQualSuper (expr_of_qn st qname,
                                                 ndi2 st (qnameleft, SUPERright))),
                             #1 mr_name, #2 mr_name, ndi2 st (qnameleft, mr_nameright)))
mr_name:
        IDENT
                ((NONE, mkid st (IDENT, IDENTleft, IDENTright)))
|       NEW
                ((NONE, mkid st ("new", NEWleft, NEWright)))
|       targs IDENT
                ((SOME targs, mkid st (IDENT, IDENTleft, IDENTright)))
|       targs NEW
                ((SOME targs, mkid st ("new", NEWleft, NEWright)))
class_lit:
        qname PERIOD CLASS
                (EClassLit (class_of_qn st qname, ndi2 st (qnameleft, CLASSright)))
|       array_type PERIOD CLASS
                (EClassLit (array_type, ndi2 st (array_typeleft, CLASSright)))
|       prim_type PERIOD CLASS
                (EClassLit (prim_type, ndi2 st (prim_typeleft, CLASSright)))
|       VOID PERIOD CLASS
                (EClassLit (TPrim ([], "void", ndi2 st (VOIDleft, VOIDright)),
                            ndi2 st (VOIDleft, CLASSright)))
lambda:
        LAMID ARROW lambda_body
                (ELambda ([LPInfer (mkid st (LAMID, LAMIDleft, LAMIDright))], false, lambda_body,
                          ndi2 st (LAMIDleft, lambda_bodyright)))
|       LAMLP RPAREN ARROW lambda_body
                (ELambda ([], true, lambda_body, ndi2 st (LAMLPleft, lambda_bodyright)))
|       LAMLP lparam_list RPAREN ARROW lambda_body
                (ELambda (lparam_list, true, lambda_body, ndi2 st (LAMLPleft, lambda_bodyright)))
lambda_body:
        expr
                (LBExpr expr)
|       block
                (LBBlock block)
lparam_list:
        lparam
                ([lparam])
|       lparam_list COMMA lparam
                (lparam_list @ [lparam])
lparam:
        IDENT
                (LPInfer (mkid st (IDENT, IDENTleft, IDENTright)))
|       UNDERSCORE
                (LPInfer (mkid st ("_", UNDERSCOREleft, UNDERSCOREright)))
|       param
                (LPTyped param)
switch_expr:
        SWITCH LPAREN expr RPAREN switch_block
                (ESwitch (expr, switch_block, ndi2 st (SWITCHleft, switch_blockright)))
\<close>
ML\<open>
structure Java_Parse = struct

structure P = Java.JavaParser
structure T = Java.JavaLrVals.Tokens

(* a debugging aid: the kinds of the tokens the stream delivers, if "trace_on" *)
val trace_on = Unsynchronized.ref false
val trace : string list Unsynchronized.ref = Unsynchronized.ref []

datatype entry = Entry_Unit | Entry_Expr | Entry_Type | Entry_Id | Entry_Stmts | Entry_Decls

fun entry_token Entry_Unit p = T.ENTRY_UNIT (p, p)
  | entry_token Entry_Expr p = T.ENTRY_EXPR (p, p)
  | entry_token Entry_Type p = T.ENTRY_TYPE (p, p)
  | entry_token Entry_Id p = T.ENTRY_ID (p, p)
  | entry_token Entry_Stmts p = T.ENTRY_STMTS (p, p)
  | entry_token Entry_Decls p = T.ENTRY_DECLS (p, p)

(* The tokens the stream relabels: the contextual keywords, and the tokens of its own. *)
fun relabelled kind text l r = (case kind of
    "TLT" => T.TLT (l, r) | "TGT" => T.TGT (l, r) | "LAMLP" => T.LAMLP (l, r)
  | "CASTLP" => T.CASTLP (l, r) | "RECLP" => T.RECLP (l, r) | "LAMID" => T.LAMID (text, l, r)
  | "VAR" => T.VAR (l, r) | "YIELD" => T.YIELD (l, r) | "RECORD" => T.RECORD (l, r)
  | "SEALED" => T.SEALED (l, r) | "PERMITS" => T.PERMITS (l, r) | "WHEN" => T.WHEN (l, r)
  | "MODULE" => T.MODULE (l, r) | "OPEN" => T.OPEN (l, r) | "REQUIRES" => T.REQUIRES (l, r)
  | "EXPORTS" => T.EXPORTS (l, r) | "OPENS" => T.OPENS (l, r) | "USES" => T.USES (l, r)
  | "PROVIDES" => T.PROVIDES (l, r) | "TO" => T.TO (l, r) | "WITH" => T.WITH (l, r)
  | "TRANSITIVE" => T.TRANSITIVE (l, r)
  | _ => raise Fail ("Java_Parse.relabelled: " ^ kind))

val prim_kinds = ["BOOLEAN", "BYTE", "SHORT", "INT", "LONG", "CHAR", "FLOAT", "DOUBLE"]

(* The tokens aft which an operand has been completed: a "<" or a "(" aft one of them is an
   operator, a call, a comparison, ...; aft any other token it begins a type argument list, a
   parenthesized expression, a cast or a lambda. *)
val operand_end_kinds =
  ["IDENT", "INT_LIT", "FLOAT_LIT", "CHAR_LIT", "STRING_LIT", "TEXT_BLOCK", "TRUE", "FALSE", "NULL",
   "RPAREN", "RBRACK", "EMPTYBRK", "THIS", "SUPER", "INC", "DEC", "TGT", "UNDERSCORE", "LAMID"]

(* the tokens that may follow the closing parenthesis of a cast to a reference type *)
val cast_follow_kinds =
  ["IDENT", "INT_LIT", "FLOAT_LIT", "CHAR_LIT", "STRING_LIT", "TEXT_BLOCK", "TRUE", "FALSE", "NULL",
   "LPAREN", "NOT", "TILDE", "THIS", "SUPER", "NEW", "SWITCH", "UNDERSCORE", "VOID"] @ prim_kinds

(* before a qualified name that begins at one of these a "<" is a type argument list *)
val type_only_before = ["NEW", "INSTANCEOF", "EXTENDS", "IMPLEMENTS", "THROWS", "PERMITS", "CASTLP"]

(* before a qualified name that begins at one of these an expression follows: "a < b > c" is a
   pair of comparisons, and only "A<B>::m" can be a type *)
val expr_only_before =
  ["ASSIGN", "OPASSIGN", "RETURN", "THROW", "QUESTION", "ANDAND", "OROR", "PLUS", "MINUS", "STAR",
   "SLASH", "PERCENT", "BAR", "CARET", "EQEQ", "NE", "LE", "GE", "LT", "GT", "SHL", "SHR", "USHR",
   "NOT", "TILDE", "ARROW", "YIELD", "LBRACK", "INC", "DEC", "COLCOL"]

val control_kinds = ["IF", "WHILE", "FOR", "SWITCH", "SYNCHRONIZED", "CATCH", "TRY"]

val modifier_follow_kinds =
  ["CLASS", "INTERFACE", "ABSTRACT", "STATIC", "PUBLIC", "PRIVATE", "PROTECTED", "FINAL",
    "STRICTFP",
   "NONSEALED", "AT"]

val yield_follow_kinds =
  ["IDENT", "INT_LIT", "FLOAT_LIT", "CHAR_LIT", "STRING_LIT", "TEXT_BLOCK", "TRUE", "FALSE", "NULL",
   "LPAREN", "PLUS", "MINUS", "NOT", "TILDE", "INC", "DEC", "THIS", "SUPER", "NEW", "SWITCH",
   "VOID", "UNDERSCORE"] @ prim_kinds

(* An item of the stream: a token of the lexer with what the stream needs to know about it. The
   "kind" is the name of the token in the grammar, which the stream may change (a relabelled
   token), "pieces" says into how many ">" a ">>" or ">>>" in a type argument list is to be
   split. *)
datatype 'tok item =
  Item of {orig : string, kind : string Unsynchronized.ref, text : string, start : int, stop : int,
    tok : 'tok,
           pieces : int Unsynchronized.ref}

(* The stream between the lexer and the parser. Java cannot be parsed by an LALR(1) parser over
   the tokens of its lexer, for the reasons that every Java parser knows: a "<" can begin a type
   argument list or be a comparison, a "(" can begin a lambda, a cast, a record pattern or a
   parenthesized expression, "[" "]" can be the dimensions of a type or an index, "yield", "var",
   "record" and the other contextual keywords are names or keywords by their surroundings, and
   so on. As javac does, the stream looks ahead in the token list (it has the lexer's tokens
   buffered, and a type is scanned without building any tree) and hands the parser tokens that
   say which it is: TLT/TGT for the brackets of type arguments and parameters (">>" and ">>>"
   closing nested lists are split), LAMLP, CASTLP and RECLP for the parenthesis that opens a
   lambda's parameters, a cast, a record pattern, LAMID for the parameter of a lambda without
   parentheses, EMPTYBRK for "[" "]", and the keyword tokens of the contextual keywords. The
   grammar itself is then an ordinary context-free one. *)
fun java_stream entry st raw_lex pos eof_pos =
  let
    val eof_tok = T.EOF (eof_pos, eof_pos)
    val base = #base st
    val src = Lex_yacc_state.text_of base
    val src_len = String.size src

    (* --- the buffer of lexed tokens ------------------------------------------------------- *)
    val buf = Unsynchronized.ref (Array.array (1024, NONE))
    val filled = Unsynchronized.ref 0
    val pending = Unsynchronized.ref NONE
    val at_eof = Unsynchronized.ref false

    fun raw_next () =
      (case !pending of
         SOME x => (pending := NONE; x)
       | NONE =>
           let val tok = raw_lex ()
           in
             if P.sameToken (tok, eof_tok) then (tok, (src_len, src_len, "EOF"))
             else
               let val lay = Java_Layout.get st
               in (tok, (#start lay, #stop lay, #kind lay)) end
           end)

    fun mk_item (kind, start, stop, tok) =
      Item {orig = kind, kind = Unsynchronized.ref kind,
            text = if kind = "EOF" then "" else String.substring (src, start, stop - start),
            start = start, stop = stop, tok = tok, pieces = Unsynchronized.ref 1}

    fun lex_more () =
      let
        val (tok, (start, stop, kind)) = raw_next ()
        val item =
          if kind = "LBRACK" then
            let val (tok2, (start2, stop2, kind2)) = raw_next ()
            in
              if kind2 = "RBRACK"
              then mk_item ("EMPTYBRK", start, stop2, T.EMPTYBRK (pos start, pos stop2))
              else (pending := SOME (tok2, (start2, stop2, kind2));
                    mk_item (kind, start, stop, tok))
            end
          else mk_item (kind, start, stop, tok)
        val _ = if !filled = Array.length (!buf)
                then
                  let val bigger = Array.array (2 * !filled, NONE)
                  in Array.copy {src = !buf, dst = bigger, di = 0}; buf := bigger end
                else ()
      in
        Array.update (!buf, !filled, SOME item);
        filled := !filled + 1;
        (case item of Item {kind, ...} => if !kind = "EOF" then at_eof := true else ())
      end

    fun get i =
      (while !filled <= i andalso not (!at_eof) do lex_more ();
       Option.valOf (Array.sub (!buf, Int.min (Int.max (i, 0), !filled - 1))))

    fun kd i = (case get i of Item {kind, ...} => !kind)
    fun tx i = (case get i of Item {text, ...} => text)

    (* --- scanning types, without building anything ------------------------------------------ *)
    val edits : (int * string * int) list Unsynchronized.ref = Unsynchronized.ref []
    val carry = Unsynchronized.ref 0
    fun edit e = edits := e :: !edits
    fun apply_edits es =
      List.app (fn (i, k, n) =>
                  (case get i of Item {kind, pieces, ...} => (kind := k; pieces := n))) es

    fun is_prim k = member (op =) prim_kinds k

    (* i is at a "(": the index aft the matching ")" *)
    fun skip_balanced i =
      let
        fun go j depth =
          (case kd j of
             "EOF" => NONE
           | "LPAREN" => go (j + 1) (depth + 1)
           | "RPAREN" => if depth = 1 then SOME (j + 1) else go (j + 1) (depth - 1)
           | _ => go (j + 1) depth)
      in go i 0 end

    fun scan_annots i =
      if kd i = "AT" andalso kd (i + 1) = "IDENT" then
        let
          fun qn j = if kd j = "PERIOD" andalso kd (j + 1) = "IDENT" then qn (j + 2) else j
          val j = qn (i + 2)
          val k = if kd j = "LPAREN" then (case skip_balanced j of SOME k => k | NONE => j) else j
        in scan_annots k end
      else i

    fun scan_dims i =
      let val j = scan_annots i
      in if kd j = "EMPTYBRK" then scan_dims (j + 1) else i end

    (* closes the list of type arguments or parameters that began before j *)
    fun close_list j =
      if !carry > 0 then (carry := !carry - 1; SOME j)
      else
        (case kd j of
           "GT" => (edit (j, "TGT", 1); SOME (j + 1))
         | "SHR" => (edit (j, "TGT", 2); carry := 1; SOME (j + 1))
         | "USHR" => (edit (j, "TGT", 3); carry := 2; SOME (j + 1))
         | _ => NONE)

    fun scan_targs i =
      if kd i <> "LT" then NONE
      else
        let
          val _ = edit (i, "TLT", 1)
          fun list j =
            (case scan_targ j of
               NONE => NONE
             | SOME j1 =>
                 if !carry > 0 then close_list j1
                 else if kd j1 = "COMMA" then list (j1 + 1)
                 else close_list j1)
        in
          if kd (i + 1) = "GT" then (edit (i + 1, "TGT", 1); SOME (i + 2)) else list (i + 1)
        end

    and scan_targ j =
      let val j1 = scan_annots j
      in
        if kd j1 = "QUESTION" then
          (if kd (j1 + 1) = "EXTENDS" orelse kd (j1 + 1) = "SUPER" then scan_type (j1 + 2)
           else SOME (j1 + 1))
        else scan_type j1
      end

    and scan_type j =
      let val j1 = scan_annots j
      in
        if is_prim (kd j1) then SOME (scan_dims (j1 + 1))
        else if kd j1 = "IDENT" then
          (case scan_class_rest (j1 + 1) of NONE => NONE | SOME j2 => SOME (scan_dims j2))
        else NONE
      end

    (* aft an identifier of a class type: [targs] {. annots IDENT [targs]} *)
    and scan_class_rest j =
      (case (if kd j = "LT" then scan_targs j else SOME j) of
         NONE => NONE
       | SOME j1 =>
           if kd j1 = "PERIOD" then
             let val j2 = scan_annots (j1 + 1)
             in if kd j2 = "IDENT" then scan_class_rest (j2 + 1) else SOME j1 end
           else SOME j1)

    (* type parameters: annots IDENT [extends T {& T}] {, ...} *)
    fun scan_tparams i =
      if kd i <> "LT" then NONE
      else
        let
          val _ = edit (i, "TLT", 1)
          fun bounds j =
            (case scan_type j of
               NONE => NONE
             | SOME j1 => if kd j1 = "AMP" then bounds (j1 + 1) else SOME j1)
          fun one j =
            let val j1 = scan_annots j
            in
              if kd j1 <> "IDENT" then NONE
              else if kd (j1 + 1) = "EXTENDS" then bounds (j1 + 2)
              else SOME (j1 + 1)
            end
          fun list j =
            (case one j of
               NONE => NONE
             | SOME j1 =>
                 if !carry > 0 then close_list j1
                 else if kd j1 = "COMMA" then list (j1 + 1)
                 else close_list j1)
        in list (i + 1) end

    fun scan_cast_types j =
      (case scan_type j of
         NONE => NONE
       | SOME j1 => if kd j1 = "AMP" then scan_cast_types (j1 + 1) else SOME j1)

    (* runs a scan from i with fresh bookkeeping; the edits are applied by the caller, if at all *)
    fun attempt scan i =
      (edits := []; carry := 0;
       (case scan i of
          SOME j => if !carry = 0 then SOME (j, !edits) else NONE
        | NONE => NONE))

    (* --- the state of the classification -------------------------------------------------- *)
    val cur = Unsynchronized.ref 0
    val queue = Unsynchronized.ref [entry_token entry (pos 0)]
    val paren_depth = Unsynchronized.ref 0
    val paren_stack : string list Unsynchronized.ref = Unsynchronized.ref []
    val cast_closers : int list Unsynchronized.ref = Unsynchronized.ref []
    val in_case = Unsynchronized.ref false
    val case_pd = Unsynchronized.ref 0
    val case_tern = Unsynchronized.ref 0
    val ptype = Unsynchronized.ref false
    val targ_depth = Unsynchronized.ref 0
    val rec_pds : int list Unsynchronized.ref = Unsynchronized.ref []
    val brace_depth = Unsynchronized.ref 0
    val mod_state = Unsynchronized.ref 0
    val mod_bd = Unsynchronized.ref 0
    (* in a list of types after extends/implements/permits/throws: here a "<" opens type
       arguments *)
    val tl_mode = Unsynchronized.ref false
    (* the kinds of the open braces ("CLASS" for a class body, else "BLOCK"), and whether the
       header of a class or an instance creation is being read *)
    val brace_kinds : string list Unsynchronized.ref = Unsynchronized.ref []
    val class_kw_pending = Unsynchronized.ref false
    val new_pending = Unsynchronized.ref false

    fun qname_start j =
      if j >= 2 andalso kd (j - 1) = "PERIOD" andalso kd (j - 2) = "IDENT"
      then qname_start (j - 2) else j

    (* the name of an annotation, "@a.b.C" *)
    fun is_annot_name i =
      kd i = "IDENT" andalso (let val s = qname_start i in s >= 1 andalso kd (s - 1) = "AT" end)

    (* is the "(" at c the parenthesis of the arguments of a call, as opposed to the parameters of
       a method declaration? A name that is qualified, or that follows an operator, "new", "return"
       and the like, is called; a name that begins a member or a statement may be either. *)
    val call_before = ["ASSIGN", "OPASSIGN", "RETURN", "THROW", "NEW", "LPAREN", "COMMA",
      "QUESTION",
                       "ANDAND", "OROR", "PLUS", "MINUS", "STAR", "SLASH", "PERCENT", "BAR",
                         "CARET",
                       "AMP", "EQEQ", "NE", "LT", "GT", "LE", "GE", "SHL", "SHR", "USHR", "NOT",
                       "TILDE", "ARROW", "LBRACK", "INC", "DEC", "YIELD", "COLCOL", "CASTLP",
                       "LAMLP", "COLON"]
    fun is_call_paren c =
      kd (c - 1) = "IDENT" andalso
      (let val s = qname_start (c - 1)
       in
         s < c - 1
         orelse (s >= 1 andalso member (op =) call_before (kd (s - 1)))
         orelse (s >= 1 andalso member (op =) ["SEMI", "LBRACE", "RBRACE"] (kd (s - 1))
                 andalso (case !brace_kinds of "BLOCK" :: _ => true | _ => false))
         orelse (s = 0 andalso (entry = Entry_Expr orelse entry = Entry_Stmts))
       end)

    fun is_operand_end i =
      i >= 0 andalso member (op =) operand_end_kinds (kd i)
      andalso not (kd i = "RPAREN" andalso member (op =) (!cast_closers) i)
      andalso not (is_annot_name i)

    fun report_word c markup kind =
      (case get c of
         Item {start, stop, ...} => Lex_yacc_state.report_token base (start, stop - start, markup,
           kind, ""))

    (* is the "(" at c a cast? Returns the edits of the type argument lists inside. *)
    fun cast_check c =
      let val n = c + 1
      in
        if is_prim (kd n) then
          (case attempt scan_type n of
             SOME (j, es) => if kd j = "RPAREN" then SOME es else NONE
           | NONE => NONE)
        else if kd n = "IDENT" orelse kd n = "AT" then
          (case attempt scan_cast_types n of
             SOME (j, es) =>
               if kd j = "RPAREN" andalso member (op =) cast_follow_kinds (kd (j + 1))
               then SOME es else NONE
           | NONE => NONE)
        else NONE
      end

    (* the contextual keywords *)
    fun contextual c text prev =
      let
        val next = kd (c + 1)
        val stmt_start = member (op =) ["SEMI", "LBRACE", "RBRACE", "COLON", "ARROW", "RPAREN",
          "ELSE", "DO", ""] prev
      in
        (case text of
           "var" => if prev <> "PERIOD" andalso (next = "IDENT" orelse next = "UNDERSCORE")
                    then "VAR" else "IDENT"
         | "yield" => if stmt_start andalso
                         (if next = "INC" orelse next = "DEC" then kd (c + 2) <> "SEMI"
                          else member (op =) yield_follow_kinds next)
                      then "YIELD" else "IDENT"
         | "record" => if prev <> "PERIOD" andalso next = "IDENT"
                          andalso member (op =) ["LPAREN", "LT"] (kd (c + 2))
                       then "RECORD" else "IDENT"
         | "sealed" => if prev <> "PERIOD" andalso member (op =) modifier_follow_kinds next
                       then "SEALED" else "IDENT"
         | "permits" => if member (op =) ["IDENT", "TGT", "EMPTYBRK"] prev andalso next = "IDENT"
                        then "PERMITS" else "IDENT"
         | "when" => if !in_case andalso !paren_depth = !case_pd
                        andalso member (op =) ["IDENT", "RPAREN", "TGT", "UNDERSCORE",
                          "EMPTYBRK"] prev
                        andalso not (member (op =) ["ARROW", "COLON", "COMMA", "PERIOD",
                          "RPAREN"] next)
                     then "WHEN" else "IDENT"
         | "module" =>
             if next = "IDENT" andalso prev <> "PERIOD"
                andalso (prev = "IMPORT" orelse prev = "OPEN" orelse !mod_state = 0 andalso
                         (let fun qn j = if kd j = "PERIOD" andalso kd (j + 1) = "IDENT"
                                         then qn (j + 2) else j
                          in kd (qn (c + 2)) = "LBRACE" end))
             then "MODULE" else "IDENT"
         | "open" => if next = "IDENT" andalso tx (c + 1) = "module" andalso kd (c + 2) = "IDENT"
                     then "OPEN" else "IDENT"
         | "requires" => if !mod_state = 2 andalso (prev = "LBRACE" orelse prev = "SEMI")
                            andalso (next = "IDENT" orelse next = "STATIC")
                      then "REQUIRES" else "IDENT"
         | "exports" => if !mod_state = 2 andalso (prev = "LBRACE" orelse prev = "SEMI")
                           andalso next = "IDENT" then "EXPORTS" else "IDENT"
         | "opens" => if !mod_state = 2 andalso (prev = "LBRACE" orelse prev = "SEMI")
                         andalso next = "IDENT" then "OPENS" else "IDENT"
         | "uses" => if !mod_state = 2 andalso (prev = "LBRACE" orelse prev = "SEMI")
                        andalso next = "IDENT" then "USES" else "IDENT"
         | "provides" => if !mod_state = 2 andalso (prev = "LBRACE" orelse prev = "SEMI")
                            andalso next = "IDENT" then "PROVIDES" else "IDENT"
         | "to" => if !mod_state = 2 andalso prev = "IDENT" andalso next = "IDENT"
                   then "TO" else "IDENT"
         | "with" => if !mod_state = 2 andalso prev = "IDENT" andalso next = "IDENT"
                     then "WITH" else "IDENT"
         | "transitive" => if !mod_state = 2 andalso member (op =) ["REQUIRES", "TRANSITIVE"] prev
                              andalso (next = "IDENT" orelse next = "STATIC")
                           then "TRANSITIVE" else "IDENT"
         | _ => "IDENT")
      end

    val contextual_words =
      ["var", "yield", "record", "sealed", "permits", "when", "module", "open", "requires",
       "exports", "opens", "uses", "provides", "to", "with", "transitive"]

    fun classify c =
      let
        val Item {kind, text, orig, ...} = get c
        val prev = if c = 0 then "" else kd (c - 1)
        val _ =
          (case !kind of
             "LT" =>
               let
                 val s = qname_start (c - 1)
                 val bef = if s <= 0 then "" else kd (s - 1)
                 fun targs_attempt () =
                   attempt (fn i => (case scan_targs i of
                                       NONE => NONE
                                     | SOME j =>
                                         (case scan_class_rest j of
                                            NONE => NONE
                                          | SOME j1 => SOME (scan_dims j1)))) c
                 val decl_params =
                   prev = "IDENT" andalso s = c - 1 andalso member (op =) ["CLASS", "INTERFACE",
                     "RECORD"] bef
                 val res =
                   if decl_params then attempt scan_tparams c
                   else if not (is_operand_end (c - 1)) then
                     (case attempt scan_tparams c of
                        SOME r => SOME r
                      | NONE => targs_attempt ())
                   else if prev = "IDENT" then
                     (case targs_attempt () of
                        NONE => NONE
                      | SOME (j, es) =>
                          let val aft = kd j
                          in
                            if !tl_mode orelse member (op =) type_only_before bef
                               orelse (s = 0 andalso entry = Entry_Type)
                            then SOME (j, es)
                            else if member (op =) expr_only_before bef
                                    orelse ((bef = "LPAREN" orelse bef = "COMMA")
                                            andalso (case !paren_stack of
                                                       "CALL" :: _ => true
                                                     | _ => false))
                            then (if aft = "COLCOL" then SOME (j, es) else NONE)
                            else if member (op =) ["IDENT", "UNDERSCORE", "ELLIPSIS", "COLCOL"] aft
                            then SOME (j, es) else NONE
                          end)
                   else NONE
               in (case res of SOME (_, es) => apply_edits es | NONE => ()) end
           | "LPAREN" =>
               let
                 val operand_start =
                   not (is_operand_end (c - 1)) andalso not (member (op =) control_kinds prev)
                   andalso not (is_annot_name (c - 1))
                 val lam = operand_start
                           andalso not (!in_case andalso !paren_depth = !case_pd)
                           andalso (case skip_balanced c of
                                      SOME m => kd m = "ARROW"
                                    | NONE => false)
               in
                 if lam then kind := "LAMLP"
                 else if (prev = "IDENT" orelse prev = "TGT") andalso !ptype then kind := "RECLP"
                 else if operand_start then
                   (case cast_check c of
                      SOME es => (apply_edits es; kind := "CASTLP")
                    | NONE => ())
                 else ()
               end
           | "IDENT" =>
               if orig = "IDENT" then
                 let
                   val k1 = if member (op =) contextual_words text then contextual c text prev
                            else "IDENT"
                   val _ = if member (op =) contextual_words text
                           then report_word c
                                  (if k1 = "IDENT" then Markup.free else Markup.keyword1) k1
                           else ()
                   val k2 = if k1 = "IDENT" andalso kd (c + 1) = "ARROW"
                               andalso not (!in_case andalso !paren_depth = !case_pd)
                            then "LAMID" else k1
                 in kind := k2 end
               else ()
           | "UNDERSCORE" =>
               if kd (c + 1) = "ARROW" andalso not (!in_case andalso !paren_depth = !case_pd)
               then kind := "LAMID" else ()
           | _ => ())
        val fk = !kind
        (* the bookkeeping *)
        val _ =
          if member (op =) ["LPAREN", "LAMLP", "CASTLP", "RECLP"] fk then
            (paren_depth := !paren_depth + 1;
             paren_stack := (if fk = "LPAREN" andalso is_annot_name (c - 1) then "ANN"
                             else if fk = "LPAREN" andalso is_call_paren c then "CALL"
                             else fk)
                            :: !paren_stack;
             if fk = "RECLP" then rec_pds := !paren_depth :: !rec_pds else ())
          else if fk = "RPAREN" then
            (case !paren_stack of
               top :: rest =>
                 (paren_stack := rest;
                  if top = "CASTLP" orelse top = "ANN" then cast_closers := c :: !cast_closers
                  else ();
                  if top = "RECLP" then rec_pds := tl (!rec_pds) else ())
             | [] => ();
             paren_depth := Int.max (0, !paren_depth - 1))
          else ()
        val at_case_level = !in_case andalso !paren_depth = !case_pd
        val _ =
          (case fk of
             "CASE" => (in_case := true; case_pd := !paren_depth; case_tern := 0)
           | "QUESTION" => if at_case_level then case_tern := !case_tern + 1 else ()
           | "COLON" => if at_case_level
                        then (if !case_tern > 0 then case_tern := !case_tern - 1
                              else in_case := false)
                        else ()
           | "ARROW" => if at_case_level then in_case := false else ()
           | "TLT" => targ_depth := !targ_depth + 1
           | "TGT" => (case get c of Item {pieces, ...} => targ_depth := Int.max (0,
             !targ_depth - !pieces))
           | "MODULE" => if prev <> "IMPORT" then mod_state := 1 else ()
           | "LBRACE" => (if !mod_state = 1 then (mod_state := 2; mod_bd := !brace_depth) else ();
                          brace_depth := !brace_depth + 1;
                          brace_kinds :=
                            (if !class_kw_pending orelse (!new_pending andalso prev = "RPAREN")
                             then "CLASS" else "BLOCK") :: !brace_kinds;
                          class_kw_pending := false; new_pending := false)
           | "RBRACE" => (brace_depth := Int.max (0, !brace_depth - 1);
                          brace_kinds := (case !brace_kinds of _ :: rest => rest | [] => []);
                          class_kw_pending := false; new_pending := false;
                          if !mod_state = 2 andalso !brace_depth = !mod_bd
                          then mod_state := 0 else ())
           | "SEMI" => (class_kw_pending := false; new_pending := false)
           | "CLASS" => if prev <> "PERIOD" then class_kw_pending := true else ()
           | "INTERFACE" => class_kw_pending := true
           | "ENUM" => class_kw_pending := true
           | "RECORD" => class_kw_pending := true
           | "NEW" => new_pending := true
           | _ => ())
        val _ =
          tl_mode :=
            (if member (op =) ["EXTENDS", "IMPLEMENTS", "PERMITS", "THROWS"] fk then true
             else if !tl_mode then
               member (op =) ["IDENT", "PERIOD", "COMMA", "TLT", "TGT", "QUESTION", "SUPER", "AT",
                              "AMP", "EMPTYBRK"] fk
             else false)
        val _ =
          ptype :=
            (case fk of
               "INSTANCEOF" => true
             | "CASE" => true
             | "RECLP" => true
             | "COMMA" =>
                 if !targ_depth > 0 then !ptype
                 else (!in_case andalso !paren_depth = !case_pd)
                      orelse (case !rec_pds of d :: _ => d = !paren_depth | [] => false)
             | "IDENT" => if member (op =) ["IDENT", "TGT", "EMPTYBRK"] prev then false else !ptype
             | "VAR" => !ptype
             | "PERIOD" => !ptype
             | "TLT" => !ptype
             | "TGT" => !ptype
             | "QUESTION" => !ptype andalso !targ_depth > 0
             | "EXTENDS" => !ptype andalso !targ_depth > 0
             | "SUPER" => !ptype andalso !targ_depth > 0
             | "AT" => !ptype
             | "EMPTYBRK" => !ptype
             | "FINAL" => !ptype
             | "AMP" => !ptype
             | _ => false)
      in () end

    fun emit (Item {kind, text, start, stop, tok, orig, pieces}) =
      let val k = !kind
          val _ = if !trace_on
                  then trace := (if k = "TGT" then List.tabulate (!pieces, fn _ => "TGT")
                                 else [if k = orig then k else orig ^ ">" ^ k]) @ !trace
                  else ()
      in
        if k = orig then [tok]
        else if k = "TGT" then
          List.tabulate (!pieces, fn i => T.TGT (pos (start + i), pos (start + i + 1)))
        else [relabelled k text (pos start) (pos stop)]
      end

    fun next () =
      (case !queue of
         t :: ts => (queue := ts; t)
       | [] =>
           let val c = !cur
           in
             if kd c = "EOF" then eof_tok
             else (classify c; cur := c + 1; queue := emit (get c); next ())
           end)
  in P.Stream.streamify next end

(* Runs the parser on "source" from the given entry point; "mk_err" makes the parser's error
   callback from the parse's state. Every parse creates its own state. *)
fun parse mk_err entry ctxt source =
  let
    val st = Java_State.init ctxt source
    val err = mk_err st
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then "" else (consumed := true; input_text)
    val raw_lex = Java.JavaLex.makeLexer input_string st
    val pos = Lex_yacc_state.get_pos (#base st)
    val eof_pos = pos (String.size input_text)
    val stream = java_stream entry st raw_lex pos eof_pos
    val (result, _) = P.parse (0, stream, err, st)
      handle Fail msg => (err (msg, pos 0, pos 0); raise Fail msg)
    val _ = (case !(#lex_error st) of SOME (msg, p) => err (msg, p, p) | NONE => ())
  in result end

fun parse_loud entry ctxt source =
  parse (fn st => Lex_yacc_state.print_error (#base st)) entry ctxt source

(* The silent variant the "_reject" commands use: a locally declared exception, not the
   library's "print_error" (which reports PIDE error markup bef raising, and raises an
   exception Isabelle/ML cannot reliably catch by identity across the SML sandbox boundary). *)
exception Rejected of string
fun quiet_error (s : string, _ : Position.T, _ : Position.T) = raise Rejected s

fun parse_quiet entry ctxt source = parse (K quiet_error) entry ctxt source

(* The texts of the tokens of a source, as the lexer cuts them (no comments, no blanks): what
   the printed form of a parse must have in common with its source. *)
fun lex_texts ctxt source =
  let
    val st = Java_State.init ctxt source
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then "" else (consumed := true; input_text)
    val raw_lex = Java.JavaLex.makeLexer input_string st
    val eof_tok = T.EOF (Position.none, Position.none)
    fun loop acc =
      let val tok = raw_lex ()
      in
        if P.sameToken (tok, eof_tok) then rev acc
        else
          let val lay = Java_Layout.get st
          in loop (String.substring (input_text, #start lay, #stop lay - #start lay) :: acc) end
      end
  in loop [] end

end
