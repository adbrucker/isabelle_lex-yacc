chapter AFP

(* The Isabelle/AdaSpark manual, a sub-session of "AdaSpark" (../ROOT): it imports the global theory
   "AdaSpark" and runs its live examples against the real commands.

   Generate the PDF with

     isabelle build -d AdaSpark AdaSpark_Manual

   which writes "manual/output/document.pdf" ("output" is git-ignored). The LaTeX sources are in
   "document/": "root.tex" (the same style as the C11 and occam 2 manuals, uses the lualatex/fontspec
   setup of Isabelle's own document build) and "root.bib" (copied from the occam 2 manual, plus the
   Ada Reference Manual, the SPARK 2014 Reference Manual and HOL-SPARK). *)
session "AdaSpark_Manual" (AFP) = "AdaSpark" +
  options [timeout = 1200, document = pdf, document_output = "output"]
  theories
    AdaSpark_Manual
  document_files
    "root.tex"
    "root.bib"
