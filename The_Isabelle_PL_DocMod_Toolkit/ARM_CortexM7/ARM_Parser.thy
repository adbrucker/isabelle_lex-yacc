theory ARM_Parser
  imports "../../Isabelle_Lex-Yacc/LexYacc" "ARM_Ast"
begin

section\<open>Lexer and Parser for ARM Thumb-2 Assembly\<close>

text\<open>
  This theory contains the lexer and the parser of the assembly language of the ARM Cortex-M7
  (ARMv7E-M: Thumb-2 with the DSP extension and the floating point unit FPv5) in the syntax of the
  GNU assembler, generated by \<open>ml_lex_yacc [state]\<close> (the re-entrant variant of the library: every
  parse has its own state object), and \<^verbatim>\<open>ARM_Parse\<close>, the parse driver. What is accepted?

  \<^item> \<^bold>\<open>Lines.\<close> An assembly file is a list of lines; a line holds, separated by \<open>;\<close>, any number of
    labels (\<open>name:\<close>, \<open>.L1:\<close>, the numeric \<open>1:\<close>) followed by at most one statement. A statement is an
    \<^emph>\<open>instruction\<close> (a mnemonic with its operands, \<open>add.w r0, r1, #4\<close>, \<open>ldr r0, [r1, r2, lsl #2]!\<close>,
    \<open>push {r4-r7, lr}\<close>, \<open>vadd.f32 s0, s1, s2\<close>, \<open>ldr r0, =label\<close>), a \<^emph>\<open>directive\<close> (\<open>.word 1, 2\<close>,
    \<open>.section .text,"ax",%progbits\<close>, \<open>.type f, %function\<close>), a symbol assignment (\<open>sym = expr\<close>), a
    register alias (\<open>acc .req r4\<close>), or a \<^emph>\<open>macro call\<close>.
  \<^item> \<^bold>\<open>Mnemonics.\<close> The parser decodes a mnemonic into an opcode of the closed enumeration
    \<open>ARM_Ast.opcode\<close>, a condition, the S flag, the width (\<open>.n\<close>, \<open>.w\<close>) and the data types
    (\<open>.f32\<close>, \<open>.s32\<close>): \<open>adds\<close>, \<open>addeq\<close>, \<open>addseq\<close>, \<open>ldrsb.w\<close>, \<open>bleq\<close>, \<open>vcvtr.s32.f32\<close>,
    \<open>ite\<close>. A word at the start of a statement that is not a mnemonic is a macro call (or an
    instruction this front-end does not know).
  \<^item> \<^bold>\<open>Operands.\<close> Registers (\<open>r0\<close>-\<open>r15\<close>, \<open>sp\<close>, \<open>lr\<close>, \<open>pc\<close>, \<open>ip\<close>, \<open>fp\<close>, \<open>sl\<close>, \<open>sb\<close>, \<open>s0\<close>-\<open>s31\<close>,
    \<open>d0\<close>-\<open>d15\<close>, the special registers), immediates (\<open>#4\<close>, \<open>#:lower16:sym\<close>), shifts (\<open>lsl #2\<close>,
    \<open>asr r3\<close>, \<open>rrx\<close>), memory references (\<open>[r0]\<close>, \<open>[r0, #4]!\<close>, \<open>[r0, r1, lsl #2]\<close>, \<open>[r0, :64]\<close>),
    register lists (\<open>{r0-r3, lr}\<close>), literal pool entries (\<open>=sym\<close>), and expressions with the
    operators of the assembler and its precedences (\<open>*\<close> \<open>/\<close> \<open>%\<close> \<open><<\<close> \<open>>>\<close> bind tighter than
    \<open>|\<close> \<open>&\<close> \<open>^\<close>, which bind tighter than \<open>+\<close> \<open>-\<close>, then the comparisons, then \<open>&&\<close> and \<open>||\<close>).
  \<^item> \<^bold>\<open>Structure.\<close> Macros (\<open>.macro name a, b=1, c:req\<close> \<open>...\<close> \<open>.endm\<close>, with \<open>\arg\<close>, \<open>\@\<close> and \<open>\()\<close>
    in names), conditional assembly (\<open>.if\<close> and its relatives, \<open>.elseif\<close>, \<open>.else\<close>, \<open>.endif\<close>), and the
    loops \<open>.rept\<close>, \<open>.irp\<close>, \<open>.irpc\<close> (\<open>.endr\<close>) are blocks of lines, nested as they are written.

  \<^bold>\<open>Comments\<close> are \<open>@\<close> to the end of the line, \<open>//\<close> to the end of the line, \<open>/* ... */\<close> (they do not
  nest), and \<open>#\<close> at the start of a line (which is how \<open>as\<close> treats the line markers of the C
  preprocessor); they may contain antiquotations \<open>@@ tag[navi](level) \<open>body\<close>\<close> (also \<open>//@ ...\<close> and
  \<open>/*@ ... */\<close>), attached to the node of the next real token, as in the other front-ends.

  \<^bold>\<open>Known limitations.\<close> The parser does not check that the operands fit the instruction (the
  instruction encodings are not modelled); the arguments of a macro call are separated by commas;
  an operand that is a register alias defined by \<open>.req\<close> is a symbol until the analysis resolves it;
  the binary operator \<open>!\<close> (or-not) of the assembler is not supported, \<open>!\<close> being the write-back
  marker; angle-bracket quoting in macro arguments is not supported.
\<close>
ML\<open>
(* Everything the lexer and the grammar actions need to remember during one
   parse lives in one state object, created per parse ("init") and handed to
   the lexer (ML-Lex %arg) and the parser (ML-Yacc %arg) by "ml_lex_yacc
   [state]" - nothing is shared between parses.
     base        - the library's own part: source, context, position table
     pending     - comments lexed since the previous real token
     attached    - the comments that have been attached to a token position
     layout      - the layout recorder, see "ARM_Layout"
     antiq_*     - the antiquotation scanner (see the lexer): nesting depth of
                   the cartouche being skipped, which comment state to return
                   to, the most recent tag, the body text so far and its start
                   position
     bol         - nothing but blanks since the start of the line: a "#" then begins a comment
                   (a line marker of the C preprocessor), otherwise it marks an immediate
     comment_depth, bodyless_ok
                 - whether a block comment is open; whether a bodyless
                   antiquotation tag is allowed in the current comment
     lex_error   - the first lexical error (unterminated comment, string or
                   antiquotation): the lexer cannot raise it itself, as the
                   parse's error callback decides how an error is reported
                   (loudly, or silently for the "_reject" commands), so it is
                   recorded here and reported by "ARM_Parse.parse" when the
                   parse is over *)
structure ARM_State = struct
  type comments = Position.T ARM_Ast.comment list
  type layout = {nl: int, start: int, stop: int, kind: string}
  val layout_init : layout = {nl = 0, start = 0, stop = 0, kind = ""}

  type T = {base : Lex_yacc_state.T,
            pending : comments Unsynchronized.ref,
            attached : comments Inttab.table Unsynchronized.ref,
            layout : layout Unsynchronized.ref,
            antiq_depth : int Unsynchronized.ref,
            antiq_from_block : bool Unsynchronized.ref,
            antiq_tag : (string * ARM_Ast.navi list * int * Position.T)
              Unsynchronized.ref,
            antiq_buf : string list Unsynchronized.ref,
            antiq_start : Position.T Unsynchronized.ref,
            comment_depth : int Unsynchronized.ref,
            bodyless_ok : bool Unsynchronized.ref,
            comment_start : int Unsynchronized.ref,
            bol : bool Unsynchronized.ref,
            lex_error : (string * Position.T) option Unsynchronized.ref}

  fun init ctxt source : T =
    {base = Lex_yacc_state.init ctxt source,
     pending = Unsynchronized.ref [],
     attached = Unsynchronized.ref Inttab.empty,
     layout = Unsynchronized.ref layout_init,
     antiq_depth = Unsynchronized.ref 0,
     antiq_from_block = Unsynchronized.ref true,
     antiq_tag = Unsynchronized.ref ("", [], 0, Position.none),
     antiq_buf = Unsynchronized.ref [],
     antiq_start = Unsynchronized.ref Position.none,
     comment_depth = Unsynchronized.ref 0,
     bodyless_ok = Unsynchronized.ref false,
     comment_start = Unsynchronized.ref 0,
     bol = Unsynchronized.ref true,
     lex_error = Unsynchronized.ref NONE}
end

(* The comments/antiquotations collected while lexing, attached to whichever
   real token follows (as in C11_Comments / Occam2_Comments / Scala3_Comments).
   *)
structure ARM_Comments = struct
  fun push (st : ARM_State.T) c = #pending st := !(#pending st) @ [c]

  fun push_raw st (text, pos) =
    if List.all Char.isSpace (String.explode text) then ()
    else push st (ARM_Ast.Raw_txt [(text, pos)])

  fun push_antiquotation st tag navi level cartouche =
    push st (ARM_Ast.Antiquotation (tag, navi, level, cartouche))

  (* the comments are attached to a token by its offset: a file has many of them (the compiler
     writes one on nearly every line), so the lookup must not scan a list *)
  fun key (p : Position.T) = the_default ~1 (Position.offset_of p)

  fun attach_pending (st : ARM_State.T) (p : Position.T) =
    (case !(#pending st) of
       [] => ()
     | cs => (#pending st := []; #attached st := Inttab.update (key p, cs) (!(#attached st))))

  (* Non-destructive on purpose, for the reason given at "C11_Comments.claim".
     *)
  fun claim (st : ARM_State.T) (p : Position.T) : Position.T
    ARM_Ast.comment list =
    (case Inttab.lookup (!(#attached st)) (key p) of NONE => [] | SOME cs => cs)

  fun mk_nodeInfo st (claimed_at : Position.T)
    (report_pos : Position.T) : Position.T ARM_Ast.nodeInfo =
    (case claim st claimed_at of
       [] => ARM_Ast.OnlyPos report_pos
     | cs => ARM_Ast.NodeInfo (cs, report_pos))
end

(* Layout bookkeeping shared between the lexer actions and the stream wrapper.
   The lexer only ever records facts here; it never emits a separator token
   itself:
     nl     - the number of newlines lexed since the previous real token (also
              those inside general comments, as in the ARM specification)
     start/stop - character offsets of the newest real token
     kind   - the newest token's kind: its name in the grammar ("IDENT",
              "RBRACE", ...) *)
structure ARM_Layout = struct
  fun get (st : ARM_State.T) = !(#layout st)

  fun newline (st : ARM_State.T) =
    let val {nl, start, stop, kind} = get st
    in #layout st := {nl = nl + 1, start = start, stop = stop, kind = kind} end

  fun token (st : ARM_State.T) (start, stop, kind) =
    let val {nl, ...} = get st
    in #layout st := {nl = nl, start = start, stop = stop, kind = kind} end

  fun clear_newlines (st : ARM_State.T) =
    let val {start, stop, kind, ...} = get st
    in #layout st := {nl = 0, start = start, stop = stop, kind = kind} end
end
\<close>
SML_import \<open>structure ARM_Ast = struct open ARM_Ast end\<close>
SML_import \<open>structure ARM_State = struct open ARM_State end\<close>
SML_import \<open>structure ARM_Comments = struct open ARM_Comments end\<close>
SML_import \<open>structure ARM_Layout = struct open ARM_Layout end\<close>

SML_import \<open>structure ARM_Isa = struct open ARM_Isa end\<close>

ml_lex_yacc [verbose, state] "ARM" where

lex_user_declarations\<open>
(* The lexer's and the parser's argument is the per-parse state of
   "ARM_State" (the lexer rules and the grammar actions call it "st");
   "init" creates it, "base" is its part the library functions work on. *)
type arg = ARM_State.T
fun init ctxt source : arg = ARM_State.init ctxt source
fun base (st : arg) : Lex_yacc_state.T = #base st

fun gp (st : arg) yypos = Lex_yacc_state.get_pos (base st) yypos
fun report (st : arg) x = Lex_yacc_state.report_token (base st) x

fun antiq_depth (st : arg) = #antiq_depth st
fun antiq_from_block (st : arg) = #antiq_from_block st
fun antiq_tag (st : arg) = #antiq_tag st
fun antiq_buf (st : arg) = #antiq_buf st
fun antiq_start (st : arg) = #antiq_start st
fun comment_depth (st : arg) = #comment_depth st
fun bodyless_ok (st : arg) = #bodyless_ok st
fun comment_start (st : arg) = #comment_start st

(* Every real token goes through one of the constructors below, which, before
   reporting the token's markup, (1) let the comments gathered since the
   previous token attach themselves to this one, and (2) tell the layout
   recorder where this token starts and stops and what kind of token it is.
   Value-carrying tokens get their true start/end span as position. *)
fun stok st kind markup (yypos, yytext, cons) =
    (#bol st := false;
     ARM_Comments.attach_pending st (gp st yypos);
     ARM_Layout.token st (yypos, yypos + String.size yytext, kind);
     tok (base st) (yypos, yytext, markup, kind, "", cons))

fun stok_val st kind markup (yypos, yytext, cons, value) =
    let
      val _ = #bol st := false
      val _ = ARM_Comments.attach_pending st (gp st yypos)
      val _ = ARM_Layout.token st (yypos, yypos + String.size yytext, kind)
      val p = gp st yypos
      val p' = gp st (yypos + String.size yytext)
      val _ = report st (yypos, String.size yytext, markup, kind, "")
    in cons (value, p, p') end



(* The words that structure the text of an assembly file - the directives that open and close the
   blocks (.macro/.endm, the conditionals, the loops) - are tokens of their own, whatever the case
   they are written in; every other word is an identifier (a mnemonic, a register, a symbol, a
   directive, a macro call: the grammar actions and the analysis tell which). *)
val if_words =
    [".if", ".ifdef", ".ifndef", ".ifb", ".ifnb", ".ifc", ".ifnc", ".ifeq", ".ifne", ".iflt",
     ".ifle", ".ifge", ".ifgt", ".ifeqs", ".ifnes"]

fun word_tok st (yypos, yytext) =
    let
      val lw = String.map Char.toLower yytext
      fun kw kind cons = stok st kind Markup.keyword1 (yypos, yytext, cons)
      fun kwv kind cons = stok_val st kind Markup.keyword1 (yypos, yytext, cons, yytext)
    in
      case lw of
        ".macro" => kw "MACRO" Tokens.MACRO
      | ".endm" => kw "ENDM" Tokens.ENDM
      | ".exitm" => kw "EXITM" Tokens.EXITM
      | ".else" => kw "ELSE" Tokens.ELSE
      | ".endif" => kw "ENDIF" Tokens.ENDIF
      | ".endr" => kw "ENDR" Tokens.ENDR
      | ".req" => kw "REQ" Tokens.REQ
      | ".elseif" => kwv "ELSEIF" Tokens.ELSEIF
      | ".rept" => kwv "REPTD" Tokens.REPTD
      | ".irp" => kwv "REPTD" Tokens.REPTD
      | ".irpc" => kwv "REPTD" Tokens.REPTD
      | _ =>
          if List.exists (fn w => w = lw) if_words then kwv "IFD" Tokens.IFD
          else if String.isPrefix "." yytext
          then stok_val st "IDENT" Markup.keyword2 (yypos, yytext, Tokens.IDENT, yytext)
          else stok_val st "IDENT" Markup.free (yypos, yytext, Tokens.IDENT, yytext)
    end

fun layout_newline st = ARM_Layout.newline st

(* The end of a line is a token of the grammar; it does not take the comments gathered so far, which
   belong to the next real token. *)
fun nl_tok st (yypos, yytext) =
    (#bol st := true;
     ARM_Layout.token st (yypos, yypos + String.size yytext, "NEWLINE");
     Tokens.NEWLINE (gp st yypos, gp st (yypos + String.size yytext)))

(* Accumulate one fragment of raw comment text, tagged with its own span. *)
fun push_raw_fragment st (yypos, yytext) =
    ARM_Comments.push_raw st
      (yytext, Position.range_position
       (gp st yypos, gp st (yypos + String.size yytext)))

fun char_to_navi #"u" = ARM_Ast.up
  | char_to_navi #"U" = ARM_Ast.Up
  | char_to_navi #"r" = ARM_Ast.right
  | char_to_navi #"d" = ARM_Ast.down
  | char_to_navi c = raise Fail ("invalid navigation character " ^ String.str c)

(* Splits the text matched after the leading "@" into the tag name, its optional
   bracketed navigation string, and its optional parenthesized level. *)
fun parse_tag_navi_level text =
    let
      val trim =
        Substring.string o Substring.dropr Char.isSpace o Substring.full
      val after_at =
        Substring.dropl (fn c => c = #"@" orelse Char.isSpace c)
          (Substring.full text)
      val (name_ss, rest1) =
        Substring.splitl (fn c => Char.isAlphaNum c orelse c = #"_") after_at
      val rest1' = Substring.dropl Char.isSpace rest1
      val (navi, rest2) =
        if Substring.size rest1' > 0 andalso Substring.sub (rest1', 0) =
          #"[" then
          let
            val (navi_ss, after) =
              Substring.splitl (fn c => c <> #"]") (Substring.triml 1 rest1')
          in (map char_to_navi (String.explode (Substring.string navi_ss)),
              Substring.triml 1 after) end
        else ([], rest1')
      val rest2' = Substring.dropl Char.isSpace rest2
      val level =
        if Substring.size rest2' > 0 andalso Substring.sub (rest2', 0) =
          #"(" then
          let val (lvl_ss, _) =
            Substring.splitl (fn c => c <> #")") (Substring.triml 1 rest2')
          in valOf (Int.fromString (Substring.string lvl_ss)) end
        else 0
    in (trim (Substring.string name_ss), navi, level) end

(* A bodyless tag is a complete antiquotation with the empty body - but only
   where the comment opener allowed it ("//@", "/*@"): elsewhere it is plain
   comment text and is dropped here. *)
fun antiq_flush_pending_tag st =
    let val (name, navi, level, pos) = !(antiq_tag st) in
      if name = "" then ()
      else
        (antiq_tag st := ("", [], 0, Position.none);
         if !(bodyless_ok st)
         then ARM_Comments.push_antiquotation
           st {tag = (name, pos)} navi {level = level} {cartouche = ("", pos)}
         else ())
    end

fun antiq_tag_seen st (yypos, yytext) =
    let
      val (name, navi, level) = parse_tag_navi_level yytext
      val _ = if yypos = !(comment_start st) then bodyless_ok st := true else ()
    in antiq_flush_pending_tag st; antiq_tag
      st := (name, navi, level, gp st yypos) end

fun antiq_body_start st yypos = antiq_start st := gp st yypos

fun antiq_body_push st text = antiq_buf st := text :: !(antiq_buf st)

fun antiq_body_finish st yypos =
    let
      val body_text = String.concat (rev (!(antiq_buf st)))
      val body_pos = Position.range_position (!(antiq_start st), gp st yypos)
      val (tag_text, navi, level, tag_pos) = !(antiq_tag st)
    in
      antiq_buf st := [];
      antiq_tag st := ("", [], 0, Position.none);
      ARM_Comments.push_antiquotation
        st {tag = (tag_text, tag_pos)} navi {level = level} {cartouche =
            (body_text, body_pos)}
    end

(* The quoted-string alternative to a cartouche body: tag, level and body in one
   rule. *)
fun antiq_tag_and_string_seen st (yypos, yytext) =
    let
      fun find_quote i = if String.sub (yytext, i) =
        #"\"" then i else find_quote (i + 1)
      val qpos = find_quote 0
      val (name, navi, level) =
        parse_tag_navi_level (String.substring (yytext, 0, qpos))
      val body_len = String.size yytext - qpos - 2
      val body_text = String.substring (yytext, qpos + 1, body_len)
      val body_start = yypos + qpos + 1
      val body_pos =
        Position.range_position
          (gp st body_start, gp st (body_start + body_len))
    in
      ARM_Comments.push_antiquotation
        st {tag = (name, gp st yypos)} navi {level = level} {cartouche =
            (body_text, body_pos)}
    end

(* The form with a quoted body is an antiquotation only directly after the comment opener
   ("//@ term \"x\""): the inline tags of ARMdoc, "{@code \"abc\"}" for instance, are text. *)
fun tag_with_body st (yypos, yytext) =
    if yypos = !(comment_start st)
    then (report st (yypos, String.size yytext, Markup.antiquote,
                     "ARM antiquotation tag+body", "");
          antiq_tag_and_string_seen st (yypos, yytext))
    else push_raw_fragment st (yypos, yytext)

fun tag_only st (yypos, yytext) =
    (antiq_tag_seen st (yypos, yytext);
     if !(bodyless_ok st)
     then report st (yypos, String.size yytext, Markup.antiquote,
                     "ARM antiquotation tag", "")
     else ())

fun cartouche_open st (yypos, yytext) block =
    (report st (yypos, String.size yytext, Markup.cartouche,
                "ARM antiquotation body", "");
     antiq_depth st := 1; antiq_from_block st := block;
     antiq_body_start st (yypos + String.size yytext))


(* A comment opens: "@", "//" and a "#" at the start of a line run to the end of the line, "/*"
   to the next "*/" (block comments do not nest). "len" is the length of the opener. *)
fun comment_open st block len yypos =
    (bodyless_ok st := false; comment_start st := yypos + len;
     comment_depth st := (if block then 1 else 0);
     antiq_from_block st := block)

(* The first lexical error is recorded (see "ARM_State"); the lexer
   carries on, and "ARM_Parse.parse" reports it when the parse is over. *)
fun lex_fail (st : arg) (msg, pos) =
    (case !(#lex_error st) of NONE =>
     #lex_error st := SOME (msg, pos) | SOME _ => ())

(* Shadows the default "eof" of the "[state]" header: an unterminated
   antiquotation is a genuine error, reported at its own start. *)
fun eof (st : arg) =
    let
      val _ =
        if !(antiq_depth st) > 0
        then (antiq_depth st := 0;
              lex_fail st ("Unterminated antiquotation body: no matching " ^
                           "closing cartouche before the end of input",
                           !(antiq_start st)))
        else antiq_flush_pending_tag st
    in
      (* the last line is ended, if it was not: the grammar wants every line to end *)
      if !(#bol st) then Tokens.EOF (Position.none, Position.none)
      else (#bol st := true; Tokens.NEWLINE (Position.none, Position.none))
    end
\<close>
lex_definitions\<open>
D=[0-9];
H=[0-9A-Fa-f];
NA=[^\000-\127];
LET=([A-Za-z_$]|{NA});
LD=([A-Za-z0-9_$.]|{NA});
REF=(\\([A-Za-z_][A-Za-z0-9_]*|@|"()"));
EXPN=[eE][+\-]?{D}+;
HWS=[\ \t];
WS=[\ \t\r\012];
NAVI=[uUrd];
ATAG={HWS}*[A-Za-z_][A-Za-z_0-9]*({HWS}*"["{NAVI}*"]")?({HWS}*"("{D}+")")?;
ATAG={ATAG};
ES=(\\(["\\abfnrtv]|x{H}{H}));
OPENCART=\\\<open>;
CLOSECART=\\\<close>;
%s COMMENT LCOMMENT ANTIQ;
\<close>
lex_rules\<open>
<INITIAL>"//"
        => (comment_open st false 2 yypos;
            YYBEGIN LCOMMENT;
            continue ());
<INITIAL>"/*"
        => (comment_open st true 2 yypos;
            YYBEGIN COMMENT;
            continue ());
<INITIAL>"@"
        => (comment_open st false 1 yypos;
            YYBEGIN LCOMMENT;
            continue ());
<INITIAL>"#"
        => (if !(#bol st)
            then (comment_open st false 1 yypos;
                  YYBEGIN LCOMMENT;
                  continue ())
            else stok st "HASH" Markup.operator (yypos, yytext, Tokens.HASH));
<INITIAL>{WS}+                      => (continue ());
<INITIAL>\n                         => (layout_newline st; nl_tok st (yypos, yytext));

<INITIAL>"("
        => (stok st "LPAREN" Markup.delimiter (yypos, yytext, Tokens.LPAREN));
<INITIAL>")"
        => (stok st "RPAREN" Markup.delimiter (yypos, yytext, Tokens.RPAREN));
<INITIAL>"["
        => (stok st "LBRACK" Markup.delimiter (yypos, yytext, Tokens.LBRACK));
<INITIAL>"]"
        => (stok st "RBRACK" Markup.delimiter (yypos, yytext, Tokens.RBRACK));
<INITIAL>"{"
        => (stok st "LBRACE" Markup.delimiter (yypos, yytext, Tokens.LBRACE));
<INITIAL>"}"
        => (stok st "RBRACE" Markup.delimiter (yypos, yytext, Tokens.RBRACE));
<INITIAL>","
        => (stok st "COMMA" Markup.delimiter (yypos, yytext, Tokens.COMMA));
<INITIAL>":"
        => (stok st "COLON" Markup.delimiter (yypos, yytext, Tokens.COLON));
<INITIAL>";"
        => (stok st "SEMI" Markup.delimiter (yypos, yytext, Tokens.SEMI));
<INITIAL>"="
        => (stok st "ASSIGN" Markup.operator (yypos, yytext, Tokens.ASSIGN));
<INITIAL>"=="
        => (stok st "EQEQ" Markup.operator (yypos, yytext, Tokens.EQEQ));
<INITIAL>("!="|"<>")
        => (stok st "NE" Markup.operator (yypos, yytext, Tokens.NE));
<INITIAL>"!"
        => (stok st "BANG" Markup.operator (yypos, yytext, Tokens.BANG));
<INITIAL>"^"
        => (stok st "CARET" Markup.operator (yypos, yytext, Tokens.CARET));
<INITIAL>"~"
        => (stok st "TILDE" Markup.operator (yypos, yytext, Tokens.TILDE));
<INITIAL>"+"
        => (stok st "PLUS" Markup.operator (yypos, yytext, Tokens.PLUS));
<INITIAL>"-"
        => (stok st "MINUS" Markup.operator (yypos, yytext, Tokens.MINUS));
<INITIAL>"*"
        => (stok st "STAR" Markup.operator (yypos, yytext, Tokens.STAR));
<INITIAL>"/"
        => (stok st "SLASH" Markup.operator (yypos, yytext, Tokens.SLASH));
<INITIAL>"%"
        => (stok st "PERCENT" Markup.operator (yypos, yytext, Tokens.PERCENT));
<INITIAL>"|"
        => (stok st "BAR" Markup.operator (yypos, yytext, Tokens.BAR));
<INITIAL>"&"
        => (stok st "AMP" Markup.operator (yypos, yytext, Tokens.AMP));
<INITIAL>"<<"
        => (stok st "SHL" Markup.operator (yypos, yytext, Tokens.SHL));
<INITIAL>">>"
        => (stok st "SHR" Markup.operator (yypos, yytext, Tokens.SHR));
<INITIAL>"<"
        => (stok st "LT" Markup.operator (yypos, yytext, Tokens.LT));
<INITIAL>">"
        => (stok st "GT" Markup.operator (yypos, yytext, Tokens.GT));
<INITIAL>"<="
        => (stok st "LE" Markup.operator (yypos, yytext, Tokens.LE));
<INITIAL>">="
        => (stok st "GE" Markup.operator (yypos, yytext, Tokens.GE));
<INITIAL>"&&"
        => (stok st "ANDAND" Markup.operator (yypos, yytext, Tokens.ANDAND));
<INITIAL>"||"
        => (stok st "OROR" Markup.operator (yypos, yytext, Tokens.OROR));
<INITIAL>"."
        => (stok st "DOT" Markup.operator (yypos, yytext, Tokens.DOT));

<INITIAL>"."{D}+({EXPN})?
        => (stok_val st "FLOAT" Markup.numeral (yypos, yytext, Tokens.FLOAT, yytext));

<INITIAL>("."[fF][iI][lL][eE]|"."[lL][oO][cC]){HWS}+([^\n;@"]|["]([^"\\\n]|"\\"[^\n])*["])*
        => (stok_val st "RAWDIR" Markup.keyword2 (yypos, yytext, Tokens.RAWDIR, yytext));
<INITIAL>({LET}|{REF})({LD}|{REF})*     => (word_tok st (yypos, yytext));
<INITIAL>"."({LD}|{REF})+               => (word_tok st (yypos, yytext));

<INITIAL>0[xX]{H}+
        => (stok_val st "NUMBER" Markup.numeral (yypos, yytext, Tokens.NUMBER, yytext));
<INITIAL>0[bB][01]+
        => (stok_val st "NUMBER" Markup.numeral (yypos, yytext, Tokens.NUMBER, yytext));
<INITIAL>{D}+
        => (stok_val st "NUMBER" Markup.numeral (yypos, yytext, Tokens.NUMBER, yytext));
<INITIAL>{D}+[bBfF]
        => (stok_val st "LOCREF" Markup.free (yypos, yytext, Tokens.LOCREF, yytext));
<INITIAL>0[fFeEdD][+\-]?{D}*"."{D}*({EXPN})?
        => (stok_val st "FLOAT" Markup.numeral (yypos, yytext, Tokens.FLOAT, yytext));
<INITIAL>{D}+"."{D}*({EXPN})?
        => (stok_val st "FLOAT" Markup.numeral (yypos, yytext, Tokens.FLOAT, yytext));

<INITIAL>"'"(\\.|[^\\\n])("'")?
        => (stok_val st "CHAR" Markup.string (yypos, yytext, Tokens.CHAR, yytext));
<INITIAL>["]([^"\\\n]|"\\"[^\n])*["]
        => (stok_val st "STRING" Markup.string (yypos, yytext, Tokens.STRING, yytext));
<INITIAL>.
        => (stok_val st "ILLEGAL" (Markup.bad ())
            (yypos, yytext, Tokens.ILLEGAL, yytext));

<LCOMMENT>[^@\\\n]+
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>"@"{ATAG}{HWS}*["]([^"\\\n]|{ES})*["]
        => (tag_with_body st (yypos, yytext);
            continue ());
<LCOMMENT>"@"{ATAG}
        => (tag_only st (yypos, yytext);
            continue ());
<LCOMMENT>"@"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>"\\"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<LCOMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) false;
            YYBEGIN ANTIQ;
            continue ());
<LCOMMENT>\n
        => (antiq_flush_pending_tag st;
            layout_newline st;
            YYBEGIN INITIAL;
            nl_tok st (yypos, yytext));

<COMMENT>[^*/@\\\n]+
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>\n
        => (push_raw_fragment st (yypos, yytext);
            layout_newline st;
            continue ());
<COMMENT>"*/"
        => (antiq_flush_pending_tag st;
            YYBEGIN INITIAL;
            continue ());
<COMMENT>"*"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"/"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}{HWS}*["]([^"\\\n]|{ES})*["]
        => (tag_with_body st (yypos, yytext);
            continue ());
<COMMENT>"@"{ATAG}
        => (tag_only st (yypos, yytext);
            continue ());
<COMMENT>"@"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"\\"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>{OPENCART}
        => (cartouche_open st (yypos, yytext) true;
            YYBEGIN ANTIQ;
            continue ());

<ANTIQ>[^\\\n]+                     => (antiq_body_push st yytext; continue ());
<ANTIQ>\n+
        => (antiq_body_push st yytext;
            List.app (fn _ => layout_newline st) (String.explode yytext);
            continue ());
<ANTIQ>"\\"                         => (antiq_body_push st yytext; continue ());
<ANTIQ>{OPENCART}
        => (antiq_depth st := !(antiq_depth st) + 1;
            antiq_body_push st yytext;
            continue ());
<ANTIQ>{CLOSECART}
        => (antiq_depth st := !(antiq_depth st) - 1;
            if !(antiq_depth st) = 0
              then (antiq_body_finish st yypos;
                    (if !(antiq_from_block st) then YYBEGIN COMMENT
                     else YYBEGIN LCOMMENT);
                    continue ())
              else (antiq_body_push st yytext; continue ()));
\<close>
and yacc_user_declarations\<open>
open ARM_Ast

type pos = Position.T

fun ndi st p = ARM_Comments.mk_nodeInfo st p p
fun ndi2 st (p1, p2) =
  ARM_Comments.mk_nodeInfo st p1 (Position.range_position (p1, p2))

(* A name token carries its true source span as its position, so the node's own range is exactly
   the name. *)
fun mkid st (s, l, r) = Ident (s, 0, ndi2 st (l, r))

(* a word in an expression: a register, or a symbol *)
fun atom_of_ident st (s, l, r) : pos expr =
  (case ARM_Isa.reg_of s of
     SOME reg => EReg (reg, s, ndi2 st (l, r))
   | NONE => ESym (mkid st (s, l, r)))

(* an operand that is just an expression: a register, "rrx", or an expression *)
fun operand_of_expr (e : pos expr) : pos operand =
  (case e of
     EReg (r, s, ni) => OReg (r, s, false, ni)
   | ESym (Ident (s, _, ni)) =>
       (case ARM_Isa.shift_of s of
          SOME Rrx => OShift (Rrx, s, NONE, ni)
        | _ => OExpr e)
   | _ => OExpr e)

(* "r0!": a register (or the alias of one) with write-back *)
fun writeback st (s, l, r, rr) : pos operand =
  let val ni = ndi2 st (l, rr)
  in (case ARM_Isa.reg_of s of
        SOME reg => OReg (reg, s, true, ni)
      | NONE => OReg (Special (String.map Char.toLower s), s, true, ni))
  end

(* "lsl #2" and "lsl r1" *)
fun shift_op st (s, l, arg : pos operand, rr) : pos operand =
  (case ARM_Isa.shift_of s of
     SOME sh => OShift (sh, s, SOME arg, ndi2 st (l, rr))
   | NONE => raise Fail ("a shift operator expected: " ^ s))

(* inside the braces of a register list "r0-r3" is a range *)
fun list_item st (o1 : pos operand) : pos operand =
  (case o1 of
     OExpr (EBinary (Sub, a, b, ni)) =>
       ORange (operand_of_expr a, operand_of_expr b, ni)
   | _ => o1)

(* the statement that begins with a word: an instruction if the word is a mnemonic, a directive if
   it begins with a dot, else a macro call *)
fun mk_stmt st (s, l, r, ops, rr) : pos stmt =
  let
    val id = mkid st (s, l, r)
    val ni = ndi2 st (l, rr)
  in
    if String.isPrefix "." s then SDir (id, ops, ni)
    else
      (case ARM_Isa.decode s of
         SOME d => SInsn (Insn (d, ops, ni))
       | NONE => SCall (id, ops, ni))
  end

(* ".file" and ".loc": the arguments are the rest of the line, as written *)
fun mk_rawdir st (text, l, r) : pos stmt =
  let
    val n = String.size text
    fun word_end i = if i < n andalso not (Char.isSpace (String.sub (text, i))) then word_end (i + 1) else i
    val e = word_end 0
    val name = String.substring (text, 0, e)
    fun skip i = if i < n andalso Char.isSpace (String.sub (text, i)) then skip (i + 1) else i
    val b = skip e
    val rest = String.extract (text, b, NONE)
    val name_end = Position.symbol_explode name l
    val rest_pos = Position.symbol_explode (String.substring (text, 0, b)) l
  in
    SDir (mkid st (name, l, name_end), [ORaw (rest, ndi2 st (rest_pos, r))], ndi2 st (l, r))
  end

fun unop_of s = (case s of "-" => Neg | "+" => Pos | "!" => Not | _ => Compl)
\<close>
yacc_definitions\<open>
%eop EOF
%arg (st) : ARM_State.T
%noshift EOF

%left ANDAND OROR
%left EQEQ NE LT GT LE GE
%left PLUS MINUS
%left BAR AMP CARET
%left STAR SLASH PERCENT SHL SHR
%nonassoc UMINUS

%term
        IDENT of string | NUMBER of string | FLOAT of string | CHAR of string | STRING of string
      | LOCREF of string | RAWDIR of string | ILLEGAL of string | IFD of string | ELSEIF of string | REPTD of string
      | MACRO | ENDM | EXITM | ELSE | ENDIF | ENDR | REQ
      | LPAREN | RPAREN | LBRACK | RBRACK | LBRACE | RBRACE | COMMA | COLON | SEMI | NEWLINE
      | HASH | ASSIGN | EQEQ | NE | BANG | CARET | TILDE | PLUS | MINUS | STAR | SLASH | PERCENT
      | BAR | AMP | SHL | SHR | LT | GT | LE | GE | ANDAND | OROR | DOT
      | UMINUS
      | ENTRY_FILE | ENTRY_STMTS | ENTRY_EXPR | ENTRY_OPERAND | ENTRY_ID | EOF

%nonterm
        start_rule of Position.T root option
      |        nls of unit
      |        lines of Position.T stmt list
      |        line of Position.T stmt list
      |        sline of Position.T stmt list
      |        sitems of Position.T stmt list
      |        labels of Position.T stmt list
      |        label of Position.T stmt
      |        stmt of Position.T stmt
      |        block of Position.T stmt
      |        cond_tail of Position.T branch list * Position.T stmt list option
      |        mparams of Position.T mparam list
      |        mparam_list of Position.T mparam list
      |        mparam of Position.T mparam
      |        operands of Position.T operand list
      |        operand of Position.T operand
      |        operand_nl of Position.T operand
      |        mem of Position.T operand list
      |        reglist of Position.T operand list
      |        expr of Position.T expr
      |        pexpr of Position.T expr
      |        atom of Position.T expr
\<close>
yacc_rules\<open>
start_rule:
        ENTRY_FILE lines
                (SOME (Source (File (rev lines, ndi2 st (ENTRY_FILEleft, linesright)))))
|       ENTRY_STMTS lines
                (SOME (Stmts (rev lines)))
|       ENTRY_EXPR nls expr nls
                (SOME (Expr expr))
|       ENTRY_OPERAND nls operand nls
                (SOME (Operand operand))
|       ENTRY_ID IDENT nls
                (SOME (Id (mkid st (IDENT, IDENTleft, IDENTright))))

nls:
        
                (())
|       nls NEWLINE
                (())

(* ---------------------------------------------------------------------------------------- *)
(* lines                                                                                      *)

lines:
        
                ([])
|       lines line
                (rev line @ lines)
|       lines block
                (block :: lines)
line:
        sline NEWLINE
                (sline)
sline:
        sitems
                (sitems)
|       sline SEMI sitems
                (sline @ sitems)
sitems:
        
                ([])
|       labels
                (labels)
|       labels stmt
                (labels @ [stmt])
|       stmt
                ([stmt])
labels:
        label
                ([label])
|       labels label
                (labels @ [label])
label:
        IDENT COLON
                (SLabel (LName (mkid st (IDENT, IDENTleft, IDENTright)),
                         ndi2 st (IDENTleft, COLONright)))
|       NUMBER COLON
                (SLabel (LNum (NUMBER, ndi2 st (NUMBERleft, NUMBERright)),
                         ndi2 st (NUMBERleft, COLONright)))

(* ---------------------------------------------------------------------------------------- *)
(* statements                                                                                 *)

stmt:
        IDENT
                (mk_stmt st (IDENT, IDENTleft, IDENTright, [], IDENTright))
|       IDENT operands
                (mk_stmt st (IDENT, IDENTleft, IDENTright, operands, operandsright))
|       IDENT ASSIGN expr
                (SAssign (mkid st (IDENT, IDENTleft, IDENTright), expr,
                          ndi2 st (IDENTleft, exprright)))
|       IDENT REQ operand_nl
                (SReq (mkid st (IDENT, IDENTleft, IDENTright), operand_nl,
                       ndi2 st (IDENTleft, operand_nlright)))
|       RAWDIR
                (mk_rawdir st (RAWDIR, RAWDIRleft, RAWDIRright))
|       EXITM
                (SExitm (ndi2 st (EXITMleft, EXITMright)))

(* ---------------------------------------------------------------------------------------- *)
(* blocks                                                                                     *)

block:
        MACRO IDENT mparams NEWLINE lines ENDM NEWLINE
                (SMacro (mkid st (IDENT, IDENTleft, IDENTright), mparams, rev lines,
                         ndi2 st (MACROleft, ENDMright)))
|       IFD operands NEWLINE lines cond_tail ENDIF NEWLINE
                (let
                   val (more, els) = cond_tail
                   val first = Branch (mkid st (IFD, IFDleft, IFDright), operands, rev lines,
                                       ndi2 st (IFDleft, operandsright))
                 in SCond (first :: more, els, ndi2 st (IFDleft, ENDIFright)) end)
|       REPTD operands NEWLINE lines ENDR NEWLINE
                (SRep (mkid st (REPTD, REPTDleft, REPTDright), operands, rev lines,
                       ndi2 st (REPTDleft, ENDRright)))
cond_tail:
        
                (([], NONE))
|       ELSEIF operands NEWLINE lines cond_tail
                (let
                   val (more, els) = cond_tail
                   val br = Branch (mkid st (ELSEIF, ELSEIFleft, ELSEIFright), operands, rev lines,
                                    ndi2 st (ELSEIFleft, operandsright))
                 in (br :: more, els) end)
|       ELSE NEWLINE lines
                (([], SOME (rev lines)))

mparams:
        
                ([])
|       mparam_list
                (mparam_list)
|       COMMA mparam_list
                (mparam_list)
mparam_list:
        mparam
                ([mparam])
|       mparam_list mparam
                (mparam_list @ [mparam])
|       mparam_list COMMA mparam
                (mparam_list @
                 [(case mparam of MParam (a, b, c, _, d) => MParam (a, b, c, true, d))])
mparam:
        IDENT
                (MParam (mkid st (IDENT, IDENTleft, IDENTright), NONE, NONE, false,
                         ndi2 st (IDENTleft, IDENTright)))
|       IDENT COLON IDENT
                (MParam (mkid st (IDENT1, IDENT1left, IDENT1right), SOME IDENT2, NONE, false,
                         ndi2 st (IDENT1left, IDENT2right)))
|       IDENT ASSIGN expr
                (MParam (mkid st (IDENT, IDENTleft, IDENTright), NONE, SOME expr, false,
                         ndi2 st (IDENTleft, exprright)))
|       IDENT COLON IDENT ASSIGN expr
                (MParam (mkid st (IDENT1, IDENT1left, IDENT1right), SOME IDENT2, SOME expr, false,
                         ndi2 st (IDENT1left, exprright)))

(* ---------------------------------------------------------------------------------------- *)
(* operands                                                                                   *)

operands:
        operand_nl
                ([operand_nl])
|       operands COMMA operand
                (operands @ [operand])
operand:
        operand_nl
                (operand_nl)
|       ASSIGN expr
                (OLiteral (expr, ndi2 st (ASSIGNleft, exprright)))
|       COLON IDENT COLON expr
                (OExpr (EPart (mkid st (IDENT, IDENTleft, IDENTright), expr,
                               ndi2 st (COLON1left, exprright))))
operand_nl:
        expr
                (operand_of_expr expr)
|       HASH pexpr
                (OImm (pexpr, ndi2 st (HASHleft, pexprright)))
|       IDENT HASH expr
                (shift_op st (IDENT, IDENTleft, OImm (expr, ndi2 st (HASHleft, exprright)),
                              exprright))
|       IDENT IDENT
                (shift_op st (IDENT1, IDENT1left,
                              operand_of_expr (atom_of_ident st (IDENT2, IDENT2left, IDENT2right)),
                              IDENT2right))
|       IDENT BANG
                (writeback st (IDENT, IDENTleft, IDENTright, BANGright))
|       LBRACK mem RBRACK
                (OMem (mem, false, ndi2 st (LBRACKleft, RBRACKright)))
|       LBRACK mem RBRACK BANG
                (OMem (mem, true, ndi2 st (LBRACKleft, BANGright)))
|       LBRACE reglist RBRACE
                (OList (reglist, false, ndi2 st (LBRACEleft, RBRACEright)))
|       LBRACE reglist RBRACE CARET
                (OList (reglist, true, ndi2 st (LBRACEleft, CARETright)))
|       IDENT ASSIGN expr
                (OKeyword (mkid st (IDENT, IDENTleft, IDENTright), expr,
                           ndi2 st (IDENTleft, exprright)))
|       IDENT LBRACK expr RBRACK
                (case ARM_Isa.reg_of IDENT of
                   SOME r => OScalar (r, IDENT, expr, ndi2 st (IDENTleft, RBRACKright))
                 | NONE => raise Fail ("a register expected before [: " ^ IDENT))
|       PERCENT IDENT
                (OPercent (mkid st (IDENT, IDENTleft, IDENTright),
                           ndi2 st (PERCENTleft, IDENTright)))
mem:
        operand_nl
                ([operand_nl])
|       mem COMMA operand_nl
                (mem @ [operand_nl])
|       operand_nl COLON NUMBER
                ([operand_nl, OAlign (NUMBER, false, ndi2 st (COLONleft, NUMBERright))])
|       mem COMMA COLON NUMBER
                (mem @ [OAlign (NUMBER, true, ndi2 st (COLONleft, NUMBERright))])
reglist:
        operand_nl
                ([list_item st operand_nl])
|       reglist COMMA operand_nl
                (reglist @ [list_item st operand_nl])

(* ---------------------------------------------------------------------------------------- *)
(* expressions                                                                                *)

pexpr:
        expr
                (expr)
|       COLON IDENT COLON expr
                (EPart (mkid st (IDENT, IDENTleft, IDENTright), expr,
                        ndi2 st (COLON1left, exprright)))
expr:
        expr PLUS expr
                (EBinary (Add, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr MINUS expr
                (EBinary (Sub, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr STAR expr
                (EBinary (Mul, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SLASH expr
                (EBinary (Div, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PERCENT expr
                (EBinary (Mod, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHL expr
                (EBinary (Shl, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHR expr
                (EBinary (Shr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr BAR expr
                (EBinary (Or, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr AMP expr
                (EBinary (And, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr CARET expr
                (EBinary (Xor, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr EQEQ expr
                (EBinary (Equal, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr NE expr
                (EBinary (NotEqual, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LT expr
                (EBinary (Less, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GT expr
                (EBinary (Greater, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LE expr
                (EBinary (LessEq, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GE expr
                (EBinary (GreaterEq, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr ANDAND expr
                (EBinary (LAnd, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr OROR expr
                (EBinary (LOr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       MINUS expr %prec UMINUS
                (EUnary (Neg, expr, ndi2 st (MINUSleft, exprright)))
|       PLUS expr %prec UMINUS
                (EUnary (Pos, expr, ndi2 st (PLUSleft, exprright)))
|       BANG expr %prec UMINUS
                (EUnary (Not, expr, ndi2 st (BANGleft, exprright)))
|       TILDE expr %prec UMINUS
                (EUnary (Compl, expr, ndi2 st (TILDEleft, exprright)))
|       LPAREN expr RPAREN
                (EParen (expr, ndi2 st (LPARENleft, RPARENright)))
|       atom
                (atom)
atom:
        NUMBER
                (ENum (NUMBER, ndi2 st (NUMBERleft, NUMBERright)))
|       FLOAT
                (EFloat (FLOAT, ndi2 st (FLOATleft, FLOATright)))
|       CHAR
                (EChar (CHAR, ndi2 st (CHARleft, CHARright)))
|       STRING
                (EString (STRING, ndi2 st (STRINGleft, STRINGright)))
|       LOCREF
                (ELocal (LOCREF, ndi2 st (LOCREFleft, LOCREFright)))
|       DOT
                (EDot (ndi2 st (DOTleft, DOTright)))
|       IDENT
                (atom_of_ident st (IDENT, IDENTleft, IDENTright))
|       IDENT LPAREN IDENT RPAREN
                (EReloc (atom_of_ident st (IDENT1, IDENT1left, IDENT1right),
                         mkid st (IDENT2, IDENT2left, IDENT2right),
                         ndi2 st (IDENT1left, RPARENright)))
\<close>
ML\<open>
structure ARM_Parse = struct

structure P = ARM.ARMParser
structure T = ARM.ARMLrVals.Tokens

datatype entry = Entry_File | Entry_Stmts | Entry_Expr | Entry_Operand | Entry_Id

fun entry_token Entry_File p = T.ENTRY_FILE (p, p)
  | entry_token Entry_Stmts p = T.ENTRY_STMTS (p, p)
  | entry_token Entry_Expr p = T.ENTRY_EXPR (p, p)
  | entry_token Entry_Operand p = T.ENTRY_OPERAND (p, p)
  | entry_token Entry_Id p = T.ENTRY_ID (p, p)

(* The stream the parser reads: the token of the entry point, then the tokens of the lexer. *)
fun arm_stream entry raw_lex pos =
  let
    val started = Unsynchronized.ref false
    fun next () =
      if !started then raw_lex () else (started := true; entry_token entry (pos 0))
  in P.Stream.streamify next end

(* Runs the parser on "source" from the given entry point; "mk_err" makes the parser's error
   callback from the parse's state. Every parse creates its own state. *)
fun parse mk_err entry ctxt source =
  let
    val st = ARM_State.init ctxt source
    val err = mk_err st
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then "" else (consumed := true; input_text)
    val raw_lex = ARM.ARMLex.makeLexer input_string st
    val pos = Lex_yacc_state.get_pos (#base st)
    val stream = arm_stream entry raw_lex pos
    val (result, _) = P.parse (0, stream, err, st)
      handle Fail msg => (err (msg, pos 0, pos 0); raise Fail msg)
    val _ = (case !(#lex_error st) of SOME (msg, p) => err (msg, p, p) | NONE => ())
  in result end

fun parse_loud entry ctxt source =
  parse (fn st => Lex_yacc_state.print_error (#base st)) entry ctxt source

(* The silent variant the "_reject" commands use: a locally declared exception, not the
   library's "print_error" (which reports PIDE error markup before raising, and raises an
   exception Isabelle/ML cannot reliably catch by identity across the SML sandbox boundary). *)
exception Rejected of string
fun quiet_error (s : string, _ : Position.T, _ : Position.T) = raise Rejected s

fun parse_quiet entry ctxt source = parse (K quiet_error) entry ctxt source

(* The texts of the tokens of a source, as the lexer cuts them (no comments, no blanks): what
   the printed form of a parse must have in common with its source. The ends of the lines are
   tokens of the grammar, and are among them (as "\n"). *)
fun lex_texts ctxt source =
  let
    val st = ARM_State.init ctxt source
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then "" else (consumed := true; input_text)
    val raw_lex = ARM.ARMLex.makeLexer input_string st
    val eof_tok = T.EOF (Position.none, Position.none)
    fun loop acc =
      let val tok = raw_lex ()
      in
        if P.sameToken (tok, eof_tok) then rev acc
        else
          let val lay = ARM_Layout.get st
          in loop (String.substring (input_text, #start lay, #stop lay - #start lay) :: acc) end
      end
  in loop [] end

end
