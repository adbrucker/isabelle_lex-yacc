chapter AFP

(* The Isabelle/Java manual, a sub-session of "Java25" (../ROOT): it imports the global theory "Java"
   and runs its live examples against the real commands.

   Generate the PDF with

     isabelle build -d Java25 Java_Manual

   which writes "manual/output/document.pdf" ("output" is git-ignored). The LaTeX sources are in
   "document/": "root.tex" (the same style as the C11, occam 2 and Go manuals, uses the
   lualatex/fontspec setup of Isabelle's own document build) and "root.bib" (copied from the Go
   manual, plus the Java Language Specification and the OpenJDK sources). *)
session "Java_Manual" (AFP) = "Java25" +
  options [timeout = 1200, document = pdf, document_output = "output"]
  theories
    Java_Manual
  document_files
    "root.tex"
    "root.bib"
