chapter AFP

(* The Isabelle/MicroRust manual, a sub-session of "MicroRust" (../ROOT): it imports the global
   theory "MicroRust" and runs its live examples against the real commands.

   Generate the PDF with

     isabelle build -d MicroRust MicroRust_Manual

   which writes "manual/output/document.pdf" ("output" is git-ignored). The LaTeX sources are in
   "document/": "root.tex" (the same style as the C11 and occam 2 manuals, uses the lualatex/fontspec
   setup of Isabelle's own document build) and "root.bib" (copied from the occam 2 manual, plus
   AutoCorrode, the Rust Reference and rust-analyzer). *)
session "MicroRust_Manual" (AFP) = "MicroRust" +
  options [timeout = 1200, document = pdf, document_output = "output"]
  theories
    MicroRust_Manual
  document_files
    "root.tex"
    "root.bib"
