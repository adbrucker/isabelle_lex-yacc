      |        block of Position.T rBlock
      |        blk_open of unit
      |        body of Position.T rStmt list * Position.T rExpr option
      |        stmts of Position.T rStmt list
      |        stmt of Position.T rStmt
      |        stmt_rest of (Position.T * Position.T rAttr) list
          -> Position.T rStmt
      |        elist of Position.T rExpr list
      |        args of Position.T rExpr list
      |        sitems of Position.T sitem list
      |        sitem of Position.T sitem
      |        lead_stmt of Position.T rStmt
      |        cond of Position.T rCond
      |        arms of Position.T rArm list
      |        arms_c of Position.T rArm list
      |        arm_last of Position.T rArm
      |        arm of Position.T rArm
      |        opt_guard of Position.T rExpr option
      |        cparams of Position.T rClosureParam list
      |        cparam of Position.T rClosureParam
      |        pat of Position.T rPat
      |        pat_na of Position.T rPat
      |        pat_lo of Position.T rPat
      |        pat_hi of Position.T rPat
      |        pats of Position.T rPat list
      |        fpitems of Position.T fpitem list
      |        fpitem of Position.T fpitem
      |        item of Position.T rItem
      |        items of Position.T rItem list
      |        item_rest of (Position.T * Position.T rAttr) list
          -> Position.T rItem
      |        item_core of Position.T rItemKind
      |        vis of Position.T rVis
      |        fn_head of string list
      |        fparams of Position.T rFnParam list
      |        fplist of Position.T rFnParam list
      |        fparam of Position.T rFnParam
      |        opt_ret of Position.T rType option
      |        fn_body of Position.T rBlock option
      |        gparams of Position.T rGParam list
      |        gplist of Position.T rGParam list
      |        gp of Position.T rGParam
      |        wh of Position.T rWhere list
      |        wlist of Position.T rWhere list
      |        wpred of Position.T rWhere
      |        fields_named of Position.T rFieldDef list
      |        fields_tuple of Position.T rFieldDef list
      |        fielddef of Position.T rFieldDef
      |        tfield of Position.T rFieldDef
      |        variants of Position.T rVariant list
      |        variant of Position.T rVariant
      |        opt_init of Position.T rExpr option
      |        opt_supers of Position.T rBound list
      |        opt_eq_ty of Position.T rType option
      |        use_tree of Position.T rUse
      |        use_path of Position.T ident list
      |        use_list of Position.T rUse list
\<close>
yacc_rules\<open>
start_rule:
        ENTRY_CRATE items
        (SOME (Crate items))
|       ENTRY_EXPR expr
        (SOME (Expr expr))
|       ENTRY_TYPE ty
        (SOME (Type ty))
|       ENTRY_ID name
        (SOME (Id name))
|       ENTRY_BODY body
        (SOME (Body
               (mk_block st
                (#1 body, #2 body, ENTRY_BODYleft, ENTRY_BODYright))))
|       ENTRY_PAT pat
        (SOME (Pat pat))
name:
        IDENT
        (mkid st (IDENT, IDENTleft, IDENTright))
seg_id:
        IDENT
        (mkid st (IDENT, IDENTleft, IDENTright))
|       SELFV
        (mkid st ("self", SELFVleft, SELFVright))
|       SELFT
        (mkid st ("Self", SELFTleft, SELFTright))
|       SUPER
        (mkid st ("super", SUPERleft, SUPERright))
|       CRATE
        (mkid st ("crate", CRATEleft, CRATEright))
attrs:
        
        ([])
|       attrs ATTR
        (attrs @ [(ATTRleft,
                   Attr (false, ATTR, ndi2 st (ATTRleft, ATTRright)))])
|       attrs ATTRI
        (attrs @ [(ATTRIleft,
                   Attr (true, ATTRI, ndi2 st (ATTRIleft, ATTRIright)))])
lit:
        INT_LIT
        (LInt (INT_LIT, ndi2 st (INT_LITleft, INT_LITright)))
|       FLOAT_LIT
        (LFloat (FLOAT_LIT, ndi2 st (FLOAT_LITleft, FLOAT_LITright)))
|       CHAR_LIT
        (LChar (CHAR_LIT, ndi2 st (CHAR_LITleft, CHAR_LITright)))
|       STR_LIT
        (LStr (STR_LIT, ndi2 st (STR_LITleft, STR_LITright)))
|       TRUE
        (LBool (true, ndi2 st (TRUEleft, TRUEright)))
|       FALSE
        (LBool (false, ndi2 st (FALSEleft, FALSEright)))
gclose:
        GT
        (())
|       GTJ
        (())
qpath:
        LT ty AS path_t gclose COLONCOLON seg_id
        (mkpath st
         (SOME (ty, SOME path_t), false, [mkseg seg_id NONE], LTleft,
          seg_idright))
|       LT ty gclose COLONCOLON seg_id
        (mkpath st
         (SOME (ty, NONE), false, [mkseg seg_id NONE], LTleft, seg_idright))
path_e:
        seg_id
        (path1 st (seg_id, seg_idleft, seg_idright))
|       COLONCOLON seg_id
        (mkpath st
         (NONE, true, [mkseg seg_id NONE], COLONCOLONleft, seg_idright))
|       qpath
        (qpath)
|       path_e COLONCOLON seg_id
        (extend_path st (path_e, mkseg seg_id NONE, path_eleft, seg_idright))
|       path_e COLONCOLON LT gargs_c gclose
        (add_gargs st (path_e, GArgs (true, gargs_c), path_eleft, gcloseright))
path_t:
        seg_t
        (mkpath st (NONE, false, [seg_t], seg_tleft, seg_tright))
|       COLONCOLON seg_t
        (mkpath st (NONE, true, [seg_t], COLONCOLONleft, seg_tright))
|       qpath
        (qpath)
|       path_t COLONCOLON seg_t
        (extend_path st (path_t, seg_t, path_tleft, seg_tright))
seg_t:
        seg_id
        (mkseg seg_id NONE)
|       seg_id LT gargs_c gclose
        (Seg (seg_id, SOME (GArgs (false, gargs_c)),
              ndi2 st (seg_idleft, gcloseright)))
gargs:
        garg
        ([garg])
|       gargs COMMA garg
        (gargs @ [garg])
gargs_c:
        gargs
        (gargs)
|       gargs COMMA
        (gargs)
garg:
        ty
        (GType ty)
|       LIFETIME
        (GLifetime (LIFETIME, ndi2 st (LIFETIMEleft, LIFETIMEright)))
|       IDENT EQ ty
        (GBind (mkid st (IDENT, IDENTleft, IDENTright), ty))
|       lit
        (GConst (ELit lit))
|       MINUS lit
        (GConst (EUnary (Neg, ELit lit, ndi2 st (MINUSleft, litright))))
|       LBRACE expr RBRACE
        (GConst expr)
ty:
        path_t
        (TPath path_t)
|       AMP ty
        (TRef (NONE, false, ty, ndi2 st (AMPleft, tyright)))
|       AMP MUT ty
        (TRef (NONE, true, ty, ndi2 st (AMPleft, tyright)))
|       AMP LIFETIME ty
        (TRef (SOME LIFETIME, false, ty, ndi2 st (AMPleft, tyright)))
|       AMP LIFETIME MUT ty
        (TRef (SOME LIFETIME, true, ty, ndi2 st (AMPleft, tyright)))
|       AMPAMP ty
        (TRef (NONE, false,
               TRef (NONE, false, ty, ndi2 st (AMPAMPleft, tyright)),
                 ndi2 st (AMPAMPleft, tyright)))
|       AMPAMP MUT ty
        (TRef (NONE, false,
               TRef (NONE, true, ty, ndi2 st (AMPAMPleft, tyright)),
                 ndi2 st (AMPAMPleft, tyright)))
|       STAR CONST ty
        (TPtr (false, ty, ndi2 st (STARleft, tyright)))
|       STAR MUT ty
        (TPtr (true, ty, ndi2 st (STARleft, tyright)))
|       LPAREN RPAREN
        (TTuple ([], ndi2 st (LPARENleft, RPARENright)))
|       LPAREN ty RPAREN
        (ty)
|       LPAREN ty COMMA RPAREN
        (TTuple ([ty], ndi2 st (LPARENleft, RPARENright)))
|       LPAREN ty COMMA tys_c RPAREN
        (TTuple (ty :: tys_c, ndi2 st (LPARENleft, RPARENright)))
|       LBRACKET ty RBRACKET
        (TSlice (ty, ndi2 st (LBRACKETleft, RBRACKETright)))
|       LBRACKET ty SEMI expr RBRACKET
        (TArray (ty, expr, ndi2 st (LBRACKETleft, RBRACKETright)))
|       UNDERSCORE
        (TInfer (ndi2 st (UNDERSCOREleft, UNDERSCOREright)))
|       BANG
        (TNever (ndi2 st (BANGleft, BANGright)))
|       FN LPAREN RPAREN
        (TFn ([], NONE, ndi2 st (FNleft, RPARENright)))
|       FN LPAREN tys_c RPAREN
        (TFn (tys_c, NONE, ndi2 st (FNleft, RPARENright)))
|       FN LPAREN RPAREN ARROW ty
        (TFn ([], SOME ty, ndi2 st (FNleft, tyright)))
|       FN LPAREN tys_c RPAREN ARROW ty
        (TFn (tys_c, SOME ty, ndi2 st (FNleft, tyright)))
|       IMPL bounds
        (TImpl (bounds, ndi2 st (IMPLleft, boundsright)))
|       DYN bounds
        (TDyn (bounds, ndi2 st (DYNleft, boundsright)))
|       HOL
        (THol (#1 HOL, #2 HOL, ndi2 st (HOLleft, HOLright)))
tys:
        ty
        ([ty])
|       tys COMMA ty
        (tys @ [ty])
tys_c:
        tys
        (tys)
|       tys COMMA
        (tys)
bounds:
        bound
        ([bound])
|       bounds PLUS bound
        (bounds @ [bound])
bound:
        path_t
        (BTrait (false, path_t, nodeInfo_of_path path_t))
|       QMARK path_t
        (BTrait (true, path_t, ndi2 st (QMARKleft, path_tright)))
|       LIFETIME
        (BLifetime (LIFETIME, ndi2 st (LIFETIMEleft, LIFETIMEright)))
lifetimes:
        LIFETIME
        ([LIFETIME])
|       lifetimes PLUS LIFETIME
        (lifetimes @ [LIFETIME])
blk_open:
        LBRACE
        (())
|       BLOCKLB
        (())
|       STRUCTLB
        (())
block:
        blk_open body RBRACE
        (mk_block st (#1 body, #2 body, blk_openleft, RBRACEright))
body:
        stmts
        ((stmts, NONE))
|       stmts attrs expr
        ((stmts, SOME (wrap_attrs st attrs expr (exprleft, exprright))))
stmts:
        
        ([])
|       stmts stmt
        (stmts @ [stmt])
stmt:
        attrs stmt_rest
        (stmt_rest attrs)
stmt_rest:
        item_rest
        (fn attrs => SItem (item_rest attrs))
|       SEMI
        (fn attrs => SEmpty (ndi_a st attrs (SEMIleft, SEMIright)))
|       blk_expr
        (fn attrs =>
         SExpr (wrap_attrs st attrs blk_expr (blk_exprleft, blk_exprright),
                false,
                            ndi_a st attrs (blk_exprleft, blk_exprright)))
|       LET pat SEMI
        (fn attrs =>
         SLet (false, pat, NONE, NONE, NONE,
               ndi_a st attrs (LETleft, SEMIright)))
|       LET pat COLON ty SEMI
        (fn attrs =>
         SLet (false, pat, SOME ty, NONE, NONE,
               ndi_a st attrs (LETleft, SEMIright)))
|       LET pat EQ expr SEMI
        (fn attrs =>
         SLet (false, pat, NONE, SOME expr, NONE,
               ndi_a st attrs (LETleft, SEMIright)))
|       LET pat COLON ty EQ expr SEMI
        (fn attrs =>
         SLet (false, pat, SOME ty, SOME expr, NONE,
               ndi_a st attrs (LETleft, SEMIright)))
|       LET pat EQ expr ELSE block SEMI
        (fn attrs =>
         SLet (false, pat, NONE, SOME expr, SOME block,
               ndi_a st attrs (LETleft, SEMIright)))
|       LET pat COLON ty EQ expr ELSE block SEMI
        (fn attrs =>
         SLet (false, pat, SOME ty, SOME expr, SOME block,
               ndi_a st attrs (LETleft, SEMIright)))
|       CONST pat EQ expr SEMI
        (fn attrs =>
         SLet (true, pat, NONE, SOME expr, NONE,
               ndi_a st attrs (CONSTleft, SEMIright)))
|       expr SEMI
        (fn attrs =>
         SExpr (wrap_attrs st attrs expr (exprleft, exprright), true,
                            ndi_a st attrs (exprleft, SEMIright)))
arm:
        attrs pat opt_guard FATARROW expr COMMA
        (Arm (strip_attrs attrs, pat, opt_guard, expr,
              ndi_a st attrs (patleft, COMMAright)))
|       attrs pat opt_guard FATARROW blk_expr
        (Arm (strip_attrs attrs, pat, opt_guard, blk_expr,
              ndi_a st attrs (patleft, blk_exprright)))
|       attrs pat opt_guard FATARROW blk_expr COMMA
        (Arm (strip_attrs attrs, pat, opt_guard, blk_expr,
              ndi_a st attrs (patleft, COMMAright)))
arm_last:
        attrs pat opt_guard FATARROW expr
        (Arm (strip_attrs attrs, pat, opt_guard, expr,
              ndi_a st attrs (patleft, exprright)))
arms_c:
        arm
        ([arm])
|       arms_c arm
        (arms_c @ [arm])
arms:
        
        ([])
|       arms_c
        (arms_c)
|       arm_last
        ([arm_last])
|       arms_c arm_last
        (arms_c @ [arm_last])
opt_guard:
        
        (NONE)
|       IF expr
        (SOME expr)
lead_stmt:
        expr SEMI
        (SExpr (expr, true, ndi2 st (exprleft, SEMIright)))
|       LET pat SEMI
        (SLet (false, pat, NONE, NONE, NONE, ndi2 st (LETleft, SEMIright)))
|       LET pat COLON ty SEMI
        (SLet (false, pat, SOME ty, NONE, NONE, ndi2 st (LETleft, SEMIright)))
|       LET pat EQ expr SEMI
        (SLet (false, pat, NONE, SOME expr, NONE, ndi2 st (LETleft, SEMIright)))
|       LET pat COLON ty EQ expr SEMI
        (SLet (false, pat, SOME ty, SOME expr, NONE,
               ndi2 st (LETleft, SEMIright)))
cond:
        expr
        (CExpr expr)
|       LET pat EQ expr
        (CLet (pat, expr, ndi2 st (LETleft, exprright)))
elist:
        expr
        ([expr])
|       expr COMMA
        ([expr])
|       expr COMMA elist
        (expr :: elist)
args:
        
        ([])
|       elist
        (elist)
sitems:
        
        ([])
|       sitem
        ([sitem])
|       sitem COMMA sitems
        (sitem :: sitems)
sitem:
        name COLON expr
        (SIField (FieldInit (name, SOME expr, ndi2 st (nameleft, exprright))))
|       name
        (SIField (FieldInit (name, NONE, nodeInfo_of_ident name)))
|       DOTDOT expr
        (SIBase expr)
cparams:
        
        ([])
|       cparam
        ([cparam])
|       cparam COMMA cparams
        (cparam :: cparams)
cparam:
        pat_na
        (CParam (pat_na, NONE, nodeInfo_of_pat pat_na))
|       pat_na COLON ty
        (CParam (pat_na, SOME ty, ndi2 st (pat_naleft, tyright)))
blk_expr:
        LBRACE body RBRACE
        (EBlock (NONE, mk_block st (#1 body, #2 body, LBRACEleft, RBRACEright),
                 ndi2 st (LBRACEleft, RBRACEright)))
|       UNSAFE blk_open body RBRACE
        (EUnsafe (mk_block st (#1 body, #2 body, blk_openleft, RBRACEright),
                  ndi2 st (UNSAFEleft, RBRACEright)))
|       LIFETIME COLON LBRACE body RBRACE
        (EBlock (SOME LIFETIME,
                 mk_block st (#1 body, #2 body, LBRACEleft, RBRACEright),
                   ndi2 st (LIFETIMEleft, RBRACEright)))
|       if_expr
        (if_expr)
|       MATCH expr blk_open arms RBRACE
        (EMatch (expr, arms, ndi2 st (MATCHleft, RBRACEright)))
|       WHILE cond block
        (EWhile (NONE, cond, block, ndi2 st (WHILEleft, blockright)))
|       LIFETIME COLON WHILE cond block
        (EWhile (SOME LIFETIME, cond, block,
                 ndi2 st (LIFETIMEleft, blockright)))
|       LOOP block
        (ELoop (NONE, block, ndi2 st (LOOPleft, blockright)))
|       LIFETIME COLON LOOP block
        (ELoop (SOME LIFETIME, block, ndi2 st (LIFETIMEleft, blockright)))
|       FOR pat IN expr block
        (EFor (NONE, pat, expr, block, ndi2 st (FORleft, blockright)))
|       LIFETIME COLON FOR pat IN expr block
        (EFor (SOME LIFETIME, pat, expr, block,
               ndi2 st (LIFETIMEleft, blockright)))
if_expr:
        IF cond block %prec LOWIF
        (EIf (cond, block, NONE, ndi2 st (IFleft, blockright)))
|       IF cond block ELSE block
        (EIf (cond, block1,
              SOME (EBlock (NONE, block2, nodeInfo_of_block block2)),
                ndi2 st (IFleft, block2right)))
|       IF cond block ELSE if_expr
        (EIf (cond, block, SOME if_expr, ndi2 st (IFleft, if_exprright)))
expr:
        lit
        (ELit lit)
|       path_e
        (EPath path_e)
|       path_e STRUCTLB sitems RBRACE
        (let val (fs, base) = split_sitems sitems
         in EStruct (path_e, fs, base, ndi2 st (path_eleft, RBRACEright)) end)
|       path_e HOL HOL
        (if is_log path_e
         then ELog (EHol (#1 HOL1, #2 HOL1, ndi2 st (HOL1left, HOL1right)),
                    EHol (#1 HOL2, #2 HOL2, ndi2 st (HOL2left, HOL2right)),
                    ndi2 st (path_eleft, HOL2right))
         else raise Fail
           "a path followed by two HOL escapes is not an expression")
|       path_e BANG LPAREN args RPAREN
        (EMacro (path_e, "(", args, ndi2 st (path_eleft, RPARENright)))
|       path_e BANG LPAREN lead_stmt body RPAREN
        (EMacro (path_e, "(",
                 [ESeq (mk_block st
                        (lead_stmt
                         :: #1 body, #2 body, LPARENleft, RPARENright),
                                     ndi2 st (LPARENleft, RPARENright))],
                 ndi2 st (path_eleft, RPARENright)))
|       path_e BANG LBRACKET args RBRACKET
        (EMacro (path_e, "[", args, ndi2 st (path_eleft, RBRACKETright)))
|       path_e BANG LBRACKET expr SEMI expr RBRACKET
        (EMacroRepeat
         (path_e, expr1, expr2, ndi2 st (path_eleft, RBRACKETright)))
|       MATCHESBANG LPAREN expr COMMA pat RPAREN
        (EMatches (expr, pat, ndi2 st (MATCHESBANGleft, RPARENright)))
|       MATCHESBANG LPAREN expr COMMA pat COMMA RPAREN
        (EMatches (expr, pat, ndi2 st (MATCHESBANGleft, RPARENright)))
|       HOL
        (EHol (#1 HOL, #2 HOL, ndi2 st (HOLleft, HOLright)))
|       LHOL
        (ELogLit (#1 LHOL, #2 LHOL, ndi2 st (LHOLleft, LHOLright)))
|       EPS
        (EEps (EPS, ndi2 st (EPSleft, EPSright)))
|       LPAREN lead_stmt body RPAREN
        (ESeq (mk_block st
               (lead_stmt :: #1 body, #2 body, LPARENleft, RPARENright),
               ndi2 st (LPARENleft, RPARENright)))
|       LPAREN RPAREN
        (ETuple ([], ndi2 st (LPARENleft, RPARENright)))
|       LPAREN expr RPAREN
        (EParen (expr, ndi2 st (LPARENleft, RPARENright)))
|       LPAREN expr COMMA RPAREN
        (ETuple ([expr], ndi2 st (LPARENleft, RPARENright)))
|       LPAREN expr COMMA elist RPAREN
        (ETuple (expr :: elist, ndi2 st (LPARENleft, RPARENright)))
|       LBRACKET RBRACKET
        (EArray ([], ndi2 st (LBRACKETleft, RBRACKETright)))
|       LBRACKET elist RBRACKET
        (EArray (elist, ndi2 st (LBRACKETleft, RBRACKETright)))
|       LBRACKET expr SEMI expr RBRACKET
        (ERepeat (expr1, expr2, ndi2 st (LBRACKETleft, RBRACKETright)))
|       blk_expr
        (blk_expr)
|       expr PLUS expr
        (EBinary (Add, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr MINUS expr
        (EBinary (Sub, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr STAR expr
        (EBinary (Mul, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SLASH expr
        (EBinary (Div, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PERCENT expr
        (EBinary (Rem, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr CARET expr
        (EBinary (BitXor, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr AMP expr
        (EBinary (BitAnd, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr BAR expr
        (EBinary (BitOr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHL expr
        (EBinary (Shl, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GTJ GT expr %prec SHRP
        (EBinary (Shr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr AMPAMP expr
        (EBinary (And, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr OROR expr
        (EBinary (Or, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr EQEQ expr
        (EBinary (Eq, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr NE expr
        (EBinary (Ne, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LT expr
        (EBinary (Lt, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr LE expr
        (EBinary (Le, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GT expr
        (EBinary (Gt, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GTJ EQ expr %prec GEP
        (EBinary (Ge, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr EQ expr
        (EAssign (NONE, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PLUSEQ expr
        (EAssign (SOME Add, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr MINUSEQ expr
        (EAssign (SOME Sub, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr STAREQ expr
        (EAssign (SOME Mul, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SLASHEQ expr
        (EAssign (SOME Div, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr PERCENTEQ expr
        (EAssign (SOME Rem, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr CARETEQ expr
        (EAssign (SOME BitXor, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr AMPEQ expr
        (EAssign (SOME BitAnd, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr BAREQ expr
        (EAssign (SOME BitOr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr SHLEQ expr
        (EAssign (SOME Shl, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       expr GTJ GTJ EQ expr %prec SHREQP
        (EAssign (SOME Shr, expr1, expr2, ndi2 st (expr1left, expr2right)))
|       MINUS expr %prec UNARY
        (EUnary (Neg, expr, ndi2 st (MINUSleft, exprright)))
|       BANG expr %prec UNARY
        (EUnary (Not, expr, ndi2 st (BANGleft, exprright)))
|       STAR expr %prec UNARY
        (EUnary (Deref, expr, ndi2 st (STARleft, exprright)))
|       AMP expr %prec UNARY
        (EUnary (Borrow, expr, ndi2 st (AMPleft, exprright)))
|       AMP MUT expr %prec UNARY
        (EUnary (BorrowMut, expr, ndi2 st (AMPleft, exprright)))
|       AMPAMP expr %prec UNARY
        (EUnary (BorrowBorrow, expr, ndi2 st (AMPAMPleft, exprright)))
|       AMPAMP MUT expr %prec UNARY
        (EUnary (BorrowBorrowMut, expr, ndi2 st (AMPAMPleft, exprright)))
|       expr AS ty
        (ECast (expr, ty, ndi2 st (exprleft, tyright)))
|       expr QMARK
        (ETry (expr, ndi2 st (exprleft, QMARKright)))
|       expr DOT IDENT %prec DOT
        (EField (expr, mkid st (IDENT, IDENTleft, IDENTright),
                 ndi2 st (exprleft, IDENTright)))
|       expr DOT INT_LIT %prec DOT
        (ETupIdx (expr, INT_LIT, ndi2 st (exprleft, INT_LITright)))
|       expr DOT FLOAT_LIT %prec DOT
        (tup_index st (expr, FLOAT_LIT, exprleft, FLOAT_LITright))
|       expr DOT IDENT LPAREN args RPAREN
        (EMethod (expr, mkid st (IDENT, IDENTleft, IDENTright), NONE, args,
                  ndi2 st (exprleft, RPARENright)))
|       expr DOT IDENT COLONCOLON LT gargs_c gclose LPAREN args RPAREN
        (EMethod (expr, mkid st (IDENT, IDENTleft, IDENTright),
                  SOME (GArgs (true, gargs_c)), args,
                    ndi2 st (exprleft, RPARENright)))
|       expr LPAREN args RPAREN
        (ECall (expr, args, ndi2 st (exprleft, RPARENright)))
|       expr LBRACKET expr RBRACKET
        (EIndex (expr1, expr2, ndi2 st (expr1left, RBRACKETright)))
|       expr DOTDOT expr
        (ERange (SOME expr1, SOME expr2, false,
                 ndi2 st (expr1left, expr2right)))
|       expr DOTDOT %prec DOTDOT
        (ERange (SOME expr, NONE, false, ndi2 st (exprleft, DOTDOTright)))
|       DOTDOT expr %prec DOTDOT
        (ERange (NONE, SOME expr, false, ndi2 st (DOTDOTleft, exprright)))
|       DOTDOT %prec DOTDOT
        (ERange (NONE, NONE, false, ndi2 st (DOTDOTleft, DOTDOTright)))
|       expr DOTDOTEQ expr
        (ERange (SOME expr1, SOME expr2, true, ndi2 st (expr1left, expr2right)))
|       DOTDOTEQ expr %prec DOTDOT
        (ERange (NONE, SOME expr, true, ndi2 st (DOTDOTEQleft, exprright)))
|       BAR cparams BAR expr %prec LOWER
        (EClosure (false, cparams, NONE, expr, ndi2 st (BAR1left, exprright)))
|       OROR expr %prec LOWER
        (EClosure (false, [], NONE, expr, ndi2 st (OROR1left, exprright)))
|       MOVE BAR cparams BAR expr %prec LOWER
        (EClosure (true, cparams, NONE, expr, ndi2 st (MOVEleft, exprright)))
|       MOVE OROR expr %prec LOWER
        (EClosure (true, [], NONE, expr, ndi2 st (MOVEleft, exprright)))
|       BAR cparams BAR ARROW ty block
        (EClosure
         (false, cparams, SOME ty,
          EBlock (NONE, block, nodeInfo_of_block block),
            ndi2 st (BAR1left, blockright)))
|       OROR ARROW ty block
        (EClosure
         (false, [], SOME ty, EBlock (NONE, block, nodeInfo_of_block block),
          ndi2 st (OROR1left, blockright)))
|       MOVE BAR cparams BAR ARROW ty block
        (EClosure
         (true, cparams, SOME ty,
          EBlock (NONE, block, nodeInfo_of_block block),
            ndi2 st (MOVEleft, blockright)))
|       MOVE OROR ARROW ty block
        (EClosure
         (true, [], SOME ty, EBlock (NONE, block, nodeInfo_of_block block),
          ndi2 st (MOVEleft, blockright)))
|       RETURN %prec LOWER
        (EReturn (NONE, ndi2 st (RETURNleft, RETURNright)))
|       RETURN expr %prec LOWER
        (EReturn (SOME expr, ndi2 st (RETURNleft, exprright)))
|       BREAK %prec LOWER
        (EBreak (NONE, NONE, ndi2 st (BREAKleft, BREAKright)))
|       BREAK LIFETIME %prec LOWER
        (EBreak (SOME LIFETIME, NONE, ndi2 st (BREAKleft, LIFETIMEright)))
|       BREAK expr %prec LOWER
        (EBreak (NONE, SOME expr, ndi2 st (BREAKleft, exprright)))
|       BREAK LIFETIME expr %prec LOWER
        (EBreak (SOME LIFETIME, SOME expr, ndi2 st (BREAKleft, exprright)))
|       CONTINUE
        (EContinue (NONE, ndi2 st (CONTINUEleft, CONTINUEright)))
|       CONTINUE LIFETIME
        (EContinue (SOME LIFETIME, ndi2 st (CONTINUEleft, LIFETIMEright)))
|       YIELD
        (EYield (ndi2 st (YIELDleft, YIELDright)))
pat:
        pat_na
        (pat_na)
|       pat BAR pat_na
        (case pat of
           PAlt (ps, _) => PAlt (ps @ [pat_na], ndi2 st (patleft, pat_naright))
         | _ => PAlt ([pat, pat_na], ndi2 st (patleft, pat_naright)))
pat_lo:
        lit
        (PLit (false, lit, nodeInfo_of_lit lit))
|       MINUS lit
        (PLit (true, lit, ndi2 st (MINUSleft, litright)))
|       path_e
        (PPath path_e)
pat_hi:
        lit
        (PLit (false, lit, nodeInfo_of_lit lit))
|       MINUS lit
        (PLit (true, lit, ndi2 st (MINUSleft, litright)))
|       path_e
        (PPath path_e)
pat_na:
        UNDERSCORE
        (PWild (ndi2 st (UNDERSCOREleft, UNDERSCOREright)))
|       DOTDOT
        (PRest (ndi2 st (DOTDOTleft, DOTDOTright)))
|       path_e
        (pat_of_path path_e)
|       IDENT AT pat_na
        (PIdent (false, false, mkid st (IDENT, IDENTleft, IDENTright),
                 SOME pat_na, ndi2 st (IDENTleft, pat_naright)))
|       MUT name
        (PIdent (false, true, name, NONE, ndi2 st (MUTleft, nameright)))
|       MUT name AT pat_na
        (PIdent (false, true, name, SOME pat_na,
                 ndi2 st (MUTleft, pat_naright)))
|       lit
        (PLit (false, lit, nodeInfo_of_lit lit))
|       MINUS lit
        (PLit (true, lit, ndi2 st (MINUSleft, litright)))
|       pat_lo DOTDOTEQ pat_hi
        (PRange (SOME pat_lo, SOME pat_hi, true,
                 ndi2 st (pat_loleft, pat_hiright)))
|       pat_lo DOTDOT pat_hi
        (PRange (SOME pat_lo, SOME pat_hi, false,
                 ndi2 st (pat_loleft, pat_hiright)))
|       pat_lo DOTDOT
        (PRange (SOME pat_lo, NONE, false, ndi2 st (pat_loleft, DOTDOTright)))
|       DOTDOTEQ pat_hi
        (PRange (NONE, SOME pat_hi, true, ndi2 st (DOTDOTEQleft, pat_hiright)))
|       path_e LPAREN pats RPAREN
        (PTupleStruct (path_e, pats, ndi2 st (path_eleft, RPARENright)))
|       path_e STRUCTLB fpitems RBRACE
        (let val (fs, rest) = split_fpitems fpitems
         in PStruct (path_e, fs, rest, ndi2 st (path_eleft, RBRACEright)) end)
|       LPAREN RPAREN
        (PTuple ([], ndi2 st (LPARENleft, RPARENright)))
|       LPAREN pat RPAREN
        (PParen (pat, ndi2 st (LPARENleft, RPARENright)))
|       LPAREN pat COMMA pats RPAREN
        (PTuple (pat :: pats, ndi2 st (LPARENleft, RPARENright)))
|       MUT LPAREN pat COMMA pats RPAREN
        (PMut (PTuple (pat :: pats, ndi2 st (LPARENleft, RPARENright)),
               ndi2 st (MUTleft, RPARENright)))
|       LBRACKET pats RBRACKET
        (PSlice (pats, ndi2 st (LBRACKETleft, RBRACKETright)))
|       AMP pat_na
        (PRef (false, pat_na, ndi2 st (AMPleft, pat_naright)))
|       AMP MUT pat_na
        (PRef (true, pat_na, ndi2 st (AMPleft, pat_naright)))
|       AMPAMP pat_na
        (PRef (false, PRef (false, pat_na, ndi2 st (AMPAMPleft, pat_naright)),
               ndi2 st (AMPAMPleft, pat_naright)))
|       AMPAMP MUT pat_na
        (PRef (false, PRef (true, pat_na, ndi2 st (AMPAMPleft, pat_naright)),
               ndi2 st (AMPAMPleft, pat_naright)))
|       HOL
        (PHol (#1 HOL, #2 HOL, ndi2 st (HOLleft, HOLright)))
pats:
        
        ([])
|       pat
        ([pat])
|       pat COMMA pats
        (pat :: pats)
fpitems:
        
        ([])
|       fpitem
        ([fpitem])
|       fpitem COMMA fpitems
        (fpitem :: fpitems)
fpitem:
        name COLON pat
        (FPField (FieldPat (name, SOME pat, ndi2 st (nameleft, patright))))
|       name
        (FPField (FieldPat (name, NONE, nodeInfo_of_ident name)))
|       MUT name
        (FPField (FieldPat
                  (name, SOME
                   (PIdent (false, true, name, NONE,
                            ndi2 st (MUTleft, nameright))),
                              ndi2 st (MUTleft, nameright))))
|       DOTDOT
        (FPRest)
items:
        
        ([])
|       items item
        (items @ [item])
item:
        attrs item_rest
        (item_rest attrs)
vis:
        PUB
        (VPub "")
|       PUB LPAREN CRATE RPAREN
        (VPub "crate")
|       PUB LPAREN SUPER RPAREN
        (VPub "super")
|       PUB LPAREN SELFV RPAREN
        (VPub "self")
item_rest:
        vis item_core
        (fn attrs =>
         MkItem (strip_attrs attrs, vis, item_core,
                 ndi_a st attrs (visleft, item_coreright)))
|       item_core
        (fn attrs =>
         MkItem (strip_attrs attrs, VPriv, item_core,
                 ndi_a st attrs (item_coreleft, item_coreright)))
fn_head:
        FN
        ([])
|       CONST FN
        (["const"])
|       UNSAFE FN
        (["unsafe"])
|       CONST UNSAFE FN
        (["const", "unsafe"])
item_core:
        fn_head name gparams LPAREN fparams RPAREN opt_ret wh fn_body
        (IFn (fn_head, name, gparams, fparams, opt_ret, wh, fn_body))
|       STRUCT name gparams wh blk_open fields_named RBRACE
        (IStruct (name, gparams, wh, FNamed fields_named))
|       STRUCT name gparams LPAREN fields_tuple RPAREN wh SEMI
        (IStruct (name, gparams, wh, FTuple fields_tuple))
|       STRUCT name gparams wh SEMI
        (IStruct (name, gparams, wh, FUnit))
|       ENUM name gparams wh blk_open variants RBRACE
        (IEnum (name, gparams, wh, variants))
|       IMPL gparams path_t FOR ty wh blk_open items RBRACE
        (IImpl (false, gparams, SOME path_t, ty, wh, items))
|       IMPL gparams ty wh blk_open items RBRACE
        (IImpl (false, gparams, NONE, ty, wh, items))
|       UNSAFE IMPL gparams path_t FOR ty wh blk_open items RBRACE
        (IImpl (true, gparams, SOME path_t, ty, wh, items))
|       UNSAFE IMPL gparams ty wh blk_open items RBRACE
        (IImpl (true, gparams, NONE, ty, wh, items))
|       TRAIT name gparams opt_supers wh blk_open items RBRACE
        (ITrait (false, name, gparams, opt_supers, wh, items))
|       UNSAFE TRAIT name gparams opt_supers wh blk_open items RBRACE
        (ITrait (true, name, gparams, opt_supers, wh, items))
|       CONST IDENT COLON ty opt_init SEMI
        (IConst (mkid st (IDENT, IDENTleft, IDENTright), ty, opt_init))
|       STATIC name COLON ty opt_init SEMI
        (IStatic (false, name, ty, opt_init))
|       STATIC MUT name COLON ty opt_init SEMI
        (IStatic (true, name, ty, opt_init))
|       TYPE name gparams opt_supers opt_eq_ty SEMI
        (ITypeAlias (name, gparams, opt_supers, opt_eq_ty))
|       USE use_tree SEMI
        (IUse use_tree)
|       MOD name SEMI
        (IMod (name, NONE))
|       MOD name blk_open items RBRACE
        (IMod (name, SOME items))
opt_init:
        
        (NONE)
|       EQ expr
        (SOME expr)
opt_supers:
        
        ([])
|       COLON bounds
        (bounds)
opt_eq_ty:
        
        (NONE)
|       EQ ty
        (SOME ty)
opt_ret:
        
        (NONE)
|       ARROW ty
        (SOME ty)
fn_body:
        block
        (SOME block)
|       SEMI
        (NONE)
fparams:
        
        ([])
|       fplist
        (fplist)
fplist:
        fparam
        ([fparam])
|       fparam COMMA
        ([fparam])
|       fparam COMMA fplist
        (fparam :: fplist)
fparam:
        attrs SELFV
        (PSelf (false, NONE, false, NONE,
                ndi_a st attrs (SELFVleft, SELFVright)))
|       attrs MUT SELFV
        (PSelf (false, NONE, true, NONE, ndi_a st attrs (MUTleft, SELFVright)))
|       attrs AMP SELFV
        (PSelf (true, NONE, false, NONE, ndi_a st attrs (AMPleft, SELFVright)))
|       attrs AMP MUT SELFV
        (PSelf (true, NONE, true, NONE, ndi_a st attrs (AMPleft, SELFVright)))
|       attrs AMP LIFETIME SELFV
        (PSelf (true, SOME LIFETIME, false, NONE,
                ndi_a st attrs (AMPleft, SELFVright)))
|       attrs AMP LIFETIME MUT SELFV
        (PSelf (true, SOME LIFETIME, true, NONE,
                ndi_a st attrs (AMPleft, SELFVright)))
|       attrs SELFV COLON ty
        (PSelf (false, NONE, false, SOME ty,
                ndi_a st attrs (SELFVleft, tyright)))
|       attrs MUT SELFV COLON ty
        (PSelf (false, NONE, true, SOME ty, ndi_a st attrs (MUTleft, tyright)))
|       attrs pat_na COLON ty
        (PParam (strip_attrs attrs, pat_na, ty,
                 ndi_a st attrs (pat_naleft, tyright)))
gparams:
        
        ([])
|       LT gplist gclose
        (gplist)
gplist:
        gp
        ([gp])
|       gp COMMA
        ([gp])
|       gp COMMA gplist
        (gp :: gplist)
gp:
        LIFETIME
        (GPLifetime (LIFETIME, [], ndi2 st (LIFETIMEleft, LIFETIMEright)))
|       LIFETIME COLON lifetimes
        (GPLifetime
         (LIFETIME, lifetimes, ndi2 st (LIFETIMEleft, lifetimesright)))
|       name
        (GPType (name, [], NONE, nodeInfo_of_ident name))
|       name COLON bounds
        (GPType (name, bounds, NONE, ndi2 st (nameleft, boundsright)))
|       name EQ ty
        (GPType (name, [], SOME ty, ndi2 st (nameleft, tyright)))
|       name COLON bounds EQ ty
        (GPType (name, bounds, SOME ty, ndi2 st (nameleft, tyright)))
|       CONST name COLON ty
        (GPConst (name, ty, ndi2 st (CONSTleft, tyright)))
wh:
        
        ([])
|       WHERE wlist
        (wlist)
wlist:
        wpred
        ([wpred])
|       wpred COMMA
        ([wpred])
|       wpred COMMA wlist
        (wpred :: wlist)
wpred:
        ty COLON bounds
        (WType (ty, bounds, ndi2 st (tyleft, boundsright)))
|       LIFETIME COLON lifetimes
        (WLifetime
         (LIFETIME, lifetimes, ndi2 st (LIFETIMEleft, lifetimesright)))
fields_named:
        
        ([])
|       fielddef
        ([fielddef])
|       fielddef COMMA fields_named
        (fielddef :: fields_named)
fielddef:
        attrs name COLON ty
        (FieldDef
         (strip_attrs attrs, VPriv, SOME name, ty,
          ndi_a st attrs (nameleft, tyright)))
|       attrs vis name COLON ty
        (FieldDef
         (strip_attrs attrs, vis, SOME name, ty,
          ndi_a st attrs (visleft, tyright)))
fields_tuple:
        
        ([])
|       tfield
        ([tfield])
|       tfield COMMA fields_tuple
        (tfield :: fields_tuple)
tfield:
        attrs ty
        (FieldDef
         (strip_attrs attrs, VPriv, NONE, ty, ndi_a st attrs (tyleft, tyright)))
|       attrs vis ty
        (FieldDef
         (strip_attrs attrs, vis, NONE, ty, ndi_a st attrs (visleft, tyright)))
variants:
        
        ([])
|       variant
        ([variant])
|       variant COMMA variants
        (variant :: variants)
variant:
        attrs name
        (Variant (strip_attrs attrs, name, FUnit, NONE,
                  ndi_a st attrs (nameleft, nameright)))
|       attrs name EQ expr
        (Variant (strip_attrs attrs, name, FUnit, SOME expr,
                  ndi_a st attrs (nameleft, exprright)))
|       attrs name LPAREN fields_tuple RPAREN
        (Variant (strip_attrs attrs, name, FTuple fields_tuple, NONE,
                  ndi_a st attrs (nameleft, RPARENright)))
|       attrs name STRUCTLB fields_named RBRACE
        (Variant (strip_attrs attrs, name, FNamed fields_named, NONE,
                  ndi_a st attrs (nameleft, RBRACEright)))
use_path:
        seg_id
        ([seg_id])
|       use_path COLONCOLON seg_id
        (use_path @ [seg_id])
use_tree:
        use_path
        (UName (use_path, NONE, ndi2 st (use_pathleft, use_pathright)))
|       use_path AS name
        (UName (use_path, SOME name, ndi2 st (use_pathleft, nameright)))
|       use_path COLONCOLON STAR
        (UGlob (use_path, ndi2 st (use_pathleft, STARright)))
|       use_path COLONCOLON LBRACE use_list RBRACE
        (UGroup (use_path, use_list, ndi2 st (use_pathleft, RBRACEright)))
|       STAR
        (UGlob ([], ndi2 st (STARleft, STARright)))
|       LBRACE use_list RBRACE
        (UGroup ([], use_list, ndi2 st (LBRACEleft, RBRACEright)))
use_list:
        
        ([])
|       use_tree
        ([use_tree])
|       use_tree COMMA use_list
        (use_tree :: use_list)
\<close>

text\<open>
  \<^verbatim>\<open>MicroRust_Parse\<close> runs the generated lexer/parser pair on a source, from one
  of six entry points (a source file, a uRust function body, an expression, a
  type, a pattern, a name: a synthetic first token selects the grammar's start).
  Every call creates its own \<^verbatim>\<open>MicroRust_State\<close>, so calls are independent and may
  run concurrently.

  Between lexer and parser sits the stream described in the introduction. It
  reads the lexer's tokens one by one, with one or two tokens of lookahead, and
  keeps a stack of \<^emph>\<open>regions\<close> - \<open>Open\<close> (inside brackets, braces or at the top),
  \<open>Cond\<close> (the head of an \<open>if\<close>, \<open>while\<close>, \<open>match\<close>, \<open>for\<close>, of an item), \<open>PatCond\<close>
  (the pattern of an \<open>if let\<close>/\<open>while let\<close>) - from which it decides what an
  opening brace is:

  \<^item> in a \<open>Cond\<close> region the brace opens the body (\<open>BLOCKLB\<close>) and ends the head;
  \<^item> after an identifier, \<open>Self\<close> or a closing \<open>>\<close>, elsewhere, it opens a struct
    expression or pattern (\<open>STRUCTLB\<close>);
  \<^item> otherwise it is an ordinary \<open>LBRACE\<close>.

  The stream also marks a \<open>>\<close> that is immediately followed by \<open>>\<close> or \<open>=\<close> as
  \<open>GTJ\<close> (``joint''): the grammar reads \<open>>>\<close>, \<open>>=\<close> and \<open>>>=\<close> as operators from
  \<open>GTJ\<close> \<open>>\<close>, \<open>GTJ\<close> \<open>=\<close> and \<open>GTJ\<close> \<open>GTJ\<close> \<open>=\<close>, and accepts \<open>GTJ\<close> as well as \<open>>\<close> as
  the end of a list of generic arguments.
\<close>

ML\<open>
structure MicroRust_Parse = struct

structure P = MicroRust.MicroRustParser
structure T = MicroRust.MicroRustLrVals.Tokens

datatype entry = Entry_Crate | Entry_Expr | Entry_Type | Entry_Id | Entry_Body
  | Entry_Pat

fun entry_token Entry_Crate p = T.ENTRY_CRATE (p, p)
  | entry_token Entry_Expr p = T.ENTRY_EXPR (p, p)
  | entry_token Entry_Type p = T.ENTRY_TYPE (p, p)
  | entry_token Entry_Id p = T.ENTRY_ID (p, p)
  | entry_token Entry_Body p = T.ENTRY_BODY (p, p)
  | entry_token Entry_Pat p = T.ENTRY_PAT (p, p)

datatype region = Open | Cond | PatCond

(* Tokens after which a "{" opens a struct expression or pattern. *)
val path_end_kinds = ["IDENT", "SELFT", "GT", "GTJ"]

(* Where an "impl" starts an item rather than a type ("impl Trait" in a
   signature). *)
val item_start_kinds =
  ["", "LBRACE", "RBRACE", "BLOCKLB", "STRUCTLB", "SEMI", "ATTR", "ATTRI",
   "UNSAFE", "PUB", "RPAREN"]

fun struct_stream entry st raw_lex pos eof_pos =
  let
    val eof_tok = T.EOF (eof_pos, eof_pos)

    val queue = Unsynchronized.ref [entry_token entry (pos 0)]
    val buf : ((P.svalue, P.pos) P.Token.token * MicroRust_State.layout) list
      Unsynchronized.ref =
      Unsynchronized.ref []
    val regions : region list Unsynchronized.ref = Unsynchronized.ref []
    val prev_kind = Unsynchronized.ref ""
    val pending_for = Unsynchronized.ref false
    val eof_seen = Unsynchronized.ref false

    fun read_raw () =
      let
        val tok = raw_lex ()
        val lay = MicroRust_Layout.get st
        val is_eof = P.sameToken (tok, eof_tok)
      in (tok, if is_eof
          then {start = #stop lay, stop = #stop lay, kind = "EOF"} else lay) end

    fun take_raw () =
      (case !buf of
         x :: xs => (buf := xs; x)
       | [] => read_raw ())

    (* the i-th token (0-based) after the current one, without consuming it *)
    fun peek i =
      let
        fun fill () = if length (!buf) > i then ()
          else (buf := !buf @ [read_raw ()]; fill ())
        val _ = fill ()
      in nth (!buf) i end

    fun top () = (case !regions of [] => Open | r :: _ => r)
    fun push r = regions := r :: !regions
    fun replace_top r =
      (case !regions of [] => () | _ :: rest => regions := r :: rest)
    fun pop () = (case !regions of [] => () | _ :: rest => regions := rest)
    fun close () =
      (case !regions of
         [] => ()
       | Open :: rest => regions := rest
       | _ :: rest => (regions := rest; close ()))

    fun relabel cons (lay : MicroRust_State.layout) =
      cons (pos (#start lay), pos (#stop lay))

    (* Classifies the token, updating the regions; returns the token the parser
       is to see. *)
    fun classify (tok0, lay : MicroRust_State.layout) =
      let
        val kind = #kind lay
        val prev = !prev_kind
        fun at_item_start () = member (op =) item_start_kinds prev
      in
        (case kind of
           "LBRACE" =>
             (case top () of
                Cond => (replace_top Open; (relabel T.BLOCKLB lay, "BLOCKLB"))
              | _ =>
                  (push Open;
                   if member (op =) path_end_kinds prev
                   then (relabel T.STRUCTLB lay, "STRUCTLB")
                   else (tok0, kind)))
         | "LPAREN" => (push Open; (tok0, kind))
         | "LBRACKET" => (push Open; (tok0, kind))
         | "RPAREN" => (close (); (tok0, kind))
         | "RBRACKET" => (close (); (tok0, kind))
         | "RBRACE" => (close (); (tok0, kind))
         | "IF" => (push Cond; (tok0, kind))
         | "WHILE" => (push Cond; (tok0, kind))
         | "MATCH" => (push Cond; (tok0, kind))
         | "LET" =>
           ((if top () = Cond then replace_top PatCond else ()); (tok0, kind))
         | "EQ" =>
           ((if top () = PatCond then replace_top Cond else ()); (tok0, kind))
         | "FATARROW" => ((if top () = Cond then pop () else ()); (tok0, kind))
         | "SEMI" => ((if top () = Cond then pop () else ()); (tok0, kind))
         | "FN" =>
             ((if top () = Open andalso #kind (#2 (peek 0)) = "IDENT"
               then push Cond else ()); (tok0, kind))
         | "STRUCT" => ((if top () = Open then push Cond else ()); (tok0, kind))
         | "ENUM" => ((if top () = Open then push Cond else ()); (tok0, kind))
         | "TRAIT" => ((if top () = Open then push Cond else ()); (tok0, kind))
         | "MOD" => ((if top () = Open then push Cond else ()); (tok0, kind))
         | "IMPL" =>
           ((if top () = Open andalso at_item_start () then push Cond
             else ()); (tok0, kind))
         | "FOR" =>
             ((if top () = Open andalso #kind (#2 (peek 0)) <> "LT"
               then pending_for := true else ());
              (tok0, kind))
         | "IN" =>
           ((if !pending_for then (pending_for := false; push Cond)
             else ()); (tok0, kind))
         | "GT" =>
             let val (_, lay2) = peek 0
             in
               if (#kind lay2 = "GT" orelse #kind lay2 = "EQ")
                 andalso #start lay2 = #stop lay
               then (relabel T.GTJ lay, "GTJ")
               else (tok0, kind)
             end
         | _ => (tok0, kind))
      end

    fun next () =
      (case !queue of
         t :: ts => (queue := ts; t)
       | [] =>
           if !eof_seen then eof_tok
           else
             let val (tok0, lay0) = take_raw ()
             in
               if #kind lay0 = "EOF" then (eof_seen := true; eof_tok)
               else
                 let val (tok, kind) = classify (tok0, lay0)
                 in prev_kind := kind; tok end
             end)
  in P.Stream.streamify next end

(* Runs the parser on "source" from the given entry point; "mk_err" makes the
   parser's error callback from the parse's state. Every parse creates its own
   state. *)
fun parse mk_err entry ctxt source =
  let
    val st = MicroRust_State.init ctxt source
    val err = mk_err st
    val input_text = Lex_yacc_state.text_of (#base st)
    val consumed = Unsynchronized.ref false
    fun input_string _ = if !consumed then ""
      else (consumed := true; input_text)
    val raw_lex = MicroRust.MicroRustLex.makeLexer input_string st
    val pos = Lex_yacc_state.get_pos (#base st)
    val eof_pos = pos (String.size input_text)
    val stream = struct_stream entry st raw_lex pos eof_pos
    val (result, _) = P.parse (0, stream, err, st)
      handle Fail msg => (err (msg, pos 0, pos 0); raise Fail msg)
    val _ = (case !(#lex_error st) of SOME (msg, p) =>
             err (msg, p, p) | NONE => ())
  in result end

fun parse_loud entry ctxt source =
  parse (fn st => Lex_yacc_state.print_error (#base st)) entry ctxt source

(* The silent variant the "_reject" commands use: a locally declared exception,
   not the library's "print_error" (which reports PIDE error markup before
   raising, and raises an exception Isabelle/ML cannot reliably catch by
   identity across the SML sandbox boundary). *)
exception Rejected of string
fun quiet_error (s : string, _ : Position.T, _ : Position.T) = raise Rejected s

fun parse_quiet entry ctxt source = parse (K quiet_error) entry ctxt source

end
