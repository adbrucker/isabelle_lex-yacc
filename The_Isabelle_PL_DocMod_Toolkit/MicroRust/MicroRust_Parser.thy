theory MicroRust_Parser
  imports "../../Isabelle_Lex-Yacc/LexYacc" "MicroRust_Ast"
begin

section\<open>Lexer and Parser for MicroRust\<close>

text\<open>
  This theory contains the lexer and the parser of MicroRust, generated by
  \<open>ml_lex_yacc [state]\<close> (the re-entrant variant of the library: every parse has
  its own state object), and \<^verbatim>\<open>MicroRust_Parse\<close>, the parse driver. What is
  MicroRust, and where does its grammar come from?

  \<^bold>\<open>There is no official grammar of Rust.\<close> The reference implementation (\<^verbatim>\<open>rustc\<close>)
  is the specification; the Rust Reference describes the syntax in a PEG-style
  notation (ordered choice, a ``hard cut''), which cannot be turned into an LALR
  grammar mechanically; the grammar of \<^verbatim>\<open>rust-analyzer\<close> (\<^verbatim>\<open>rust.ungram\<close>) states
  that it ``does not specify parsing rules (ambiguities, precedence, etc)''.
  This front-end therefore follows a \<^emph>\<open>deliberately chosen subset with an
  explicit syntax table\<close>: \<^emph>\<open>uRust\<close>, the Rust-like language of the AutoCorrode
  verification framework for Isabelle/HOL (Micro_Rust_Syntax.thy of
  \<^verbatim>\<open>github.com/awslabs/AutoCorrode\<close>), plus a thin layer of Rust items (\<^verbatim>\<open>fn\<close>,
  \<^verbatim>\<open>struct\<close>, \<^verbatim>\<open>enum\<close>, \<^verbatim>\<open>impl\<close>, \<^verbatim>\<open>trait\<close>, \<^verbatim>\<open>const\<close>, \<^verbatim>\<open>static\<close>, \<^verbatim>\<open>type\<close>, \<^verbatim>\<open>use\<close>, \<^verbatim>\<open>mod\<close>) so
  that a whole source file can be read and not only the body of a function.
  Operator precedences are those of the Rust Reference (which uRust also
  follows).

  What the grammar covers (an expression language, as uRust is):

  \<^item> \<^bold>\<open>Statements\<close>: \<open>let\<close> (with type, with \<open>else\<close>), uRust's \<open>const\<close> binding,
    expression statements, items; block-like statements (\<open>if match while loop
    for unsafe {..}\<close>) need no semicolon and end the statement (a following \<open>*x\<close>
    or \<open>-1\<close> is a new statement), except before \<open>.\<close> and \<open>?\<close>, as in rustc.
  \<^item> \<^bold>\<open>Expressions\<close>: literals, paths (with turbofish and \<open><T as Trait>::f\<close>), the
    unary and binary operators with Rust's precedences, ranges, assignment and
    compound assignment, \<open>as\<close> casts, \<open>?\<close>, calls, method calls, fields, tuple
    indices (\<open>x.0.1\<close>), indexing, tuples, arrays and repeats, struct expressions
    (with \<open>..base\<close>), closures, \<open>if\<close>/\<open>if let\<close>/\<open>else if\<close>, \<open>while\<close>/\<open>while
    let\<close>/\<open>loop\<close>/\<open>for\<close> with labels, \<open>match\<close> with guards,
    \<open>return\<close>/\<open>break\<close>/\<open>continue\<close>, attributes on statements and expressions
    (\<open>#[fuel(n)] while ...\<close>), the macro calls \<open>name!(args)\<close>, \<open>name![args]\<close>,
    \<open>vec![e; n]\<close> and \<open>matches!(e, p)\<close>.
  \<^item> \<^bold>\<open>uRust specifics\<close>: the HOL escapes \<open>\<llangle>...\<rrangle>\<close> (with sub-script) and \<open>\<epsilon>\<open>...\<close>\<close> as
    expressions, patterns and types (kept as opaque text, as is all HOL in an
    antiquotation), \<open>yield\<close> and \<open>log a b\<close>, Isabelle's \<open>\<comment>\<open>...\<close>\<close> comments inside a
    body.
  \<^item> \<^bold>\<open>Patterns\<close>: wildcard, identifiers (\<open>ref\<close>, \<open>mut\<close>, \<open>x @ p\<close>), literals, ranges,
    paths, tuple structs, structs, tuples, slices (with \<open>..\<close>), references,
    or-patterns.
  \<^item> \<^bold>\<open>Types\<close>: paths with generic arguments, references, raw pointers, tuples,
    slices, arrays, \<open>fn\<close> types, \<open>impl\<close>/\<open>dyn\<close> bounds, \<open>_\<close>, \<open>!\<close>.

  Deliberately not covered: macro definitions and general token-tree macros (a
  macro call must have expressions as arguments), generic associated types,
  \<open>async\<close>, \<open>union\<close>, \<open>extern\<close>, \<open>dyn\<close> with lifetimes, higher-ranked bounds
  (\<open>for<'a>\<close>), \<open>Fn(A) -> B\<close> sugar, inner attributes except as items' attributes,
  let chains, and float suffix subtleties. The AutoCorrode sources are the test
  corpus (\<^verbatim>\<open>MicroRust_Tests.thy\<close>): every uRust body in them is checked.

  \<^bold>\<open>Three places where an LALR grammar needs help\<close>, all resolved in the stream
  between lexer and parser (\<^verbatim>\<open>MicroRust_Parse.struct_stream\<close>), so that the
  grammar itself stays an ordinary context-free one:

  \<^enum> \<open>Foo { a: 1 }\<close> is a struct expression but \<open>if x { ... }\<close> is a condition and a
    block. The stream tracks the nesting (conditions of \<open>if while match\<close>, the
    head of an item, \<open>for ... in\<close>) and delivers the brace as \<open>STRUCTLB\<close> (after a
    path where a struct expression is allowed), \<open>BLOCKLB\<close> (the body of a
    construct whose head is being read), or \<open>LBRACE\<close> (everything else).
  \<^enum> \<open>>\<close> is always a single token: \<open>Vec<Vec<u8>>\<close> closes two generics, \<open>a >> b\<close>,
    \<open>a >= b\<close> and \<open>a >>= b\<close> are read as \<open>>\<close> \<open>>\<close>, \<open>>\<close> \<open>=\<close>, \<open>>\<close> \<open>>\<close> \<open>=\<close> by the
    grammar (not requiring the tokens to touch: \<open>a > > b\<close> is accepted as a
    shift, a deliberate leniency).
  \<^enum> A block-like expression at the start of a statement ends it. The grammar has
    a harmless reduce/reduce conflict there, resolved by rule order (statement
    before expression), exactly rustc's rule. The same holds for a match arm
    whose body is block-like.

\<close>
ML\<open>
(* Everything the lexer and the grammar actions need to remember during one
   parse lives in one state object, created per parse ("init") and handed to
   the lexer (ML-Lex %arg) and the parser (ML-Yacc %arg) by "ml_lex_yacc
   [state]" - nothing is shared between parses.
     base        - the library's own part: source, context, position table
     pending     - comments lexed since the previous real token
     attached    - the comments that have been attached to a token position
     layout      - start, stop and kind of the newest real token, for the
                   stream wrapper
     antiq_*     - the antiquotation scanner (see the lexer): nesting depth of
                   the cartouche being skipped, which comment state to return
                   to, the most recent tag, the body text so far and its start
                   position
     comment_depth, bodyless_ok
                 - block comments nest; whether a bodyless antiquotation tag
                   is allowed in the current comment
     buf, start, depth
                 - the scanner of strings, HOL escapes, attributes and Isabelle
                   comments (one at a time: they are different lexer states)
     lex_error   - the first lexical error (unterminated comment, string,
                   escape): the lexer cannot raise it itself, as the parse's
                   error callback decides how an error is reported (loudly, or
                   silently for the "_reject" commands), so it is recorded here
                   and reported by "MicroRust_Parse.parse" when the parse is
                   over *)
structure MicroRust_State = struct
  type comments = Position.T MicroRust_Ast.comment list
  type layout = {start: int, stop: int, kind: string}
  val layout_init : layout = {start = 0, stop = 0, kind = ""}

  type T = {base : Lex_yacc_state.T,
            pending : comments Unsynchronized.ref,
            attached : (Position.T * comments) list Unsynchronized.ref,
            layout : layout Unsynchronized.ref,
            antiq_depth : int Unsynchronized.ref,
            antiq_from_block : bool Unsynchronized.ref,
            antiq_tag : (string * MicroRust_Ast.navi list * int * Position.T)
              Unsynchronized.ref,
            antiq_buf : string list Unsynchronized.ref,
            antiq_start : Position.T Unsynchronized.ref,
            comment_depth : int Unsynchronized.ref,
            bodyless_ok : bool Unsynchronized.ref,
            comment_start : int Unsynchronized.ref,
            buf : string list Unsynchronized.ref,
            start : int Unsynchronized.ref,
            depth : int Unsynchronized.ref,
            lex_error : (string * Position.T) option Unsynchronized.ref}

  fun init ctxt source : T =
    {base = Lex_yacc_state.init ctxt source,
     pending = Unsynchronized.ref [],
     attached = Unsynchronized.ref [],
     layout = Unsynchronized.ref layout_init,
     antiq_depth = Unsynchronized.ref 0,
     antiq_from_block = Unsynchronized.ref true,
     antiq_tag = Unsynchronized.ref ("", [], 0, Position.none),
     antiq_buf = Unsynchronized.ref [],
     antiq_start = Unsynchronized.ref Position.none,
     comment_depth = Unsynchronized.ref 0,
     bodyless_ok = Unsynchronized.ref false,
     comment_start = Unsynchronized.ref 0,
     buf = Unsynchronized.ref [],
     start = Unsynchronized.ref 0,
     depth = Unsynchronized.ref 0,
     lex_error = Unsynchronized.ref NONE}
end

(* The comments/antiquotations collected while lexing, attached to whichever
   real token follows (as in C11_Comments / Occam2_Comments / Scala3_Comments).
   *)
structure MicroRust_Comments = struct
  fun push (st : MicroRust_State.T) c = #pending st := !(#pending st) @ [c]

  fun push_raw st (text, pos) =
    if List.all Char.isSpace (String.explode text) then ()
    else push st (MicroRust_Ast.Raw_txt [(text, pos)])

  fun push_antiquotation st tag navi level cartouche =
    push st (MicroRust_Ast.Antiquotation (tag, navi, level, cartouche))

  fun attach_pending (st : MicroRust_State.T) (p : Position.T) =
    (case !(#pending st) of
       [] => ()
     | cs => (#pending st := []; #attached st := (p, cs) :: !(#attached st)))

  (* Non-destructive on purpose, for the reason given at "C11_Comments.claim".
     *)
  fun claim (st : MicroRust_State.T) (p : Position.T) : Position.T
    MicroRust_Ast.comment list =
    (case AList.lookup (op =) (!(#attached st)) p of NONE => [] | SOME cs => cs)

  fun mk_nodeInfo st (claimed_at : Position.T)
    (report_pos : Position.T) : Position.T MicroRust_Ast.nodeInfo =
    (case claim st claimed_at of
       [] => MicroRust_Ast.OnlyPos report_pos
     | cs => MicroRust_Ast.NodeInfo (cs, report_pos))
end

(* The newest real token, recorded by the lexer for the stream wrapper (which
   decides from it how a brace is to be read, see the introduction): its offsets
   and its kind - the name of the token in the grammar ("IDENT", "LBRACE", ...).
   *)
structure MicroRust_Layout = struct
  fun get (st : MicroRust_State.T) = !(#layout st)
  fun token (st : MicroRust_State.T) (start, stop, kind) =
    #layout st := {start = start, stop = stop, kind = kind}
end
\<close>
SML_import \<open>structure MicroRust_Ast = struct open MicroRust_Ast end\<close>
SML_import \<open>structure MicroRust_State = struct open MicroRust_State end\<close>
SML_import \<open>structure MicroRust_Comments = struct open MicroRust_Comments end\<close>
SML_import \<open>structure MicroRust_Layout = struct open MicroRust_Layout end\<close>

ml_lex_yacc [verbose, state] "MicroRust" where

lex_user_declarations\<open>
(* The lexer's and the parser's argument is the per-parse state of
   "MicroRust_State" (the lexer rules and the grammar actions call it "st");
   "init" creates it, "base" is its part the library functions work on. *)
type arg = MicroRust_State.T
fun init ctxt source : arg = MicroRust_State.init ctxt source
fun base (st : arg) : Lex_yacc_state.T = #base st

fun gp (st : arg) yypos = Lex_yacc_state.get_pos (base st) yypos
fun report (st : arg) x = Lex_yacc_state.report_token (base st) x

fun antiq_depth (st : arg) = #antiq_depth st
fun antiq_from_block (st : arg) = #antiq_from_block st
fun antiq_tag (st : arg) = #antiq_tag st
fun antiq_buf (st : arg) = #antiq_buf st
fun antiq_start (st : arg) = #antiq_start st
fun comment_depth (st : arg) = #comment_depth st
fun bodyless_ok (st : arg) = #bodyless_ok st
fun comment_start (st : arg) = #comment_start st

(* Every real token goes through one of the constructors below, which, before
   reporting the token's markup, (1) let the comments gathered since the
   previous token attach themselves to this one, and (2) tell the layout
   recorder where this token starts and stops and what kind of token it is.
   Value-carrying tokens get their true start/end span as position. *)
fun stok st kind markup (yypos, yytext, cons) =
    (MicroRust_Comments.attach_pending st (gp st yypos);
     MicroRust_Layout.token st (yypos, yypos + String.size yytext, kind);
     tok (base st) (yypos, yytext, markup, kind, "", cons))

fun stok_val st kind markup (yypos, yytext, cons, value) =
    let
      val _ = MicroRust_Comments.attach_pending st (gp st yypos)
      val _ = MicroRust_Layout.token st
        (yypos, yypos + String.size yytext, kind)
      val p = gp st yypos
      val p' = gp st (yypos + String.size yytext)
      val _ = report st (yypos, String.size yytext, markup, kind, "")
    in cons (value, p, p') end

(* A token that was scanned in several pieces (a raw string, a HOL escape, an
   attribute): "start" was recorded by "buf_open", the lexer is now at "stop".
   *)
fun buf_open (st : arg) yypos =
  (#buf st := []; #start st := yypos; #depth st := 0)
fun buf_push (st : arg) text = #buf st := text :: !(#buf st)
fun buf_text (st : arg) = String.concat (rev (!(#buf st)))

fun big_tok (st : arg) kind markup stop cons value =
    let
      val start = !(#start st)
      val p = gp st start
      val p' = gp st stop
      val _ = MicroRust_Comments.attach_pending st p
      val _ = MicroRust_Layout.token st (start, stop, kind)
      val _ = report st (start, stop - start, markup, kind, "")
    in cons (value, p, p') end

(* The end of a raw string, an attribute, a HOL escape or an epsilon escape: the
   pieces collected in the buffer become one token. *)
fun raw_close (st : arg) (yypos, yytext) =
    (buf_push st yytext;
     big_tok st "STR_LIT" Markup.string (yypos + String.size yytext)
       Tokens.STR_LIT (buf_text st) before (#buf st := []))

fun attr_close (st : arg) yypos =
    let
      val text = Lex_yacc_state.text_of (base st)
      val inner =
        String.isPrefix "#!" (String.extract (text, !(#start st), SOME 2))
      val body = buf_text st
      val _ = #buf st := []
    in
      if inner
      then big_tok st "ATTRI" Markup.keyword2 (yypos + 1) Tokens.ATTRI body
      else big_tok st "ATTR" Markup.keyword2 (yypos + 1) Tokens.ATTR body
    end

(* "yytext" is the closing bracket followed by the sub-scripts, if any; the
   bracket is ten characters long. A prefixed escape ("l" before the opening
   bracket) is recorded by depth 1. *)
fun hol_close (st : arg) (yypos, yytext) =
    let
      val body = buf_text st
      val _ = #buf st := []
      val prefixed = !(#depth st) = 1
      val _ = #depth st := 0
      val subs = String.extract (yytext, 10, NONE)
      val stop = yypos + String.size yytext
    in
      if prefixed
      then big_tok st "LHOL" Markup.quasi_keyword stop Tokens.LHOL (body, subs)
      else big_tok st "HOL" Markup.quasi_keyword stop Tokens.HOL (body, subs)
    end

fun eps_close (st : arg) (yypos, yytext) =
    let
      val body = buf_text st
      val _ = #buf st := []
    in
      big_tok st "EPS" Markup.quasi_keyword (yypos + String.size yytext)
        Tokens.EPS body
    end

(* Entering an escape or an attribute. *)
fun open_scan (st : arg) yypos depth = (buf_open st yypos; #depth st := depth)

(* An identifier-like word: a keyword or an identifier. *)
fun word_tok st (yypos, yytext) =
    let
      fun kw kind cons = stok st kind Markup.keyword1 (yypos, yytext, cons)
    in
      case yytext of
        "" => raise Fail "empty word"
      | "as" => kw "AS" Tokens.AS
      | "break" => kw "BREAK" Tokens.BREAK
      | "const" => kw "CONST" Tokens.CONST
      | "continue" => kw "CONTINUE" Tokens.CONTINUE
      | "crate" => kw "CRATE" Tokens.CRATE
      | "dyn" => kw "DYN" Tokens.DYN
      | "else" => kw "ELSE" Tokens.ELSE
      | "enum" => kw "ENUM" Tokens.ENUM
      | "extern" => kw "EXTERN" Tokens.EXTERN
      | "false" => kw "FALSE" Tokens.FALSE
      | "fn" => kw "FN" Tokens.FN
      | "for" => kw "FOR" Tokens.FOR
      | "if" => kw "IF" Tokens.IF
      | "impl" => kw "IMPL" Tokens.IMPL
      | "in" => kw "IN" Tokens.IN
      | "let" => kw "LET" Tokens.LET
      | "loop" => kw "LOOP" Tokens.LOOP
      | "match" => kw "MATCH" Tokens.MATCH
      | "mod" => kw "MOD" Tokens.MOD
      | "move" => kw "MOVE" Tokens.MOVE
      | "mut" => kw "MUT" Tokens.MUT
      | "pub" => kw "PUB" Tokens.PUB
      | "return" => kw "RETURN" Tokens.RETURN
      | "self" => kw "SELFV" Tokens.SELFV
      | "Self" => kw "SELFT" Tokens.SELFT
      | "static" => kw "STATIC" Tokens.STATIC
      | "struct" => kw "STRUCT" Tokens.STRUCT
      | "super" => kw "SUPER" Tokens.SUPER
      | "trait" => kw "TRAIT" Tokens.TRAIT
      | "true" => kw "TRUE" Tokens.TRUE
      | "type" => kw "TYPE" Tokens.TYPE
      | "unsafe" => kw "UNSAFE" Tokens.UNSAFE
      | "use" => kw "USE" Tokens.USE
      | "where" => kw "WHERE" Tokens.WHERE
      | "while" => kw "WHILE" Tokens.WHILE
      | "yield" => kw "YIELD" Tokens.YIELD
      | "match_switch" => kw "MATCH" Tokens.MATCH
      | "match_case" => kw "MATCH" Tokens.MATCH
      | _ => stok_val st "IDENT" Markup.free
          (yypos, yytext, Tokens.IDENT, yytext)
    end

(* Accumulate one fragment of raw comment text, tagged with its own span. *)
fun push_raw_fragment st (yypos, yytext) =
    MicroRust_Comments.push_raw st
      (yytext, Position.range_position
       (gp st yypos, gp st (yypos + String.size yytext)))

fun char_to_navi #"u" = MicroRust_Ast.up
  | char_to_navi #"U" = MicroRust_Ast.Up
  | char_to_navi #"r" = MicroRust_Ast.right
  | char_to_navi #"d" = MicroRust_Ast.down
  | char_to_navi c = raise Fail ("invalid navigation character " ^ String.str c)

(* Splits the text matched after the leading "@" into the tag name, its optional
   bracketed navigation string, and its optional parenthesized level. *)
fun parse_tag_navi_level text =
    let
      val trim =
        Substring.string o Substring.dropr Char.isSpace o Substring.full
      val after_at =
        Substring.dropl (fn c => c = #"@" orelse Char.isSpace c)
          (Substring.full text)
      val (name_ss, rest1) =
        Substring.splitl (fn c => Char.isAlphaNum c orelse c = #"_") after_at
      val rest1' = Substring.dropl Char.isSpace rest1
      val (navi, rest2) =
        if Substring.size rest1' > 0 andalso Substring.sub (rest1', 0) =
          #"[" then
          let
            val (navi_ss, after) =
              Substring.splitl (fn c => c <> #"]") (Substring.triml 1 rest1')
          in (map char_to_navi (String.explode (Substring.string navi_ss)),
              Substring.triml 1 after) end
        else ([], rest1')
      val rest2' = Substring.dropl Char.isSpace rest2
      val level =
        if Substring.size rest2' > 0 andalso Substring.sub (rest2', 0) =
          #"(" then
          let val (lvl_ss, _) =
            Substring.splitl (fn c => c <> #")") (Substring.triml 1 rest2')
          in valOf (Int.fromString (Substring.string lvl_ss)) end
        else 0
    in (trim (Substring.string name_ss), navi, level) end

(* A bodyless tag is a complete antiquotation with the empty body - but only
   where the comment opener allowed it ("//@", "/*@"): elsewhere it is plain
   comment text and is dropped here. *)
fun antiq_flush_pending_tag st =
    let val (name, navi, level, pos) = !(antiq_tag st) in
      if name = "" then ()
      else
        (antiq_tag st := ("", [], 0, Position.none);
         if !(bodyless_ok st)
         then MicroRust_Comments.push_antiquotation
           st {tag = (name, pos)} navi {level = level} {cartouche = ("", pos)}
         else ())
    end

fun antiq_tag_seen st (yypos, yytext) =
    let
      val (name, navi, level) = parse_tag_navi_level yytext
      val _ = if yypos = !(comment_start st) then bodyless_ok st := true else ()
    in antiq_flush_pending_tag st; antiq_tag
      st := (name, navi, level, gp st yypos) end

fun antiq_body_start st yypos = antiq_start st := gp st yypos

fun antiq_body_push st text = antiq_buf st := text :: !(antiq_buf st)

fun antiq_body_finish st yypos =
    let
      val body_text = String.concat (rev (!(antiq_buf st)))
      val body_pos = Position.range_position (!(antiq_start st), gp st yypos)
      val (tag_text, navi, level, tag_pos) = !(antiq_tag st)
    in
      antiq_buf st := [];
      antiq_tag st := ("", [], 0, Position.none);
      MicroRust_Comments.push_antiquotation
        st {tag = (tag_text, tag_pos)} navi {level = level} {cartouche =
            (body_text, body_pos)}
    end

(* The quoted-string alternative to a cartouche body: tag, level and body in one
   rule. *)
fun antiq_tag_and_string_seen st (yypos, yytext) =
    let
      fun find_quote i = if String.sub (yytext, i) =
        #"\"" then i else find_quote (i + 1)
      val qpos = find_quote 0
      val (name, navi, level) =
        parse_tag_navi_level (String.substring (yytext, 0, qpos))
      val body_len = String.size yytext - qpos - 2
      val body_text = String.substring (yytext, qpos + 1, body_len)
      val body_start = yypos + qpos + 1
      val body_pos =
        Position.range_position
          (gp st body_start, gp st (body_start + body_len))
    in
      MicroRust_Comments.push_antiquotation
        st {tag = (name, gp st yypos)} navi {level = level} {cartouche =
            (body_text, body_pos)}
    end

fun tag_with_body st (yypos, yytext) =
    (report st (yypos, String.size yytext, Markup.antiquote,
                "MicroRust antiquotation tag+body", "");
     antiq_tag_and_string_seen st (yypos, yytext))

fun tag_only st (yypos, yytext) =
    (antiq_tag_seen st (yypos, yytext);
     if !(bodyless_ok st)
     then report st (yypos, String.size yytext, Markup.antiquote,
                     "MicroRust antiquotation tag", "")
     else ())

fun cartouche_open st (yypos, yytext) block =
    (report st (yypos, String.size yytext, Markup.cartouche,
                "MicroRust antiquotation body", "");
     antiq_depth st := 1; antiq_from_block st := block;
     antiq_body_start st (yypos + String.size yytext))

(* Comments. A block comment nests; whichever way it ends, a pending bodyless
   tag is flushed. *)
fun comment_open st block yypos =
    (bodyless_ok st := false; comment_start st := yypos
     + 2; antiq_from_block st := block;
     if block then comment_depth st := 1 else ())

(* The first lexical error is recorded (see "MicroRust_State"); the lexer
   carries on, and "MicroRust_Parse.parse" reports it when the parse is over. *)
fun lex_fail (st : arg) (msg, pos) =
    (case !(#lex_error st) of NONE =>
     #lex_error st := SOME (msg, pos) | SOME _ => ())

(* Shadows the default "eof" of the "[state]" header: unterminated constructs
   are genuine errors, reported at their own start. *)
fun eof (st : arg) =
    let
      val _ =
        if !(antiq_depth st) > 0
        then (antiq_depth st := 0;
              lex_fail st
                ("Unterminated antiquotation body: no matching closing " ^
                 "cartouche before the end of input", !(antiq_start st)))
        else if !(comment_depth st) > 0
        then (comment_depth st := 0; lex_fail st
              ("Unterminated comment", gp st 0))
        else if !(#depth st) > 0 orelse not (null (!(#buf st)))
        then (#depth st := 0; #buf st := []; lex_fail st
              ("Unterminated string, escape or attribute",
               gp st (!(#start st))))
        else antiq_flush_pending_tag st
    in Tokens.EOF (Position.none, Position.none) end
\<close>
lex_definitions\<open>
D=[0-9];
N=[0-9][0-9_]*;
H=[0-9A-Fa-f_];
LET=([A-Za-z_]|[^\000-\127]);
LD=([A-Za-z0-9_]|[^\000-\127]);
TL=[A-Za-z_];
TA=[A-Za-z_0-9];
IS=(u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize);
