            continue ());
<COMMENT>"*/"
        => (comment_depth st := !(comment_depth st) - 1;
            if !(comment_depth st) = 0
              then (antiq_flush_pending_tag st; YYBEGIN INITIAL; continue ())
                else (push_raw_fragment st (yypos, yytext); continue ()));
<COMMENT>"*"
        => (push_raw_fragment st (yypos, yytext);
            continue ());
<COMMENT>"/"
        => (push_raw_fragment st (yypos, yytext);
