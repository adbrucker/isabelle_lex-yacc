            continue ());
<ANTIQ>{CLOSECART}
        => (antiq_depth st := !(antiq_depth st) - 1;
            if !(antiq_depth st) = 0
              then (antiq_body_finish st
                    yypos; (if !(antiq_from_block st) then YYBEGIN COMMENT
                            else YYBEGIN LCOMMENT); continue ())
                              else (antiq_body_push st yytext; continue ()));
