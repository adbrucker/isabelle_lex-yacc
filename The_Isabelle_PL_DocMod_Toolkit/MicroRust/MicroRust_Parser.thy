and yacc_user_declarations\<open>
open MicroRust_Ast

fun ndi st p = MicroRust_Comments.mk_nodeInfo st p p
fun ndi2 st (p1, p2) =
  MicroRust_Comments.mk_nodeInfo st p1 (Position.range_position (p1, p2))

(* A node that may be preceded by attributes: the comments before the first
   attribute belong to the node, and its range starts there. *)
fun ndi_a st (attrs : (Position.T * Position.T rAttr) list) (p1, p2) =
  let val p0 = (case attrs of (p, _) :: _ => p | [] => p1)
  in MicroRust_Comments.mk_nodeInfo st p0 (Position.range_position (p0, p2)) end
fun strip_attrs (attrs : (Position.T * Position.T rAttr) list) = map #2 attrs

(* A name token carries its true source span as its position, so the node's own
   range is exactly the name. *)
fun mkid st (s, l, r) = Ident (s, 0, ndi2 st (l, r))

fun mkseg id ga = Seg (id, ga, nodeInfo_of_ident id)
fun mkpath st (qself, global, segs, l, r) =
  Path (qself, global, segs, ndi2 st (l, r))
fun path1 st (id, l, r) = mkpath st (NONE, false, [mkseg id NONE], l, r)

(* "a::b::<T>": the generic arguments belong to the last segment read so far. *)
fun add_gargs st (Path (q, g, segs, _), ga, l, r) =
  let val Seg (id, _, sni) = List.last segs
  in Path (q, g, List.take (segs, length segs - 1)
           @ [Seg (id, SOME ga, sni)], ndi2 st (l, r)) end

fun extend_path st (Path (q, g, segs, _), seg, l, r) =
  Path (q, g, segs @ [seg], ndi2 st (l, r))

(* In a pattern a lone name is a binder or a constant (decided by the analysis),
   anything else a path. *)
fun pat_of_path (p as Path (NONE, false, [Seg (id, NONE, _)], _)) =
      PIdent (false, false, id, NONE, nodeInfo_of_ident id)
  | pat_of_path p = PPath p

(* A statement list followed by an optional final expression: the semicolon of a
   block-like statement comes as a separate empty statement and is absorbed; a
   block-like statement last in the block, with no semicolon, is the block's
   value. *)
fun absorb_semis stmts =
  (case stmts of
     SExpr (e, false, ni) :: SEmpty _ :: rest =>
       absorb_semis (SExpr (e, true, ni) :: rest)
   | s :: rest => s :: absorb_semis rest
   | [] => [])

fun mk_block st (stmts, tail, l, r) =
  let
    val stmts1 = absorb_semis stmts
    val (stmts2, tail2) =
      (case (tail, rev stmts1) of
         (NONE, SExpr (e, false, _) :: rest) => (rev rest, SOME e)
       | _ => (stmts1, tail))
  in Block (stmts2, tail2, ndi2 st (l, r)) end

fun wrap_attrs st attrs e (l, r) =
  if null attrs then e else EAttr (strip_attrs attrs, e, ndi_a st attrs (l, r))

datatype 'a sitem = SIField of 'a rFieldInit | SIBase of 'a rExpr
fun split_sitems xs =
  (List.mapPartial (fn SIField f => SOME f | _ => NONE) xs,
   (case List.mapPartial (fn SIBase b => SOME b | _ => NONE) xs of [] =>
    NONE | b :: _ => SOME b))

datatype 'a fpitem = FPField of 'a rFieldPat | FPRest
fun split_fpitems xs =
  (List.mapPartial (fn FPField f => SOME f | _ => NONE) xs,
   List.exists (fn FPRest => true | _ => false) xs)

(* "x.0.1" is read by the lexer as "x" "." "0.1"; a float of two digit strings
   after a dot is two tuple indices. *)
fun tup_index st (e, text, l, r) =
  (case String.fields (fn c => c = #".") text of
     [a, b] => ETupIdx (ETupIdx (e, a, ndi2 st (l, r)), b, ndi2 st (l, r))
   | _ => raise Fail "invalid tuple index")

(* Rust's naming convention decides what a lone identifier in a pattern is; here
   only the call sites need to know the segment list of a path. *)
fun is_log (Path (NONE, false, [Seg (Ident ("log", _, _), NONE, _)], _)) = true
  | is_log _ = false
\<close>
