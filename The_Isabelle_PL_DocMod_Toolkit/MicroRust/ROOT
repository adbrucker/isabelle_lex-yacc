chapter AFP

(* Independent of the parent "../../Isabelle_Lex-Yacc" session and of the other front-ends
   ("../C11", "../occam2", "../scala3"): the "directories" entry reaches "LexYacc.thy"/"YaccLib.thy"
   for "MicroRust_Parser.thy"'s own relative import, which makes the sessions unable to share one
   build graph. Build with "isabelle build -d MicroRust MicroRust" - never together with the other
   front-ends in the same invocation. *)
session "MicroRust" (AFP) = HOL +
  options [timeout = 1200]
  directories
    "../../Isabelle_Lex-Yacc"
  theories
    MicroRust (global)
    MicroRust_Tests
    MicroRust_Cmd_Tests
